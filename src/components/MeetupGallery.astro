---
// Real Rooms & Meetup Gallery Component
// Directly matching ML Bangladesh Screenshot 2: "FROM CAMPUS FLOORS / Real rooms. Real builds."
// Featuring continuous photo rows of real workshops, sticker tables, laptops, and university halls.

const rowOnePhotos = [
  {
    image: "/images/meetups/meetup-sentinelops-presentation.jpg",
    alt: "Live presentation on SentinelOps SRE CLI and eBPF",
    title: "SentinelOps & eBPF Architecture Talk"
  },
  {
    image: "/images/meetups/software-freedom.avif",
    alt: "Software Freedom Day members meetup in Dhaka",
    title: "Software Freedom Day Gathering"
  },
  {
    image: "/images/meetups/community-arch-linux-terminal.jpg",
    alt: "Hands-on Arch Linux, KDE and terminal session on tablet",
    title: "Arch Linux & Terminal Workstation"
  },
  {
    image: "/images/meetups/meetup-workshop-daffodil.avif",
    alt: "Campus Workshop at Daffodil International University",
    title: "DIU Campus Workshop & Panel"
  },
  {
    image: "/images/meetups/community-iot-hardware.jpg",
    alt: "Embedded IoT open-source firmware clock running FreeRTOS",
    title: "Open Hardware & IoT Clock Lab"
  },
  {
    image: "/images/meetups/software-freedom-day.avif",
    alt: "Open Systems Roundtable with laptops in Dhaka",
    title: "Open Systems Roundtable"
  },
  {
    image: "/images/meetups/meetup-tuxforge.avif",
    alt: "Community hangout and Linux Demos at Tuxforge Lab",
    title: "Tuxforge Lab Demos & Stickers"
  }
];

const rowTwoPhotos = [
  {
    image: "/images/meetups/meetup-community-dinner.jpg",
    alt: "Post-meetup community dinner and informal discussions",
    title: "Community Dinner & Peer Networking"
  },
  {
    image: "/images/meetups/community-arch-linux-terminal.jpg",
    alt: "Dual-pane KDE and bash terminal debugging session",
    title: "Systemd Services & Kernel Debugging"
  },
  {
    image: "/images/meetups/meetup-tuxforge.avif",
    alt: "Stickers, Tux penguins, and open source materials",
    title: "Linux Stickers & Handouts"
  },
  {
    image: "/images/meetups/meetup-sentinelops-presentation.jpg",
    alt: "Students attending systems architecture session",
    title: "Interactive Classroom Systems Lab"
  },
  {
    image: "/images/meetups/community-iot-hardware.jpg",
    alt: "Custom Linux/BLE embedded telemetry project",
    title: "Embedded Linux & BLE Telemetry"
  },
  {
    image: "/images/meetups/meetup-workshop-daffodil.avif",
    alt: "Auditorium workshop and Linux installation fest",
    title: "University Install-Fest"
  },
  {
    image: "/images/meetups/software-freedom.avif",
    alt: "Dhaka open-source volunteer engineers group photo",
    title: "Annual Community Gathering"
  }
];

const partners = [
  "Daffodil International University",
  "Campus Linux Clubs",
  "Tuxforge Lab",
  "Debian & Arch Mirror Mirrors",
  "100% Volunteer Backed"
];
---

<section id="gallery" class="campus-floors-section">
  <div class="container">
    <!-- Header (Screenshot 2: FROM CAMPUS FLOORS / Real rooms. Real builds.) -->
    <div class="floors-header">
      <div class="header-titles">
        <span class="floors-eyebrow">From campus floors</span>
        <h2 class="floors-title">Real rooms. Real builds.</h2>
      </div>

      <div class="floors-actions">
        <button type="button" class="motion-toggle" data-motion-toggle aria-controls="gallery-strip">Pause photos</button>
        <a href="#events" class="floors-action-link">
          See meetups <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2 Scrolling Photo Rows (Full width edge-to-edge reel) -->
  <div class="marquee-wrapper" id="gallery-strip" role="region" aria-label="Campus photo strip">
    <!-- Row 1 -->
    <div class="marquee-track track-left">
      <div class="marquee-content">
        {rowOnePhotos.map((photo) => (
          <div class="photo-thumb-card" title={photo.title}>
            <img
              src={photo.image}
              alt={photo.alt}
              class="thumb-img"
              loading="lazy"
            />
          </div>
        ))}
      </div>
      <!-- Duplicate for seamless infinite loop -->
      <div class="marquee-content" aria-hidden="true">
        {rowOnePhotos.map((photo) => (
          <div class="photo-thumb-card" title={photo.title}>
            <img
              src={photo.image}
              alt={photo.alt}
              class="thumb-img"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2 -->
    <div class="marquee-track track-right">
      <div class="marquee-content">
        {rowTwoPhotos.map((photo) => (
          <div class="photo-thumb-card" title={photo.title}>
            <img
              src={photo.image}
              alt={photo.alt}
              class="thumb-img"
              loading="lazy"
            />
          </div>
        ))}
      </div>
      <!-- Duplicate for seamless infinite loop -->
      <div class="marquee-content" aria-hidden="true">
        {rowTwoPhotos.map((photo) => (
          <div class="photo-thumb-card" title={photo.title}>
            <img
              src={photo.image}
              alt={photo.alt}
              class="thumb-img"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Supporters Row (Screenshot 2 bottom) -->
  <div class="container">
    <div class="supporters-row">
      <span class="supporters-label">Supporters &amp; Academic Hosts:</span>
      <div class="supporters-list">
        {partners.map((partner) => (
          <span class="supporter-badge">{partner}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .campus-floors-section {
    padding: clamp(3.5rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-canvas);
    overflow: hidden;
  }

  .floors-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .header-titles {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .floors-eyebrow {
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .floors-title {
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .floors-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem 1rem;
  }

  .floors-action-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .floors-action-link:hover {
    gap: 0.55rem;
    color: var(--accent-primary-hover);
  }

  /* Marquee Track */
  .marquee-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    user-select: none;
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .track-left {
    animation: scrollLeft 45s linear infinite;
  }

  .track-right {
    animation: scrollRight 48s linear infinite;
  }

  .marquee-track:hover,
  .marquee-wrapper.is-paused .marquee-track {
    animation-play-state: paused;
  }

  /* Same fallback as CommunityPeople: a still, swipeable strip */
  @media (prefers-reduced-motion: reduce) {
    .marquee-wrapper { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
    .marquee-track { animation: none; }
    .marquee-content[aria-hidden] { display: none; }
  }

  .marquee-content {
    display: flex;
    gap: 0.85rem;
    padding-right: 0.85rem;
  }

  .photo-thumb-card {
    flex-shrink: 0;
    width: clamp(190px, 18vw, 250px);
    height: clamp(115px, 12vw, 150px);
    border-radius: 14px;
    overflow: hidden;
    background: #0f172a;
    border: 1px solid var(--border-card);
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.2s ease;
  }

  .photo-thumb-card:hover {
    transform: scale(1.03);
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes scrollLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scrollRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* Supporters Row */
  .supporters-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .supporters-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .supporters-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .supporter-badge {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-subtle);
    border: 1px solid var(--border-card);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
  }
</style>
