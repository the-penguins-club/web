---
// Non-Profit Mission & Free Software Principles
// Explaining why software freedom and Linux education matter.

const freedoms = [
  {
    num: "0",
    title: "Freedom to run the program",
    desc: "To run the program as you wish, for any purpose, on any machine — without artificial licensing barriers or corporate surveillance."
  },
  {
    num: "1",
    title: "Freedom to study the source code",
    desc: "To inspect how the software executes and modify it to suit your needs. Transparent source code is fundamental to computer science education."
  },
  {
    num: "2",
    title: "Freedom to redistribute copies",
    desc: "To share copies with peers, students, and institutions so everyone has access to modern software tools."
  },
  {
    num: "3",
    title: "Freedom to distribute improvements",
    desc: "To release modifications to the public, allowing the global community to learn and benefit collectively."
  }
];

const organizationValues = [
  {
    code: "SOVEREIGNTY",
    title: "Digital Sovereignty",
    summary: "Personal workstations and servers should be under the full control of their owners — free from involuntary data extraction, mandatory telemetry, and artificial lock-ins."
  },
  {
    code: "SUSTAINABILITY",
    title: "Hardware Longevity",
    summary: "GNU/Linux breathes decades of useful life into older computers, actively combating planned obsolescence and reducing electronic waste in universities and homes."
  },
  {
    code: "AUDITABILITY",
    title: "Verifiable Security",
    summary: "Open source software enables independent peer audits and threat modeling. Security must be rooted in transparent architectural design, never secrecy."
  },
  {
    code: "COMMONS",
    title: "Digital Public Commons",
    summary: "Foundational software technologies — from the Internet to the Linux kernel — were built as shared public commons. We defend and expand that heritage."
  },
  {
    code: "CHARITY",
    title: "Free Educational Resources",
    summary: "As an open charity initiative, we host community Linux mirrors, publish guides, distribute free booklets & leaflets, and deliver practical lessons."
  }
];
---

<section id="manifesto" class="manifesto-section">
  <div class="container">
    <div class="manifesto-grid">
      <!-- Mission Column -->
      <div class="manifesto-text-col">
        <h2 class="section-title">Why Software Freedom Matters</h2>
        <p class="section-desc">
          Founded in 2020, The Penguins Club operates on the conviction that computing knowledge should never be hoarded behind paywalls or proprietary lock-ins. By teaching GNU/Linux and open tools, we help individuals take ownership of their technology.
        </p>

        <!-- Values Grid -->
        <div class="values-grid">
          {organizationValues.map((item) => (
            <div class="value-item glass-card">
              <span class="value-code">{item.code}</span>
              <div class="value-content">
                <h4 class="value-title">{item.title}</h4>
                <p class="value-summary">{item.summary}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- The Four Freedoms Card -->
      <div class="freedoms-wrapper">
        <div class="freedoms-card glass-card">
          <div class="freedoms-header">
            <span class="freedoms-eyebrow">The Four Essential Software Freedoms</span>
            <span class="freedoms-source">Formulated by the Free Software Foundation (FSF)</span>
          </div>

          <div class="freedoms-body">
            <div class="freedoms-list">
              {freedoms.map((f) => (
                <div class="freedom-row">
                  <div class="freedom-num-badge">[{f.num}]</div>
                  <div class="freedom-details">
                    <h4 class="freedom-title">{f.title}</h4>
                    <p class="freedom-desc">{f.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="nonprofit-pledge-box">
              <h4 class="pledge-heading">Community Non-Profit Commitment</h4>
              <p class="pledge-text">
                100% volunteer-run charity initiative. We host public Linux mirrors, distribute free educational booklets &amp; stickers, and provide hands-on workshops that remain permanently free and open to everyone.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .manifesto-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .manifesto-text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
  }

  @media (min-width: 600px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .value-item {
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .value-code {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.06em;
  }

  .value-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .value-summary {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Freedoms Card */
  .freedoms-card {
    padding: 0;
    overflow: hidden;
  }

  .freedoms-header {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.15rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .freedoms-eyebrow {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .freedoms-source {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  .freedoms-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .freedoms-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .freedom-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .freedom-num-badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent-primary);
    line-height: 1.4;
  }

  .freedom-title {
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }

  .freedom-desc {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .nonprofit-pledge-box {
    padding: 1rem 1.15rem;
    background: var(--bg-subtle);
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-subtle);
  }

  .pledge-heading {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .pledge-text {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
