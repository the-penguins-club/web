---
// Non-Profit Mission & Free Software Principles
// Explaining why software freedom and Linux education matter.

const freedoms = [
  {
    num: "0",
    title: "Freedom to run the program",
    desc: "To run the program as you wish, for any purpose, on any machine — without artificial licensing barriers or corporate surveillance."
  },
  {
    num: "1",
    title: "Freedom to study the source code",
    desc: "To inspect how the software executes and modify it to suit your needs. Transparent source code is fundamental to computer science education."
  },
  {
    num: "2",
    title: "Freedom to redistribute copies",
    desc: "To share copies with peers, students, and institutions so everyone has access to modern software tools."
  },
  {
    num: "3",
    title: "Freedom to distribute improvements",
    desc: "To release modifications to the public, allowing the global community to learn and benefit collectively."
  }
];

const organizationValues = [
  {
    code: "SOVEREIGNTY",
    icon: "lock",
    title: "Digital Sovereignty",
    summary: "Personal workstations and servers should be under the full control of their owners — free from involuntary data extraction, mandatory telemetry, and artificial lock-ins."
  },
  {
    code: "SUSTAINABILITY",
    icon: "leaf",
    title: "Hardware Longevity",
    summary: "GNU/Linux breathes decades of useful life into older computers, actively combating planned obsolescence and reducing electronic waste in universities and homes."
  },
  {
    code: "AUDITABILITY",
    icon: "eye",
    title: "Verifiable Security",
    summary: "Open source software enables independent peer audits and threat modeling. Security must be rooted in transparent architectural design, never secrecy."
  },
  {
    code: "COMMONS",
    icon: "globe",
    title: "Digital Public Commons",
    summary: "Foundational software technologies — from the Internet to the Linux kernel — were built as shared public commons. We defend and expand that heritage."
  },
  {
    code: "CHARITY",
    icon: "heart",
    title: "Free Educational Resources",
    summary: "As an open charity initiative, we host community Linux mirrors, publish guides, distribute free booklets & leaflets, and deliver practical lessons."
  }
];

const icons = {
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/>',
  leaf: '<path d="M11 20A7 7 0 014 13c0-6 6-9 16-9 0 10-3 16-9 16z"/><path d="M4 21c2-6 5-9 9-11"/>',
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>',
  heart: '<path d="M12 21S3 15 3 9a5 5 0 019-3 5 5 0 019 3c0 6-9 12-9 12z"/>'
};
---

<section id="manifesto" class="manifesto-section">
  <div class="container">
    <div class="manifesto-grid">
      <!-- Mission Column -->
      <div class="manifesto-text-col">
        <h2 class="section-title">Why Software Freedom Matters</h2>
        <p class="section-desc">
          Founded in 2020, The Penguins Club operates on the conviction that computing knowledge should never be hoarded behind paywalls or proprietary lock-ins. By teaching GNU/Linux and open tools, we help individuals take ownership of their technology.
        </p>

        <ul class="values-grid">
          {organizationValues.map((item) => (
            <li class="value-item">
              <span class="value-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.icon]} />
              </span>
              <div class="value-content">
                <span class="value-code">{item.code}</span>
                <h4 class="value-title">{item.title}</h4>
                <p class="value-summary">{item.summary}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <aside class="freedoms-card">
        <span class="freedoms-source">Formulated by the Free Software Foundation (FSF)</span>
        <h3 class="freedoms-eyebrow">The Four Essential Software Freedoms</h3>

        <ol class="freedoms-list">
          {freedoms.map((f) => (
            <li class="freedom-row">
              <span class="freedom-num">{f.num}</span>
              <div>
                <h4 class="freedom-title">{f.title}</h4>
                <p class="freedom-desc">{f.desc}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="nonprofit-pledge-box">
          <h4 class="pledge-heading">Community Non-Profit Commitment</h4>
          <p class="pledge-text">
            100% volunteer-run charity initiative. We host public Linux mirrors, distribute free educational booklets &amp; stickers, and provide hands-on workshops that remain permanently free and open to everyone.
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .manifesto-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .manifesto-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .manifesto-text-col { display: flex; flex-direction: column; align-items: flex-start; }

  .values-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem 2rem;
    width: 100%;
    margin-top: 2.5rem;
  }

  @media (min-width: 600px) {
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .value-item { display: flex; align-items: flex-start; gap: 1rem; }

  .value-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-lg);
    background: var(--accent-green-subtle);
    color: var(--accent-primary);
  }

  .value-item:nth-child(2) .value-icon { background: var(--accent-blush-subtle); color: #b4472a; }
  .value-item:nth-child(3) .value-icon { background: var(--accent-purple-subtle); color: var(--accent-purple); }
  .value-item:nth-child(4) .value-icon { background: var(--accent-amber-subtle); color: #a8620a; }
  .value-item:nth-child(5) .value-icon { background: rgba(29, 95, 168, 0.1); color: #1d5fa8; }

  :global([data-theme="dark"]) .value-item:nth-child(2) .value-icon { color: #f0a088; }
  :global([data-theme="dark"]) .value-item:nth-child(4) .value-icon { color: var(--accent-amber); }
  :global([data-theme="dark"]) .value-item:nth-child(5) .value-icon { color: #7bb8f5; }

  .value-code {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .value-title { font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin: 0.15rem 0 0.3rem; }
  .value-summary { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; }

  /* Freedoms poster: stays dark in both themes */
  .freedoms-card {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-radius: var(--radius-xl);
    background: #0f1a16;
    color: #f1f5f3;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 1024px) {
    .freedoms-card { position: sticky; top: 6rem; }
  }

  .freedoms-source { font-family: var(--font-mono); font-size: 0.7rem; color: #34d399; letter-spacing: 0.04em; }

  .freedoms-eyebrow {
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0.5rem 0 1.75rem;
  }

  .freedoms-list { list-style: none; display: flex; flex-direction: column; }

  .freedom-row {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 1rem;
    padding: 1.15rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .freedom-num {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #d4f55a;
  }

  .freedom-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; }
  .freedom-desc { font-size: 0.85rem; color: #c0cac5; line-height: 1.55; }

  .nonprofit-pledge-box {
    margin-top: 0.75rem;
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-lg);
    background: #d4f55a;
    color: #0f1a16;
  }

  .pledge-heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.4rem;
  }

  .pledge-text { font-size: 0.85rem; line-height: 1.55; }
</style>
