---
// Linux and FOSS Awareness & Digital Sovereignty Section
const freedoms = [
  {
    num: "0",
    title: "Freedom to run it",
    desc: "Run the program as you wish, for any purpose, on any machine — no proprietary licensing limits, no telemetry watching over your shoulder."
  },
  {
    num: "1",
    title: "Freedom to study it",
    desc: "Inspect how the program actually works and adapt it to your needs. Transparent source code isn't a nice-to-have, it's the whole point."
  },
  {
    num: "2",
    title: "Freedom to share it",
    desc: "Redistribute copies so you can help a neighbour, a classmate, or your whole community — without artificial scarcity getting in the way."
  },
  {
    num: "3",
    title: "Freedom to improve it",
    desc: "Share your modified versions with others, so the whole community gets a chance to benefit from what you built."
  }
];

const pillars = [
  {
    icon: "🛡️",
    title: "Data sovereignty",
    summary: "Your computer should belong to you. No background telemetry, no forced cloud accounts, no quietly monetized personal data."
  },
  {
    icon: "⚡",
    title: "Hardware longevity",
    summary: "Linux runs happily on lightweight hardware. Refusing planned obsolescence saves millions of computers from the landfill."
  },
  {
    icon: "🔍",
    title: "Auditable transparency",
    summary: "When software is open, anyone can check that what's running is exactly what was promised — no trust required, just verification."
  },
  {
    icon: "🌱",
    title: "Collaborative commons",
    summary: "Some of the best engineering in modern computing — the Linux kernel, Git, the Web itself — grew as a shared public commons."
  }
];
---

<section id="manifesto" class="manifesto-section">
  <div class="container">
    <div class="manifesto-grid">
      <!-- Left side: Awareness & Mission -->
      <div class="manifesto-text-col">
        <div class="section-tag">Why we do this</div>
        <h2 class="section-title">Software freedom is a human right</h2>
        <p class="section-desc">
          In a world of walled gardens, quiet tracking, and remote kill-switches, we think computing should belong to the person using it. That's why we spend our free time helping people — students, career-switchers, curious neighbours — get comfortable with GNU/Linux and Free Software.
        </p>

        <!-- Pillars grid -->
        <div class="awareness-pillars">
          {pillars.map((item) => (
            <div class="pillar-item glass-card">
              <span class="pillar-icon">{item.icon}</span>
              <div class="pillar-content">
                <h4 class="pillar-title">{item.title}</h4>
                <p class="pillar-summary">{item.summary}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right side: The 4 Freedoms Card -->
      <div class="freedoms-wrapper">
        <div class="freedoms-card glass-card">
          <div class="freedoms-header">
            <span class="freedoms-eyebrow">The four freedoms</span>
            <span class="freedoms-source">as defined by the Free Software Foundation</span>
          </div>

          <div class="freedoms-body">
            <div class="freedoms-list">
              {freedoms.map((f) => (
                <div class="freedom-row">
                  <div class="freedom-num-badge">{f.num}</div>
                  <div class="freedom-details">
                    <h4 class="freedom-title">{f.title}</h4>
                    <p class="freedom-desc">{f.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="quote-box">
              <p class="quote-text">
                &ldquo;If you want to go fast, go alone. If you want to build durable digital infrastructure for humankind, go open source.&rdquo;
              </p>
              <span class="quote-author">&mdash; a Penguins Club regular</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .manifesto-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .manifesto-text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .awareness-pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
  }

  @media (min-width: 600px) {
    .awareness-pillars {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pillar-item {
    padding: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .pillar-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .pillar-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .pillar-summary {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Freedoms Card */
  .freedoms-card {
    padding: 0;
    overflow: hidden;
  }

  .freedoms-header {
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.1rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .freedoms-eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .freedoms-source {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .freedoms-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .freedoms-list {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .freedom-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .freedom-num-badge {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-accent);
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
  }

  .freedom-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .freedom-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .quote-box {
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .quote-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .quote-author {
    font-size: 0.8125rem;
    color: var(--text-accent-warn);
    font-weight: 600;
  }
</style>
