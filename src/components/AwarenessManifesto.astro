---
// Non-Profit Mission & Free Software Principles
// Explaining why software freedom and Linux education matter.

const freedoms = [
  {
    num: "0",
    title: "Freedom to run the program",
    desc: "To run the program as you wish, for any purpose, on any machine — without arbitrary restrictions or corporate surveillance."
  },
  {
    num: "1",
    title: "Freedom to study the source code",
    desc: "To inspect how the program works and modify it to suit your needs. Transparent source code is foundational to computing education."
  },
  {
    num: "2",
    title: "Freedom to redistribute copies",
    desc: "To share copies with your peers, students, and community so everyone has access to technology tools."
  },
  {
    num: "3",
    title: "Freedom to distribute modifications",
    desc: "To release your improvements to the public, allowing the entire community to learn and benefit collectively."
  }
];

const organizationValues = [
  {
    icon: "🛡️",
    title: "Digital Sovereignty",
    summary: "Personal computers should be under the full control of their owners — free from involuntary data collection, mandatory telemetry, and artificial lock-ins."
  },
  {
    icon: "♻️",
    title: "Hardware Sustainability",
    summary: "GNU/Linux breathes decades of life into older hardware, combating planned obsolescence and reducing electronic waste across universities and homes."
  },
  {
    icon: "🔍",
    title: "Verifiable Security",
    summary: "Open-source software permits independent peer audits. Security should be rooted in transparent architecture, never obscurity."
  },
  {
    icon: "🤝",
    title: "Community Commons",
    summary: "The greatest technological breakthroughs — from the Internet to the Linux kernel — were built as shared public commons. We protect and nurture that legacy."
  }
];
---

<section id="manifesto" class="manifesto-section">
  <div class="container">
    <div class="manifesto-grid">
      <!-- Mission Column -->
      <div class="manifesto-text-col">
        <div class="section-tag">Community Mission</div>
        <h2 class="section-title">Why Software Freedom Matters</h2>
        <p class="section-desc">
          Founded in 2020, The Penguins Club operates on the conviction that computing knowledge should not be hoarded behind paywalls or proprietary lock-ins. By teaching GNU/Linux and open source, we help individuals take full ownership of their digital lives.
        </p>

        <!-- Values Grid -->
        <div class="values-grid">
          {organizationValues.map((item) => (
            <div class="value-item glass-card">
              <span class="value-icon">{item.icon}</span>
              <div class="value-content">
                <h4 class="value-title">{item.title}</h4>
                <p class="value-summary">{item.summary}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- The Four Freedoms Card -->
      <div class="freedoms-wrapper">
        <div class="freedoms-card glass-card">
          <div class="freedoms-header">
            <span class="freedoms-eyebrow">The Four Essential Software Freedoms</span>
            <span class="freedoms-source">Formulated by the Free Software Foundation</span>
          </div>

          <div class="freedoms-body">
            <div class="freedoms-list">
              {freedoms.map((f) => (
                <div class="freedom-row">
                  <div class="freedom-num-badge">{f.num}</div>
                  <div class="freedom-details">
                    <h4 class="freedom-title">{f.title}</h4>
                    <p class="freedom-desc">{f.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="nonprofit-pledge-box">
              <h4 class="pledge-heading">Our Community Commitment</h4>
              <p class="pledge-text">
                100% volunteer-operated. All workshops, meetups, guides, and repositories produced by The Penguins Club remain permanently free and open to all.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
    border-top: 1px solid var(--border-subtle);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .manifesto-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .manifesto-text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
  }

  @media (min-width: 600px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .value-item {
    padding: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .value-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .value-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .value-summary {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Freedoms Card */
  .freedoms-card {
    padding: 0;
    overflow: hidden;
  }

  .freedoms-header {
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .freedoms-eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text-primary);
  }

  .freedoms-source {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .freedoms-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .freedoms-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .freedom-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .freedom-num-badge {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-accent);
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
  }

  .freedom-title {
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .freedom-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .nonprofit-pledge-box {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
  }

  .pledge-heading {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-accent);
    margin-bottom: 0.35rem;
  }

  .pledge-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
