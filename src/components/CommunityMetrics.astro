---
// Community Metrics Component
// Inspired by mlbangladesh.org's "What the community has done since..."

// Derived so the headline figure doesn't quietly go stale each January.
const FOUNDED_YEAR = 2020;
const yearsRunning = new Date().getFullYear() - FOUNDED_YEAR;
---

<section class="metrics-section">
  <div class="container">
    <div class="metrics-header">
      <h2 class="section-title">What the community has built since {FOUNDED_YEAR}</h2>
      <p class="section-desc">
        Here's what {yearsRunning} years of monthly meetups adds up to. No sponsors, no
        registration fees, and every organiser a volunteer.
      </p>
    </div>

    <!-- Big Number Metric Cards -->
    <div class="metrics-grid">
      <div class="metric-card glass-card">
        <span class="metric-number">{yearsRunning}+</span>
        <span class="metric-label">Years Running</span>
        <span class="metric-detail">Monthly meetups kept going since {FOUNDED_YEAR}</span>
      </div>

      <div class="metric-card glass-card">
        <span class="metric-number">34+</span>
        <span class="metric-label">Meetups Hosted</span>
        <span class="metric-detail">In-person workshops in Dhaka &amp; interactive live streams</span>
      </div>

      <div class="metric-card glass-card">
        <span class="metric-number">30+</span>
        <span class="metric-label">Open Repositories</span>
        <span class="metric-detail">Public tools, datasets, guides &amp; bots on GitHub</span>
      </div>

      <div class="metric-card glass-card">
        <span class="metric-number">100%</span>
        <span class="metric-label">Free &bull; Zero Paywalls</span>
        <span class="metric-detail">Run by volunteers with zero corporate lock-in</span>
      </div>
    </div>

    <!-- Featured Community Initiatives (like ML Olympiad & Gemma on mlbangladesh) -->
    <div class="initiatives-grid">
      <div class="initiative-card glass-card">
        <div class="init-badge">CHARITY INFRASTRUCTURE</div>
        <h3 class="init-title">High-Speed Local Linux Mirror</h3>
        <p class="init-desc">
          Hosting community cache mirrors for Debian, Arch Linux, and Ubuntu packages to ensure fast, low-latency downloads for local students and developers across Bangladesh.
        </p>
        <div class="init-footer">
          <span class="init-tag">mirror.thepenguins.club</span>
          <span class="init-stat">Free Access</span>
        </div>
      </div>

      <div class="initiative-card glass-card">
        <div class="init-badge">PRINTED EDUCATIONAL MATERIAL</div>
        <h3 class="init-title">Free Booklets, Leaflets &amp; Stickers</h3>
        <p class="init-desc">
          Designing, printing, and distributing physical command-line cheat sheets, Linux installation guides, and Tux stickers at meetups and universities across the country.
        </p>
        <div class="init-footer">
          <span class="init-tag">Charity Distribution</span>
          <span class="init-stat">Handed Out Freely</span>
        </div>
      </div>

      <div class="initiative-card glass-card">
        <div class="init-badge">OPEN DATA DIRECTORY</div>
        <h3 class="init-title">bd-startups Ecosystem Index</h3>
        <p class="init-desc">
          Curated crowdsourced database documenting tech companies in Bangladesh, providing global visibility to local innovators and student researchers.
        </p>
        <div class="init-footer">
          <span class="init-tag">github.com/the-penguins-club/bd-startups</span>
          <span class="init-stat">Open Data</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .metrics-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
  }

  .metrics-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 2.75rem;
  }

  /* Metric Cards Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 600px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-card {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--bg-card);
  }

  .metric-number {
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1;
    color: var(--accent-primary);
    letter-spacing: -0.03em;
  }

  .metric-label {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 0.25rem;
  }

  .metric-detail {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  /* Initiatives Grid */
  .initiatives-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .initiatives-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .initiative-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: var(--bg-card);
  }

  .init-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .init-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .init-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .init-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.725rem;
  }

  .init-tag {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .init-stat {
    color: var(--text-muted);
  }
</style>
