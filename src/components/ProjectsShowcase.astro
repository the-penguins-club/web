---
// Projects Showcase - Real Repositories & Initiatives from The Penguins Club GitHub
// Real data sourced from https://github.com/the-penguins-club

interface ProjectItem {
  id: string;
  name: string;
  repoUrl: string;
  description: string;
  stars: number;
  forks: number;
  lang: string;
  langColor: string;
  tag: string;
}

const realProjects: ProjectItem[] = [
  {
    id: "proj-bd-startups",
    name: "bd-startups",
    repoUrl: "https://github.com/the-penguins-club/bd-startups",
    description: "Curated open directory of technology startups in Bangladesh. Helping local tech innovators gain international visibility and collaborative peer connections.",
    stars: 21,
    forks: 6,
    lang: "Markdown",
    langColor: "#0284c7",
    tag: "Open Data"
  },
  {
    id: "proj-cybersec",
    name: "Awesome-Cybersecurity-Bangladesh",
    repoUrl: "https://github.com/the-penguins-club/Awesome-Cybersecurity-Bangladesh",
    description: "Curated collection of cybersecurity learning labs, research initiatives, tooling guides, and defense frameworks tailored for Bangladesh.",
    stars: 6,
    forks: 2,
    lang: "Awesome List",
    langColor: "#15803d",
    tag: "Security"
  },
  {
    id: "proj-tuxtalk",
    name: "TuxTalk",
    repoUrl: "https://github.com/the-penguins-club/TuxTalk",
    description: "Slide decks, talk transcripts, lecture notes, and resources presented at The Penguins Club monthly meetups covering Linux systems and tools.",
    stars: 5,
    forks: 0,
    lang: "Talks & Notes",
    langColor: "#d97706",
    tag: "Workshops"
  },
  {
    id: "proj-uradhura",
    name: "uradhura",
    repoUrl: "https://github.com/the-penguins-club/uradhura",
    description: "High-performance Telegram bot written in Rust powering community group automations, resource delivery, and utility services.",
    stars: 5,
    forks: 0,
    lang: "Rust",
    langColor: "#ea580c",
    tag: "Automation"
  },
  {
    id: "proj-tux-career",
    name: "tux-career",
    repoUrl: "https://github.com/the-penguins-club/tux-career",
    description: "Curated open career guidance, Linux skill rubrics, and engineering references for aspiring systems administrators and developers.",
    stars: 3,
    forks: 2,
    lang: "JavaScript",
    langColor: "#ca8a04",
    tag: "Roadmap"
  },
  {
    id: "proj-internetting",
    name: "internetting",
    repoUrl: "https://github.com/the-penguins-club/internetting",
    description: "Essential internet etiquettes, digital ethics, and communication norms compiled in one place for students and tech community participants.",
    stars: 0,
    forks: 1,
    lang: "Astro",
    langColor: "#dc2626",
    tag: "Digital Literacy"
  }
];
---

<section id="projects" class="projects-section">
  <div class="container">
    <div class="section-header">
      <div class="header-content">
        <h2 class="section-title">Public Repositories &amp; Initiatives</h2>
        <p class="section-desc">
          All our code, guides, and learning resources are published under open copyleft licenses on GitHub. Explore, inspect, fork, and submit pull requests.
        </p>
      </div>

      <a href="https://github.com/the-penguins-club" target="_blank" rel="noopener noreferrer" class="btn-secondary gh-all-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>View all 30 repos on GitHub &rarr;</span>
      </a>
    </div>

    <ul class="grid">
      {realProjects.map((proj) => (
        <li>
          <a href={proj.repoUrl} target="_blank" rel="noopener noreferrer" class="card" style={`--lang: ${proj.langColor}`}>
            <div class="top">
              <span class="gh"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg></span>
              <span class="tag">{proj.tag}</span>
            </div>

            <h3 class="name">{proj.name}</h3>
            <p class="desc">{proj.description}</p>

            <div class="foot">
              <span class="lang"><span class="lang-dot"></span>{proj.lang}</span>
              <span class="stat stat-star" title="Stars on GitHub"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><b>{proj.stars}</b></span>
              <span class="stat" title="Forks"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="6" r="3"></circle><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"></path><path d="M12 12v3"></path></svg><b>{proj.forks}</b></span>
              <span class="arrow" aria-hidden="true">&nearr;</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <p class="more">
      Want to contribute or start a new repository under the club? Add docs to <code>bd-startups</code>, write a security guide for <code>Awesome-Cybersecurity-Bangladesh</code>, or incubate your own tool.
      <a href="https://github.com/the-penguins-club" target="_blank" rel="noopener noreferrer">Explore on GitHub &rarr;</a>
    </p>
  </div>
</section>

<style>
  .projects-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem; }

  @media (min-width: 860px) {
    .section-header { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .header-content { max-width: 620px; }
    .header-content .section-desc { margin-bottom: 0; }
  }

  .gh-all-btn { white-space: nowrap; align-self: flex-start; }

  .grid { list-style: none; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .grid li { display: flex; }

  /* Compact card: a thin language-colour bar is the only decoration */
  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.25rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-top: 3px solid var(--lang);
    border-radius: var(--radius-md);
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .card:hover { border-color: var(--lang); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .card:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }

  .top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .gh { color: var(--text-muted); display: inline-flex; }
  .tag { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }

  .name { font-family: var(--font-mono); font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text-primary); overflow-wrap: anywhere; }
  .card:hover .name { color: var(--accent-primary); }

  .desc {
    flex: 1;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .lang { display: inline-flex; align-items: center; gap: 0.4rem; margin-right: auto; }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .stat b { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; line-height: 1; color: var(--text-primary); }
  .stat-star svg { color: var(--accent-amber); }
  .card:hover .stat { background: var(--bg-card); border-color: var(--border-card-hover); }
  .lang-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lang); }
  .arrow { margin-left: 0.25rem; font-size: 1.1rem; line-height: 1; transition: transform 0.15s ease, color 0.15s ease; }
  .card:hover .arrow { color: var(--accent-primary); transform: translate(2px, -2px); }

  .more { margin-top: 2rem; font-size: 0.9rem; line-height: 1.6; color: var(--text-secondary); max-width: 70ch; }
  .more code { font-family: var(--font-mono); font-size: 0.8rem; background: var(--bg-elevated); padding: 0.1rem 0.4rem; border-radius: var(--radius-xs); }
  .more a { display: block; margin-top: 0.5rem; color: var(--accent-primary); font-weight: 600; }
  .more a:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .card, .arrow { transition: none; }
    .card:hover, .card:hover .arrow { transform: none; }
  }
</style>
