---
// Projects Showcase - Real Repositories & Initiatives from The Penguins Club GitHub
// Real data sourced from https://github.com/the-penguins-club

interface ProjectItem {
  id: string;
  name: string;
  repoUrl: string;
  description: string;
  stars: number;
  forks: number;
  lang: string;
  langColor: string;
  tag: string;
}

const realProjects: ProjectItem[] = [
  {
    id: "proj-bd-startups",
    name: "bd-startups",
    repoUrl: "https://github.com/the-penguins-club/bd-startups",
    description: "Curated open directory of technology startups in Bangladesh. Helping local tech innovators gain international visibility and collaborative peer connections.",
    stars: 21,
    forks: 6,
    lang: "Markdown",
    langColor: "#0284c7",
    tag: "Open Data"
  },
  {
    id: "proj-cybersec",
    name: "Awesome-Cybersecurity-Bangladesh",
    repoUrl: "https://github.com/the-penguins-club/Awesome-Cybersecurity-Bangladesh",
    description: "Curated collection of cybersecurity learning labs, research initiatives, tooling guides, and defense frameworks tailored for Bangladesh.",
    stars: 6,
    forks: 2,
    lang: "Awesome List",
    langColor: "#15803d",
    tag: "Security"
  },
  {
    id: "proj-tuxtalk",
    name: "TuxTalk",
    repoUrl: "https://github.com/the-penguins-club/TuxTalk",
    description: "Slide decks, talk transcripts, lecture notes, and resources presented at The Penguins Club monthly meetups covering Linux systems and tools.",
    stars: 5,
    forks: 0,
    lang: "Talks & Notes",
    langColor: "#d97706",
    tag: "Workshops"
  },
  {
    id: "proj-uradhura",
    name: "uradhura",
    repoUrl: "https://github.com/the-penguins-club/uradhura",
    description: "High-performance Telegram bot written in Rust powering community group automations, resource delivery, and utility services.",
    stars: 5,
    forks: 0,
    lang: "Rust",
    langColor: "#ea580c",
    tag: "Automation"
  },
  {
    id: "proj-tux-career",
    name: "tux-career",
    repoUrl: "https://github.com/the-penguins-club/tux-career",
    description: "Curated open career guidance, Linux skill rubrics, and engineering references for aspiring systems administrators and developers.",
    stars: 3,
    forks: 2,
    lang: "JavaScript",
    langColor: "#ca8a04",
    tag: "Roadmap"
  },
  {
    id: "proj-internetting",
    name: "internetting",
    repoUrl: "https://github.com/the-penguins-club/internetting",
    description: "Essential internet etiquettes, digital ethics, and communication norms compiled in one place for students and tech community participants.",
    stars: 0,
    forks: 1,
    lang: "Astro",
    langColor: "#dc2626",
    tag: "Digital Literacy"
  }
];
---

<section id="projects" class="projects-section">
  <div class="container">
    <div class="section-header">
      <div class="header-content">
        <h2 class="section-title">Public Repositories &amp; Initiatives</h2>
        <p class="section-desc">
          All our code, guides, and learning resources are published under open copyleft licenses on GitHub. Explore, inspect, fork, and submit pull requests.
        </p>
      </div>

      <a href="https://github.com/the-penguins-club" target="_blank" rel="noopener noreferrer" class="btn-secondary gh-all-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>View all 30 repos on GitHub &rarr;</span>
      </a>
    </div>

    <div class="term" role="group" aria-label="Public repositories listing">
      <div class="term-bar" aria-hidden="true">
        <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
        <span class="term-title">~/the-penguins-club — zsh</span>
      </div>

      <div class="term-body">
        <p class="line"><span class="prompt">$</span> gh repo list the-penguins-club --sort stars</p>

        <ul class="repos">
          {realProjects.map((proj) => (
            <li>
              <a href={proj.repoUrl} target="_blank" rel="noopener noreferrer" class="repo">
                <span class="caret" aria-hidden="true">&gt;</span>
                <span class="repo-name">{proj.name}<span class="repo-tag">[{proj.tag.toLowerCase()}]</span></span>
                <span class="repo-desc">{proj.description}</span>
                <span class="repo-lang">
                  <span class="lang-dot" style={`background-color: ${proj.langColor}`}></span>{proj.lang}
                </span>
                <span class="repo-stats">★ {proj.stars}&nbsp;&nbsp;⑂ {proj.forks}</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="line comment"># Want to contribute or start a new repository under the club?</p>
        <p class="line comment"># Add docs to <code>bd-startups</code>, write a security guide for <code>Awesome-Cybersecurity-Bangladesh</code>, or incubate your own tool.</p>
        <p class="line">
          <span class="prompt">$</span>
          <a href="https://github.com/the-penguins-club" target="_blank" rel="noopener noreferrer" class="open-link">open github.com/the-penguins-club</a>
          <span class="cursor" aria-hidden="true"></span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem; }

  @media (min-width: 860px) {
    .section-header { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .header-content { max-width: 620px; }
    .header-content .section-desc { margin-bottom: 0; }
  }

  .gh-all-btn { white-space: nowrap; align-self: flex-start; }

  /* Terminal window: dark in both themes */
  .term {
    border-radius: var(--radius-xl);
    background: #0b110e;
    color: #c8d3cd;
    font-family: var(--font-mono);
    box-shadow: var(--shadow-lg), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    background: #141d18;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dot { width: 11px; height: 11px; border-radius: 50%; }
  .dot-r { background: #ff6b5e; }
  .dot-y { background: #f5b84a; }
  .dot-g { background: #34d399; }
  .term-title { margin-left: 0.75rem; font-size: 0.72rem; color: #8b9791; }

  .term-body { padding: clamp(1.25rem, 3vw, 2rem); }

  .line { font-size: 0.85rem; line-height: 1.7; }
  .line + .line { margin-top: 0.15rem; }
  .prompt { color: #34d399; margin-right: 0.5rem; }
  .comment { color: #6f7c75; }
  .comment code { color: #a8b5ae; }

  .repos { list-style: none; margin: 1.25rem 0 1.75rem; }

  .repo {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 17rem) minmax(0, 1fr) 8.5rem 5.5rem;
    grid-template-areas: "caret name desc lang stats";
    align-items: baseline;
    column-gap: 1.25rem;
    padding: 0.8rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    transition: background-color 0.15s ease;
  }

  .repo:hover, .repo:focus-visible { background: rgba(52, 211, 153, 0.09); outline: none; }
  .repo:focus-visible { box-shadow: inset 0 0 0 2px #34d399; }

  .caret { grid-area: caret; color: transparent; }
  .repo:hover .caret, .repo:focus-visible .caret { color: #d4f55a; }

  .repo-name { grid-area: name; color: #d4f55a; font-weight: 700; overflow-wrap: anywhere; }
  .repo-tag { display: block; color: #6f7c75; font-weight: 400; font-size: 0.72rem; margin-top: 0.15rem; }
  .repo-desc { grid-area: desc; color: #9aa7a0; line-height: 1.5; font-family: var(--font-sans); font-size: 0.85rem; }
  .repo-lang { grid-area: lang; display: inline-flex; align-items: center; gap: 0.45rem; color: #c8d3cd; white-space: nowrap; }
  .repo-stats { grid-area: stats; color: #8b9791; white-space: nowrap; text-align: right; }
  .lang-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }

  @media (max-width: 899px) {
    .repo {
      grid-template-columns: 1.25rem 1fr auto;
      grid-template-areas: "caret name stats" ". desc desc" ". lang lang";
      row-gap: 0.35rem;
    }
  }

  .open-link { color: #d4f55a; border-bottom: 1px dashed rgba(212, 245, 90, 0.5); transition: border-color 0.15s ease; }
  .open-link:hover { border-bottom-style: solid; border-color: #d4f55a; }
  .open-link:focus-visible { outline: 2px solid #d4f55a; outline-offset: 3px; }

  .cursor {
    display: inline-block;
    width: 0.55rem;
    height: 1.05em;
    margin-left: 0.4rem;
    vertical-align: text-bottom;
    background: #34d399;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
    .repo, .open-link { transition: none; }
  }
</style>
