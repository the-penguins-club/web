---
// Get Involved / Take Part Component
// Tinted illustration cards + dark partner banner

const participationWays = [
  {
    tag: "HOST ON CAMPUS",
    tone: "mint",
    art: "campus",
    title: "Host a campus workshop",
    description: "Bring a Linux install-fest or workshop to your university. You bring the lab room and students; we bring the bootable USBs, printed booklets, stickers, and experienced mentors.",
    actionText: "Request a campus workshop",
    actionUrl: "https://t.me/penguinsclubnetwork",
    note: "Free for students & universities"
  },
  {
    tag: "SPEAK OR DEMO",
    tone: "lavender",
    art: "mic",
    title: "Speak or demo a tool",
    description: "Teach the tool or workflow you wish someone had shown you. Whether you built a Rust CLI, configured a home server, or mastered Vim, our meetup stage is open to you.",
    actionText: "Offer a session",
    actionUrl: "mailto:uthsob@thepenguins.club?subject=Proposing%20a%20Talk%20at%20TPC",
    note: "First-time speakers welcomed & mentored"
  },
  {
    tag: "CONTRIBUTE CODE",
    tone: "lime",
    art: "pr",
    title: "Contribute to open repositories",
    description: "Submit pull requests to bd-startups, Awesome-Cybersecurity, or uradhura. Help translate documentation, fix issues, and improve community infrastructure.",
    actionText: "Explore GitHub repos",
    actionUrl: "https://github.com/the-penguins-club",
    note: "All code copyleft & open source"
  },
  {
    tag: "SUPPORT LOGISTICS",
    tone: "blush",
    art: "heart",
    title: "Support mirrors & hardware",
    description: "Fund high-bandwidth Linux mirror servers, provide refurbished laptops for student labs, or support printing free booklets and stickers — never a paywall.",
    actionText: "Support the initiative",
    actionUrl: "mailto:uthsob@thepenguins.club?subject=Supporting%20TPC%20Logistics",
    note: "100% transparent non-profit allocation"
  }
];
const art = {
  campus: `<path d="M10 52L60 24l50 28z" fill="var(--art-soft)" stroke="var(--art)" stroke-width="4" stroke-linejoin="round"/><path d="M22 58v32M44 58v32M76 58v32M98 58v32" stroke="var(--art)" stroke-width="6" stroke-linecap="round"/><path d="M12 98h96" stroke="var(--art)" stroke-width="6" stroke-linecap="round"/><circle cx="60" cy="42" r="5" fill="var(--art)"/>`,
  mic: `<rect x="44" y="12" width="32" height="54" rx="16" fill="var(--art-soft)" stroke="var(--art)" stroke-width="4"/><path d="M30 54c0 20 13 32 30 32s30-12 30-32M60 86v20M44 106h32" fill="none" stroke="var(--art)" stroke-width="5" stroke-linecap="round"/><path d="M52 30h16M52 42h16" stroke="var(--art)" stroke-width="4" stroke-linecap="round"/>`,
  pr: `<circle cx="30" cy="22" r="10" fill="var(--art-soft)" stroke="var(--art)" stroke-width="4"/><circle cx="30" cy="98" r="10" fill="var(--art-soft)" stroke="var(--art)" stroke-width="4"/><circle cx="90" cy="98" r="10" fill="var(--art)" stroke="var(--art)" stroke-width="4"/><path d="M30 32v56M90 88V44a14 14 0 00-14-14H62" fill="none" stroke="var(--art)" stroke-width="5" stroke-linecap="round"/><path d="M70 20l-10 10 10 10" fill="none" stroke="var(--art)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>`,
  heart: `<path d="M60 102S14 74 14 42c0-14 11-24 24-24 9 0 17 5 22 13 5-8 13-13 22-13 13 0 24 10 24 24 0 32-46 60-46 60z" fill="var(--art-soft)" stroke="var(--art)" stroke-width="4" stroke-linejoin="round"/><path d="M38 44h14l6-10 8 20 6-10h10" fill="none" stroke="var(--art)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>`
};
---

<section id="get-involved" class="involved-section">
  <div class="container">
    <div class="involved-header">
      <div class="header-content">
        <h2 class="section-title">Four ways to take part</h2>
        <p class="section-desc">
          Speak, host a campus stop, contribute code, or support the logistics that keep workshops and educational materials free for every student in Bangladesh.
        </p>
      </div>

      <div class="header-action">
        <a href="https://t.me/penguinsclubnetwork" target="_blank" rel="noopener noreferrer" class="btn-primary">
          Join on Telegram &rarr;
        </a>
        <a href="https://discord.gg/BRPWt6fXRH" target="_blank" rel="noopener noreferrer" class="btn-secondary">
          Join on Discord &rarr;
        </a>
      </div>
    </div>

    <div class="involved-grid">
      {participationWays.map((item, idx) => (
        <article class={`way tone-${item.tone}`}>
          <div class="way-art">
            <span class="way-num" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
            <svg viewBox="0 0 120 120" aria-hidden="true" set:html={art[item.art]} />
          </div>

          <div class="way-body">
            <span class="way-note">{item.note}</span>
            <h3 class="way-title">{item.title}</h3>
            <p class="way-desc">{item.description}</p>
          </div>

          <a href={item.actionUrl} target="_blank" rel="noopener noreferrer" class="way-link">
            <span>{item.actionText}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      ))}
    </div>

    <div class="partner-callout">
      <div class="partner-text">
        <h3 class="partner-title">Help keep the rooms open</h3>
        <p class="partner-desc">
          Support pays for meeting rooms, mirror bandwidth, travel to universities around
          Bangladesh, and the booklets and stickers we give away. It never pays for a registration
          fee, because there isn't one. What you get back is the engineers and students doing the
          work, and a community that remembers who paid for the room.
        </p>
      </div>

      <a href="mailto:uthsob@thepenguins.club?subject=Partnership%20Inquiry%20with%20The%20Penguins%20Club" class="partner-btn">
        Ask about partnering &rarr;
      </a>
    </div>
  </div>
</section>

<style>
  .involved-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
  }

  .involved-header { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2.75rem; }
  .header-action { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @media (min-width: 860px) {
    .involved-header { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .header-content { max-width: 640px; }
    .header-content .section-desc { margin-bottom: 0; }
  }

  .involved-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) { .involved-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .involved-grid { grid-template-columns: repeat(4, 1fr); } }

  .way {
    --bg: var(--bg-subtle);
    --art: var(--accent-primary);
    --art-soft: var(--accent-green-subtle);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.75rem 0.75rem 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .way:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }

  .way-art {
    position: relative;
    display: grid;
    place-items: center;
    height: 10rem;
    border-radius: calc(var(--radius-xl) - 6px);
    background: var(--bg);
  }

  .way-art svg { width: 6.5rem; height: 6.5rem; }

  .way-num {
    position: absolute;
    top: 0.9rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--art);
  }

  .way-body { display: flex; flex-direction: column; gap: 0.6rem; padding: 0 0.75rem; flex: 1; }

  .way-note { font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-muted); min-height: 2.6em; }

  .way-title { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.25; color: var(--text-primary); }

  .way-desc { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; }

  .way-link {
    margin: 0 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-card);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .way-link:hover { background: var(--text-primary); color: var(--bg-card); border-color: var(--text-primary); }

  /* Partner banner */
  .partner-callout {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--radius-xl);
    background-color: #0f1a16;
    background-image: radial-gradient(rgba(52, 211, 153, 0.18) 1px, transparent 1px);
    background-size: 18px 18px;
    color: #f1f5f3;
  }

  @media (min-width: 860px) {
    .partner-callout { flex-direction: row; align-items: center; justify-content: space-between; gap: 3rem; }
    .partner-text { max-width: 680px; }
  }

  .partner-title { font-size: clamp(1.35rem, 2.4vw, 1.75rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.6rem; }
  .partner-desc { font-size: 0.875rem; line-height: 1.65; color: #c0cac5; }

  .partner-btn {
    flex: none;
    align-self: flex-start;
    padding: 0.85rem 1.4rem;
    border-radius: var(--radius-pill);
    background: var(--accent-lime);
    color: #0f1a16;
    font-size: 0.9rem;
    font-weight: 700;
    transition: transform 0.15s ease;
  }

  .partner-btn:hover { transform: translateX(3px); }
  .partner-btn:focus-visible { outline: 2px solid var(--accent-lime); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .way, .partner-btn { transition: none; }
    .way:hover, .partner-btn:hover { transform: none; }
  }
</style>
