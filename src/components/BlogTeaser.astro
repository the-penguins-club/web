---
import PostCover from './PostCover.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../utils/blog';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

{posts.length > 0 && (
  <section class="teaser" id="blog" aria-labelledby="blog-teaser-title">
    <div class="container">
      <div class="teaser-head">
        <h2 id="blog-teaser-title" class="section-title">From the blog</h2>
        <a href="/blog" class="all">All posts</a>
      </div>
      <ul class="teaser-list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}`} class="card">
              <PostCover title={p.data.title} cover={p.data.cover} label={p.data.tags[0] ?? 'blog'} />
              <p class="meta">{fmtDate(p.data.date)}</p>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .teaser { padding: clamp(3.5rem, 6vw, 5rem) 0; border-bottom: 1px solid var(--border-subtle); }
  .teaser-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1.75rem; }
  .teaser-head .section-title { margin: 0; }
  .all { color: var(--accent-primary); font-weight: 600; }
  .teaser-list { list-style: none; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .card { display: grid; align-content: start; gap: 0.6rem; height: 100%; color: inherit; }
  .card :global(.cover) { margin-bottom: 0.4rem; transition: transform 0.2s ease; }
  .card:hover :global(.cover) { transform: translateY(-3px); }
  .card:hover h3 { color: var(--accent-primary); }
  .meta { font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono); }
  h3 { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.25; transition: color 0.15s ease; }
  .card p:last-child { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.55; }
  @media (prefers-reduced-motion: reduce) { .card :global(.cover) { transition: none; } .card:hover :global(.cover) { transform: none; } }
</style>
