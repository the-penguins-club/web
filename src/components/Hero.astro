---
// Hero Component - Linux & Open Source Community
// Running continuously from 2020 • Real data, zero fluff
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Left Column: Copy & Actions -->
    <div class="hero-content">
      <div class="hero-pill-badge">
        <span class="pulse-dot"></span>
        <span class="pill-label">Non-Profit Linux &amp; Open Source Community &bull; Running from 2020</span>
      </div>

      <h1 class="hero-title">
        Democratizing <span class="hero-highlight">Linux</span> &amp; Open Source Education.
      </h1>

      <p class="hero-description">
        The Penguins Club is a charity and non-profit community initiative running from 2020. We host community Linux mirrors, distribute free educational booklets, leaflets &amp; stickers, and deliver valuable practical lessons and monthly workshops.
      </p>

      <div class="hero-cta-group">
        <a href="https://t.me/penguinsclubnetwork" target="_blank" rel="noopener noreferrer" class="btn-primary hero-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          Join Telegram Community
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="#gallery" class="btn-secondary hero-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          Monthly Meetups Gallery
        </a>
      </div>

      <!-- Real Impact Metrics -->
      <div class="hero-stats-strip glass-card">
        <div class="stat-col">
          <span class="stat-val">2020</span>
          <span class="stat-text">Running From</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-col">
          <span class="stat-val">Monthly</span>
          <span class="stat-text">Meetups</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-col">
          <span class="stat-val">30+</span>
          <span class="stat-text">GitHub Repos</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-col">
          <span class="stat-val">Charity</span>
          <span class="stat-text">Volunteer-Run</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Sleek Linux Terminal Card -->
    <div class="hero-visual">
      <div class="terminal-card">
        <!-- Terminal Titlebar -->
        <div class="term-bar">
          <div class="term-dots-group">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <div class="term-title-text">tux@thepenguins.club: ~</div>
          <div class="term-tag-text">bash</div>
        </div>

        <!-- Terminal Content -->
        <div class="term-body">
          <div class="cmd-row">
            <span class="prompt-sym">$</span>
            <span class="cmd-text">tpc status</span>
          </div>

          <div class="output-panel">
            <div class="kv-line">
              <span class="kv-k">Club</span>
              <span class="kv-v bold-v">The Penguins Club (TPC)</span>
            </div>
            <div class="kv-line">
              <span class="kv-k">Type</span>
              <span class="kv-v">Non-Profit Charity Initiative</span>
            </div>
            <div class="kv-line">
              <span class="kv-k">Services</span>
              <span class="kv-v">Linux Mirror &bull; Booklets &bull; Stickers</span>
            </div>
            <div class="kv-line">
              <span class="kv-k">Active</span>
              <span class="kv-v">Running from 2020</span>
            </div>
            <div class="kv-line">
              <span class="kv-k">Teaches</span>
              <span class="kv-v">Valuable Lessons in Linux &amp; Tools</span>
            </div>
            <div class="kv-line">
              <span class="kv-k">Cadence</span>
              <span class="kv-v">Monthly Community Meetups</span>
            </div>
            <div class="kv-line">
              <span class="kv-k">Location</span>
              <span class="kv-v">Bangladesh &bull; Global Community</span>
            </div>
          </div>

          <div class="cmd-row" style="margin-top: 0.25rem;">
            <span class="prompt-sym">$</span>
            <span class="cmd-text">tpc connect --chat</span>
          </div>

          <div class="tags-group">
            <span class="pill-chip chip-green">
              <span class="pulse-chip-dot"></span>
              t.me/penguinsclubnetwork
            </span>
            <span class="pill-chip chip-blue">Linux Mirror</span>
            <span class="pill-chip chip-amber">Free Booklets &amp; Stickers</span>
          </div>

          <!-- Bottom Action inside Terminal -->
          <a
            href="https://t.me/penguinsclubnetwork"
            target="_blank"
            rel="noopener noreferrer"
            class="terminal-action-btn"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            Open Telegram Community &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(2rem, 4.5vw, 3.75rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 4.25rem);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .hero-container {
      display: grid;
      grid-template-columns: 1.15fr 0.95fr;
      align-items: center;
      gap: 3.5rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.2vw, 3.3rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin-bottom: 1.15rem;
  }

  .hero-highlight {
    color: var(--text-accent);
  }

  .hero-description {
    font-size: clamp(0.975rem, 1.25vw, 1.1rem);
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .hero-btn {
    padding: 0.75rem 1.4rem;
    font-size: 0.9rem;
  }

  /* Stats Strip */
  .hero-stats-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 560px;
    padding: 1rem 1.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
  }

  .stat-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
  }

  .stat-val {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-accent);
    line-height: 1;
  }

  .stat-text {
    font-size: 0.725rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .stat-sep {
    width: 1px;
    height: 30px;
    background: var(--border-subtle);
    flex-shrink: 0;
  }

  /* Right Terminal Window */
  .hero-visual {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .terminal-card,
  .terminal-window {
    width: 100%;
    max-width: 480px;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.05);
    overflow: hidden;
    font-family: var(--font-mono), monospace;
  }

  .term-bar,
  .terminal-header {
    background: #1e293b;
    padding: 0.75rem 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #334155;
  }

  .term-dots-group,
  .term-dots {
    display: flex;
    gap: 7px;
  }

  .term-dots-group span,
  .tdot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-red, .tdot-red { background: #ef4444; }
  .dot-yellow, .tdot-yellow { background: #f59e0b; }
  .dot-green, .tdot-green { background: #10b981; }

  .term-title-text,
  .term-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .term-tag-text,
  .term-lang {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #64748b;
    text-transform: uppercase;
  }

  .term-body,
  .terminal-content {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .cmd-row,
  .term-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prompt-sym,
  .t-prompt {
    color: #10b981;
    font-weight: 700;
  }

  .cmd-text,
  .t-cmd {
    color: #38bdf8;
    font-weight: 600;
  }

  .output-panel,
  .term-output-grid {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    background: #141e2e;
    border: 1px solid #1e293b;
    border-radius: var(--radius-sm);
  }

  .kv-line,
  .out-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.8rem;
  }

  .kv-k,
  .out-key {
    color: #64748b;
    min-width: 70px;
    flex-shrink: 0;
  }

  .kv-v,
  .out-val {
    color: #cbd5e1;
  }

  .bold-v,
  .highlight-val {
    color: #f8fafc;
    font-weight: 600;
  }

  .tags-group,
  .term-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill-chip,
  .t-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.75rem;
  }

  .chip-green,
  .t-badge-green {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
  }

  .chip-blue,
  .t-badge-blue {
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
  }

  .pulse-chip-dot,
  .t-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  .terminal-action-btn,
  .terminal-join-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    background: #2563eb;
    color: #ffffff;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .terminal-action-btn:hover,
  .terminal-join-btn:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
    color: #ffffff;
  }
</style>
