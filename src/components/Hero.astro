---
// Hero Component - Linux & Open Source Community
// Directly matching the modern non-profit design style of ML Bangladesh (Screenshot 1)
const heroSlides = [
  {
    image: "/images/meetups/software-freedom.png",
    caption: "Software Freedom Day Gathering, Dhaka",
    alt: "The Penguins Club members gathered in Dhaka for Software Freedom Day",
  },
  {
    image: "/images/meetups/meetup-workshop-daffodil.png",
    caption:
      "Campus Workshop & Speaker Panel, Daffodil International University",
    alt: "University workshop introducing students to GNU/Linux and terminal commands",
  },
  {
    image: "/images/meetups/software-freedom-day.png",
    caption: "Open Systems Roundtable & Community Lab, Dhaka",
    alt: "Hands-on laptops and open source roundtable discussion",
  },
  {
    image: "/images/meetups/meetup-tuxforge.png",
    caption: "Community Hangout & FOSS Demos, Tuxforge Lab",
    alt: "Community members with Tux penguins and open source projects",
  },
];
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Left Column: Copy & Actions (ML Bangladesh Screenshot 1 style) -->
    <div class="hero-content">
      <h1 class="hero-title">
        Democratizing Linux &amp; Open Source Education.
      </h1>

      <p class="hero-description">
        The Penguins Club is a charity and non-profit community initiative
        running from 2020. We host community Linux mirrors, distribute free
        educational booklets, leaflets &amp; stickers, and deliver valuable
        practical lessons and monthly workshops.
      </p>

      <div class="hero-cta-row">
        <a
          href="https://t.me/penguinsclubnetwork"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill-primary"
        >
          Join
        </a>
        <a href="#programs" class="hero-text-link btn-pill-secondary">
          See our programs
        </a>
      </div>

      <!-- Metadata Line (separated by slashes, exactly as in Screenshot 1) -->
      <div class="hero-meta-row">
        <span>Non-Profit Charity Network</span>
        <span class="meta-slash">/</span>
        <span>Run entirely by volunteers</span>
        <span class="meta-slash">/</span>
        <span>Free for every student</span>
        <span class="meta-slash">/</span>
        <span>26/18 Gulshan Badda Link Road</span>
      </div>
    </div>

    <!-- Right Column: Community Photo Carousel (Screenshot 1 style) -->
    <div class="hero-visual">
      <div
        class="hero-carousel-card"
        id="hero-carousel"
        aria-label="Community Meetups Carousel"
      >
        <div class="carousel-slides-wrap">
          {
            heroSlides.map((slide, index) => (
              <div
                class={`carousel-slide ${index === 0 ? "is-active" : ""}`}
                data-index={index}
              >
                <img
                  src={slide.image}
                  alt={slide.alt}
                  class="slide-img"
                  loading={index === 0 ? "eager" : "lazy"}
                />
                <div class="slide-overlay">
                  <p class="slide-caption">{slide.caption}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Carousel Indicators (Pill + Dots at bottom center) -->
        <div class="carousel-indicators" role="tablist" aria-label="Slide dots">
          {
            heroSlides.map((_, index) => (
              <button
                class={`indicator-dot ${index === 0 ? "is-active" : ""}`}
                data-target={index}
                aria-label={`Go to slide ${index + 1}`}
                role="tab"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client script for smooth auto-rotation and interactive dots -->
<script>
  function initHeroCarousel() {
    const carousel = document.getElementById("hero-carousel");
    if (!carousel) return;

    const slides = carousel.querySelectorAll<HTMLElement>(".carousel-slide");
    const dots = carousel.querySelectorAll<HTMLElement>(".indicator-dot");
    if (!slides.length) return;

    let currentIndex = 0;
    let timer: number | undefined;

    function goToSlide(index: number) {
      slides[currentIndex]?.classList.remove("is-active");
      dots[currentIndex]?.classList.remove("is-active");

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex]?.classList.add("is-active");
      dots[currentIndex]?.classList.add("is-active");
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 5000);
    }

    function stopAutoPlay() {
      if (timer) clearInterval(timer);
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        goToSlide(idx);
        startAutoPlay();
      });
    });

    carousel.addEventListener("mouseenter", stopAutoPlay);
    carousel.addEventListener("mouseleave", startAutoPlay);

    startAutoPlay();
  }

  // Initialize on load and Astro page transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroCarousel);
  } else {
    initHeroCarousel();
  }
</script>

<style>
  .hero-section {
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-canvas);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container {
      grid-template-columns: 1.05fr 1fr;
      gap: 3.5rem;
    }
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    max-width: 620px;
  }

  .hero-title {
    font-size: clamp(2.2rem, 3.8vw, 3.15rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.35rem;
  }

  .hero-description {
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Actions Row */
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.75rem;
  }

  .hero-text-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease;
  }

  .hero-text-link:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  /* Metadata Line with slashes (Screenshot 1) */
  .hero-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .meta-slash {
    color: var(--border-card-hover);
    font-weight: 300;
    user-select: none;
  }

  /* Right Column: Hero Photo Carousel Card */
  .hero-visual {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-carousel-card {
    position: relative;
    width: 100%;
    max-width: 580px;
    aspect-ratio: 16 / 11;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.16);
    background: #0f172a;
    border: 1px solid var(--border-card);
  }

  .carousel-slides-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.6s ease;
  }

  .carousel-slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Subtle bottom gradient for caption clarity */
  .slide-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 3.5rem 1.5rem 1.25rem 1.5rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.4) 55%,
      transparent 100%
    );
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    pointer-events: none;
  }

  .slide-caption {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    max-width: 65%;
  }

  /* Indicator Dots at bottom right */
  .carousel-indicators {
    position: absolute;
    bottom: 1.15rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 5;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 5px 9px;
    border-radius: var(--radius-pill);
    pointer-events: auto;
  }

  .indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.45);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.25s ease;
  }

  .indicator-dot:hover {
    background: rgba(255, 255, 255, 0.8);
  }

  .indicator-dot.is-active {
    width: 20px;
    background: #ffffff;
  }
</style>
