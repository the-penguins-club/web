---
// Warm, human-first hero: friendly headline, real-feeling stats, illustrated mascot card.
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-pill-badge">
        <span class="pulse-dot"></span>
        <span class="pill-label">Open source &bull; Free software &bull; Real people</span>
      </div>

      <h1 class="hero-title">
        Linux &amp; open source, <span class="hero-highlight">minus the intimidation.</span>
      </h1>

      <p class="hero-description">
        The Penguins Club is a friendly, community-run home for anyone curious about Linux and Free/Open Source Software — from your first terminal command to your first pull request. We host meetups, hackathons, and honest conversations, and nobody here will make you feel dumb for asking.
      </p>

      <div class="hero-cta-group">
        <a href="#events" class="btn-primary">
          See what's coming up
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="#community" class="btn-secondary">Say hello in chat</a>
      </div>

      <div class="hero-avatars">
        <div class="avatar-stack" aria-hidden="true">
          <span class="avatar-chip" style="background:var(--accent-coral)">🐧</span>
          <span class="avatar-chip" style="background:var(--accent-teal)">🐧</span>
          <span class="avatar-chip" style="background:var(--accent-amber)">🐧</span>
          <span class="avatar-chip" style="background:var(--accent-berry)">🐧</span>
          <span class="avatar-chip avatar-more">+1.8k</span>
        </div>
        <p class="avatar-caption">people who started out exactly where you are right now</p>
      </div>
    </div>

    <!-- Illustrated welcome card, replaces the old terminal window -->
    <div class="hero-visual">
      <div class="hero-blob">
        <div class="speech-bubble">
          First time here? We saved you a seat. 👋
        </div>

        <svg class="mascot" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M24 4C17.37 4 13 9.37 13 16C13 19.5 14.5 23 12 28C9.5 33 10 39 12 41C14 43 18 43 20 42C21.5 43.5 23.5 44 26 44C30 44 34 42 36 39C38 36 38 31 35 27C33.5 24.5 35 20.5 35 16C35 9.37 30.63 4 24 4Z" fill="var(--bg-card)" stroke="var(--text-primary)" stroke-width="2"/>
          <ellipse cx="24" cy="30" rx="8" ry="10" fill="var(--accent-teal)" fill-opacity="0.25"/>
          <circle cx="19" cy="15" r="2" fill="var(--text-primary)"/>
          <circle cx="29" cy="15" r="2" fill="var(--text-primary)"/>
          <path d="M20 18H28L24 23L20 18Z" fill="var(--accent-amber)"/>
          <path d="M16 41C13 41 12 43 14 44C16 45 19 44 21 42" stroke="var(--accent-coral)" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M32 41C35 41 36 43 34 44C32 45 29 44 27 42" stroke="var(--accent-coral)" stroke-width="2.5" stroke-linecap="round"/>
        </svg>

        <div class="floating-chip chip-a">🚀 32+ projects incubated</div>
        <div class="floating-chip chip-b">☕ 45+ meetups &amp; sprints</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .hero-container {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 3rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin-bottom: 1.4rem;
  }

  .hero-highlight {
    color: var(--text-accent);
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
  }

  /* Avatar stack */
  .hero-avatars {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .avatar-stack {
    display: flex;
    align-items: center;
  }

  .avatar-chip {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    border: 2px solid var(--bg-canvas);
    margin-left: -10px;
  }

  .avatar-chip:first-child {
    margin-left: 0;
  }

  .avatar-more {
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .avatar-caption {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Illustrated welcome card */
  .hero-visual {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-blob {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--bg-elevated) 0%, var(--bg-card) 100%);
    border: 1px solid var(--border-card);
    border-radius: 45% 55% 60% 40% / 55% 45% 55% 45%;
    box-shadow: var(--shadow-md);
  }

  .mascot {
    width: 45%;
    height: 45%;
  }

  .speech-bubble {
    position: absolute;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 78%;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: 0.85rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
  }

  .floating-chip {
    position: absolute;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 9999px;
    padding: 0.5rem 0.9rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }

  .chip-a {
    bottom: 14%;
    left: -4%;
  }

  .chip-b {
    bottom: -2%;
    right: -2%;
  }
</style>
