---
// Hero Component - Linux & Open Source Community
// Directly matching the modern non-profit design style of ML Bangladesh (Screenshot 1)
const heroSlides = [
  {
    image: "/images/meetups/meetup-sentinelops-presentation.jpg",
    caption: "Live Systems, eBPF & SRE CLI Workshop, Dhaka",
    alt: "The Penguins Club live systems engineering and eBPF presentation in Dhaka"
  },
  {
    image: "/images/meetups/software-freedom.png",
    caption: "Software Freedom Day Gathering, Dhaka",
    alt: "The Penguins Club members gathered in Dhaka for Software Freedom Day"
  },
  {
    image: "/images/meetups/meetup-workshop-daffodil.png",
    caption: "Campus Workshop & Speaker Panel, Daffodil International University",
    alt: "University workshop introducing students to GNU/Linux and terminal commands"
  },
  {
    image: "/images/meetups/meetup-community-dinner.jpg",
    caption: "Post-Meetup Community Dinner & Collaboration",
    alt: "The Penguins Club members gathered around table sharing meals and open source discussions"
  },
  {
    image: "/images/meetups/software-freedom-day.png",
    caption: "Open Systems Roundtable & Community Lab, Dhaka",
    alt: "Hands-on laptops and open source roundtable discussion"
  },
  {
    image: "/images/meetups/community-arch-linux-terminal.jpg",
    caption: "Arch Linux, Kernel & Systemd Tuning Session",
    alt: "Hands-on terminal session running Arch Linux and systemd services"
  }
];
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Left Column: Copy & Actions (ML Bangladesh Screenshot 1 style) -->
    <div class="hero-content">
      <h1 class="hero-title">
        Learn Linux and open source with us. Free since 2020.
      </h1>

      <p class="hero-description">
        We're a volunteer-run charity. There's a meetup or a workshop every
        month, install-fests on campus, and sessions on security, privacy, and
        making sense of the technology everyone uses every day. We host and
        share technical resources locally too, everything from software mirrors
        to free stickers and booklets. Join us, it's free.
      </p>

      <div class="hero-cta-row">
        <a
          href="https://t.me/penguinsclubnetwork"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill-primary"
        >
          Join on Telegram
        </a>
        <a href="#programs" class="hero-text-link">
          See our programs
        </a>
      </div>

      <!-- Metadata Line (separated by slashes, exactly as in Screenshot 1) -->
      <div class="hero-meta-row">
        <span>Non-Profit Charity Network</span>
        <span class="meta-slash" aria-hidden="true">/</span>
        <span>Run entirely by volunteers</span>
        <span class="meta-slash" aria-hidden="true">/</span>
        <span>Free for every student</span>
        <span class="meta-slash" aria-hidden="true">/</span>
        <span>26/18 Gulshan Badda Link Road</span>
      </div>
    </div>

    <!-- Right Column: Community Photo Carousel (Screenshot 1 style) -->
    <div class="hero-visual">
      <div
        class="hero-carousel-card"
        id="hero-carousel"
        aria-label="Community Meetups Carousel"
      >
        <div class="carousel-slides-wrap">
          {
            heroSlides.map((slide, index) => (
              <div
                class={`carousel-slide ${index === 0 ? "is-active" : ""}`}
                data-index={index}
              >
                <img
                  src={slide.image}
                  alt={slide.alt}
                  class="slide-img"
                  loading={index === 0 ? "eager" : "lazy"}
                />
                <div class="slide-overlay">
                  <p class="slide-caption">{slide.caption}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Carousel Indicators (Pill + Dots at bottom center) -->
        <div class="carousel-indicators">
          {
            heroSlides.map((_, index) => (
              <button
                type="button"
                class={`indicator-dot ${index === 0 ? "is-active" : ""}`}
                data-target={index}
                aria-label={`Go to slide ${index + 1}`}
                aria-current={index === 0 ? "true" : undefined}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client script for the slide dots (no autoplay: slides change only when asked) -->
<script>
  function initHeroCarousel() {
    const carousel = document.getElementById("hero-carousel");
    if (!carousel) return;

    const slides = carousel.querySelectorAll<HTMLElement>(".carousel-slide");
    const dots = carousel.querySelectorAll<HTMLElement>(".indicator-dot");
    if (!slides.length) return;

    let currentIndex = 0;

    function goToSlide(index: number) {
      slides[currentIndex]?.classList.remove("is-active");
      dots[currentIndex]?.classList.remove("is-active");
      dots[currentIndex]?.removeAttribute("aria-current");

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex]?.classList.add("is-active");
      dots[currentIndex]?.classList.add("is-active");
      dots[currentIndex]?.setAttribute("aria-current", "true");
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => goToSlide(idx));
    });
  }

  // Initialize on load and Astro page transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroCarousel);
  } else {
    initHeroCarousel();
  }
</script>

<style>
  .hero-section {
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-canvas);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container {
      grid-template-columns: 1.05fr 1fr;
      gap: 3.5rem;
    }
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    max-width: 620px;
  }

  .hero-title {
    font-size: clamp(2.2rem, 3.8vw, 3.15rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1.35rem;
  }

  .hero-description {
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Actions Row */
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.75rem;
  }

  .hero-text-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease;
  }

  .hero-text-link:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  /* Metadata Line with slashes (Screenshot 1) */
  .hero-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .meta-slash {
    color: var(--border-card-hover);
    font-weight: 300;
    user-select: none;
  }

  /* Right Column: Hero Photo Carousel Card */
  .hero-visual {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-carousel-card {
    position: relative;
    width: 100%;
    max-width: 580px;
    aspect-ratio: 16 / 11;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: none;
    background: #0f172a;
    border: 1px solid var(--border-card);
  }

  .carousel-slides-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.6s ease;
  }

  .carousel-slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Subtle bottom gradient for caption clarity */
  .slide-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 3.5rem 1.5rem 1.25rem 1.5rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.4) 55%,
      transparent 100%
    );
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    pointer-events: none;
  }

  .slide-caption {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    max-width: 65%;
  }

  /* Indicator Dots at bottom right */
  .carousel-indicators {
    position: absolute;
    bottom: 1.15rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    z-index: 5;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 0 4px;
    border-radius: var(--radius-pill);
    pointer-events: auto;
  }

  /* 24px hit area; the visible dot is drawn by ::before */
  .indicator-dot {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .indicator-dot::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.65);
    transition: width 0.25s ease, background-color 0.25s ease;
  }

  .indicator-dot:hover::before {
    background: rgba(255, 255, 255, 0.85);
  }

  .indicator-dot.is-active::before {
    width: 20px;
    background: #ffffff;
  }

  .indicator-dot.is-active {
    min-width: 32px;
  }
</style>
