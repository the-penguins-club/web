---
// Hero Component - Non-Profit Linux & Open Source Community
// Running continuously since 2020 • Perfectly proportioned, responsive layout
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Left Column: Copy & Actions -->
    <div class="hero-content">
      <div class="hero-pill-badge">
        <span class="pulse-dot"></span>
        <span class="pill-label">Non-Profit Organization • Running Since 2020</span>
      </div>

      <h1 class="hero-title">
        Democratizing <span class="hero-highlight">Linux</span> &amp; Open Source Education.
      </h1>

      <p class="hero-description">
        The Penguins Club is a non-profit community initiative established in 2020. We empower students, engineers, and everyday computer users through free monthly meetups, hands-on Linux workshops, open source mentoring, and public data initiatives — free from commercial gatekeeping.
      </p>

      <div class="hero-cta-group">
        <a href="https://t.me/penguinsclubnetwork" target="_blank" rel="noopener noreferrer" class="btn-primary hero-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          Join Telegram Community
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="#gallery" class="btn-secondary hero-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          Monthly Meetups Gallery
        </a>
      </div>

      <!-- Real Non-Profit Impact Metrics -->
      <div class="hero-stats-strip glass-card">
        <div class="stat-col">
          <span class="stat-val">2020</span>
          <span class="stat-text">Active Since</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-col">
          <span class="stat-val">Monthly</span>
          <span class="stat-text">Regular Meetups</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-col">
          <span class="stat-val">30+</span>
          <span class="stat-text">GitHub Repos</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-col">
          <span class="stat-val">100% Free</span>
          <span class="stat-text">Volunteer-Driven</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Clean Non-Profit Terminal / Identity Card -->
    <div class="hero-visual">
      <div class="hero-org-card glass-card">
        <!-- Top window chrome -->
        <div class="card-terminal-bar">
          <div class="terminal-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="terminal-title">thepenguins.club — non-profit organization</span>
        </div>

        <div class="card-inner">
          <!-- Org Identity Row -->
          <div class="org-identity-row">
            <div class="mascot-circle-wrap">
              <svg class="mascot-svg" width="44" height="44" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 4C17.37 4 13 9.37 13 16C13 19.5 14.5 23 12 28C9.5 33 10 39 12 41C14 43 18 43 20 42C21.5 43.5 23.5 44 26 44C30 44 34 42 36 39C38 36 38 31 35 27C33.5 24.5 35 20.5 35 16C35 9.37 30.63 4 24 4Z" fill="var(--bg-canvas)" stroke="currentColor" stroke-width="2.5"/>
                <ellipse cx="24" cy="30" rx="8" ry="10" fill="currentColor" fill-opacity="0.15"/>
                <circle cx="19" cy="15" r="2" fill="currentColor"/>
                <circle cx="29" cy="15" r="2" fill="currentColor"/>
                <path d="M20 18H28L24 23L20 18Z" fill="var(--accent-amber)"/>
                <path d="M16 41C13 41 12 43 14 44C16 45 19 44 21 42" stroke="var(--accent-amber)" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M32 41C35 41 36 43 34 44C32 45 29 44 27 42" stroke="var(--accent-amber)" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="org-headings">
              <h2 class="org-name">The Penguins Club</h2>
              <span class="org-meta-line">Established 2020 &bull; Bangladesh &amp; Global</span>
            </div>
          </div>

          <!-- Non-Profit Terminal Snippet -->
          <div class="terminal-body">
            <div class="cli-row">
              <span class="cli-prompt">$</span>
              <span class="cli-cmd">cat /etc/tpc/mission.txt</span>
            </div>
            <p class="cli-text">
              "We provide free education on GNU/Linux systems, open source tooling, privacy defense, and digital sovereignty. Open to all without commercial paywalls."
            </p>

            <div class="cli-row">
              <span class="cli-prompt">$</span>
              <span class="cli-cmd">status --organization</span>
            </div>
            <div class="status-tags-row">
              <span class="status-badge green-badge">
                <span class="badge-dot"></span>
                Non-Profit Community
              </span>
              <span class="status-badge blue-badge">Monthly Meetups</span>
              <span class="status-badge teal-badge">Active on Telegram</span>
            </div>
          </div>

          <!-- Quick Action Footer inside Card -->
          <div class="card-footer-box">
            <div class="footer-channel-info">
              <span class="channel-label">Official Community Group:</span>
              <a href="https://t.me/penguinsclubnetwork" target="_blank" rel="noopener noreferrer" class="channel-link">
                t.me/penguinsclubnetwork
              </a>
            </div>
            <a href="https://t.me/penguinsclubnetwork" target="_blank" rel="noopener noreferrer" class="btn-primary card-join-btn">
              Join Group &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(2.5rem, 5vw, 4.25rem);
    padding-bottom: clamp(3rem, 5vw, 4.75rem);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  @media (min-width: 1024px) {
    .hero-container {
      display: grid;
      grid-template-columns: 1.15fr 0.95fr;
      align-items: center;
      gap: 3.5rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.35rem;
    box-shadow: var(--shadow-sm);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .hero-highlight {
    color: var(--text-accent);
  }

  .hero-description {
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .hero-btn {
    padding: 0.75rem 1.4rem;
    font-size: 0.9rem;
  }

  /* Stats Strip */
  .hero-stats-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 560px;
    padding: 1.1rem 1.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
  }

  .stat-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
  }

  .stat-val {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-accent);
    line-height: 1;
  }

  .stat-text {
    font-size: 0.725rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .stat-sep {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
    flex-shrink: 0;
  }

  /* Right Visual Card */
  .hero-visual {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-org-card {
    width: 100%;
    max-width: 460px;
    padding: 0;
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-glow);
    box-shadow: var(--shadow-glow);
    border-radius: var(--radius-lg);
  }

  .card-terminal-bar {
    background: var(--bg-subtle);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .terminal-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-inner {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .org-identity-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mascot-circle-wrap {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--badge-bg);
    border: 1px solid var(--border-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--text-accent);
  }

  .mascot-svg {
    width: 32px;
    height: 32px;
    display: block;
  }

  .org-headings {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .org-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.2;
    margin: 0;
  }

  .org-meta-line {
    font-size: 0.775rem;
    color: var(--text-muted);
    display: block;
  }

  /* Terminal Snippet */
  .terminal-body {
    background: var(--bg-terminal);
    color: #e2e8f0;
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.825rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .cli-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cli-prompt {
    color: #64748b;
  }

  .cli-cmd {
    color: #38bdf8;
  }

  .cli-text {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  .status-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.2rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.725rem;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  .green-badge {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .blue-badge {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .teal-badge {
    background: rgba(20, 184, 166, 0.15);
    color: #2dd4bf;
    border: 1px solid rgba(20, 184, 166, 0.3);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  /* Card Footer Box */
  .card-footer-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .footer-channel-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .channel-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .channel-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-accent);
  }

  .card-join-btn {
    padding: 0.55rem 0.95rem;
    font-size: 0.8rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
