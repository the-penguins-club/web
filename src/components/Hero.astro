---
// Hero Component - Linux & Open Source Community
// Directly matching the modern non-profit design style of ML Bangladesh (Screenshot 1)
const heroSlides = [
  {
    image: "/images/meetups/meetup-sentinelops-presentation.jpg",
    caption: "Live Systems, eBPF & SRE CLI Workshop, Dhaka",
    alt: "The Penguins Club live systems engineering and eBPF presentation in Dhaka"
  },
  {
    image: "/images/meetups/software-freedom.png",
    caption: "Software Freedom Day Gathering, Dhaka",
    alt: "The Penguins Club members gathered in Dhaka for Software Freedom Day"
  },
  {
    image: "/images/meetups/meetup-workshop-daffodil.png",
    caption: "Campus Workshop & Speaker Panel, Daffodil International University",
    alt: "University workshop introducing students to GNU/Linux and terminal commands"
  },
  {
    image: "/images/meetups/meetup-community-dinner.jpg",
    caption: "Post-Meetup Community Dinner & Collaboration",
    alt: "The Penguins Club members gathered around table sharing meals and open source discussions"
  },
  {
    image: "/images/meetups/software-freedom-day.png",
    caption: "Open Systems Roundtable & Community Lab, Dhaka",
    alt: "Hands-on laptops and open source roundtable discussion"
  },
  {
    image: "/images/meetups/community-arch-linux-terminal.jpg",
    caption: "Arch Linux, Kernel & Systemd Tuning Session",
    alt: "Hands-on terminal session running Arch Linux and systemd services"
  }
];

// Key facts under the CTAs; icons are Feather-style strokes drawn in currentColor
const heroFacts = [
  { text: "Non-Profit Charity Network", icon: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>' },
  { text: "Run entirely by volunteers", icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { text: "Free for every student", icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>' },
  { text: "26/18 Gulshan Badda Link Road", icon: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>' }
];
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Left Column: Copy & Actions (ML Bangladesh Screenshot 1 style) -->
    <div class="hero-content">
      <h1 class="hero-title">
        Learn Linux and open source with us. Free since 2020.
      </h1>

      <p class="hero-description">
        We're a volunteer-run charity. There's a meetup or a workshop every
        month, install-fests on campus, and sessions on security, privacy, and
        making sense of the technology everyone uses every day. We host and
        share technical resources locally too, everything from software mirrors
        to free stickers and booklets. Join us, it's free.
      </p>

      <div class="hero-cta-row">
        <a
          href="https://t.me/penguinsclubnetwork"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill-primary"
        >
          Join on Telegram
        </a>
        <a href="#programs" class="btn-pill-secondary hero-muted-btn">
          See our programs
        </a>
      </div>

      <!-- Key facts: a two-column list, so nothing dangles when it wraps -->
      <ul class="hero-meta-row">
        {heroFacts.map((fact) => (
          <li>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={fact.icon} />
            <span>{fact.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Right Column: Community Photo Carousel (Screenshot 1 style) -->
    <div class="hero-visual">
      <div
        class="hero-carousel-card"
        id="hero-carousel"
        aria-label="Community Meetups Carousel"
      >
        <div class="carousel-slides-wrap">
          {
            heroSlides.map((slide, index) => (
              <div
                class={`carousel-slide ${index === 0 ? "is-active" : ""}`}
                data-index={index}
              >
                <img
                  src={slide.image}
                  alt={slide.alt}
                  class="slide-img"
                  loading={index === 0 ? "eager" : "lazy"}
                />
                <div class="slide-overlay">
                  <p class="slide-caption">{slide.caption}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Carousel Indicators (Pill + Dots at bottom center) -->
        <div class="carousel-indicators">
          <button type="button" class="slide-toggle" data-motion-toggle aria-controls="hero-carousel">Pause slides</button>
          {
            heroSlides.map((_, index) => (
              <button
                type="button"
                class={`indicator-dot ${index === 0 ? "is-active" : ""}`}
                data-target={index}
                aria-label={`Go to slide ${index + 1}`}
                aria-current={index === 0 ? "true" : undefined}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client script for the slide dots and autoplay.
     Autoplay holds while hovered or focused, stops via the Pause button (WCAG 2.2.2),
     and never starts when the reader prefers reduced motion. -->
<script>
  function initHeroCarousel() {
    const carousel = document.getElementById("hero-carousel");
    if (!carousel) return;

    const slides = carousel.querySelectorAll<HTMLElement>(".carousel-slide");
    const dots = carousel.querySelectorAll<HTMLElement>(".indicator-dot");
    if (!slides.length) return;

    let currentIndex = 0;

    function goToSlide(index: number) {
      slides[currentIndex]?.classList.remove("is-active");
      dots[currentIndex]?.classList.remove("is-active");
      dots[currentIndex]?.removeAttribute("aria-current");

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex]?.classList.add("is-active");
      dots[currentIndex]?.classList.add("is-active");
      dots[currentIndex]?.setAttribute("aria-current", "true");
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => goToSlide(idx));
    });

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    window.setInterval(() => {
      const held = carousel.matches(":hover, :focus-within") || carousel.classList.contains("is-paused");
      if (!held) goToSlide(currentIndex + 1);
    }, 5000);
  }

  // Initialize on load and Astro page transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroCarousel);
  } else {
    initHeroCarousel();
  }
</script>

<style>
  .hero-section {
    padding-top: clamp(2rem, 3.5vw, 3rem);
    padding-bottom: clamp(2.5rem, 3.5vw, 3rem);
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-canvas);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3.5rem;
      /* Photo spans the full height of the copy: top at the headline, bottom at the facts */
      align-items: stretch;
    }

    .hero-carousel-card {
      max-width: none;
      aspect-ratio: auto;
      min-height: 22rem;
    }
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    max-width: 620px;
  }

  .hero-title {
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .hero-description {
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Actions Row */
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  /* Two pills don't fit side by side on phones; stack them at equal width */
  @media (max-width: 479px) {
    .hero-cta-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
  }

  .hero-muted-btn {
    background: var(--bg-elevated);
    border-color: transparent;
    box-shadow: none;
  }

  .hero-muted-btn:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-card-hover);
  }

  /* Metadata Line with slashes (Screenshot 1) */
  .hero-meta-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem 1.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .hero-meta-row li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-meta-row svg {
    flex: none;
    color: var(--accent-primary);
  }

  /* Right Column: Hero Photo Carousel Card */
  .hero-visual {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-carousel-card {
    position: relative;
    width: 100%;
    max-width: 580px;
    aspect-ratio: 16 / 11;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: none;
    background: #0f172a;
    border: 1px solid var(--border-card);
  }

  .carousel-slides-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.6s ease;
  }

  .carousel-slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Caption as a pill in the top-right corner, matching the controls pill below */
  .slide-overlay {
    position: absolute;
    top: 1rem;
    right: 1rem;
    max-width: calc(100% - 2rem);
    padding: 0.35rem 0.85rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: var(--radius-pill);
    pointer-events: none;
  }

  .slide-caption {
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  /* Indicator Dots at bottom right */
  .carousel-indicators {
    position: absolute;
    bottom: 1.15rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    z-index: 5;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 0 4px;
    border-radius: var(--radius-pill);
    pointer-events: auto;
  }

  .slide-toggle {
    min-height: 24px;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #ffffff;
  }

  .slide-toggle:hover {
    text-decoration: underline;
  }

  .slide-toggle:focus-visible,
  .indicator-dot:focus-visible {
    outline-color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-toggle { display: none; }
  }

  /* 24px hit area; the visible dot is drawn by ::before */
  .indicator-dot {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .indicator-dot::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.65);
    transition: width 0.25s ease, background-color 0.25s ease;
  }

  .indicator-dot:hover::before {
    background: rgba(255, 255, 255, 0.85);
  }

  .indicator-dot.is-active::before {
    width: 20px;
    background: #ffffff;
  }

  .indicator-dot.is-active {
    min-width: 32px;
  }
</style>
