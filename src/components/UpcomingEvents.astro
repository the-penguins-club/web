    width: 100%;
    max-width: 1320px;
    margin: 0 auto 4.5rem;
  }

  .featured-event-card {
    background: #14201b; /* Exact deep navy from screenshot */
    background: #14201b;
    border-radius: 1.25rem;
    padding: clamp(1.75rem, 3.2vw, 2.75rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
    box-shadow: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .featured-event-card {
      grid-template-columns: 220px minmax(0, 1fr) 320px;
      gap: 2.25rem;
    }
  }

  @media (min-width: 1160px) {
    .featured-event-card {
      grid-template-columns: 240px minmax(0, 1fr) 350px;
      gap: 3.25rem;
    }
  }

  /* Left Square Image */
  .featured-img-link {
    display: block;
    width: 100%;
    max-width: 240px;
    margin: 0 auto;
  }

  .featured-img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background: #061124;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .featured-event-card:hover .featured-img {
    transform: scale(1.04);
  }

  /* Center Content */
