---
// Upcoming Events Component with Category Filtering, Calendar Export & RSVP Modal
interface EventItem {
  id: string;
  category: "hackathon" | "meetup" | "workshop" | "discussion";
  categoryLabel: string;
  badge: string;
  badgeType: "hot" | "live" | "open";
  title: string;
  date: {
    month: string;
    day: string;
    year: string;
    dayOfWeek: string;
    iso: string; // for calendar export
  };
  time: string;
  location: string;
  isVirtual: boolean;
  speaker: string;
  description: string;
  spotsLeft?: number;
  tags: string[];
}

const events: EventItem[] = [
  {
    id: "event-hack-2026",
    category: "hackathon",
    categoryLabel: "Hackathon",
    badge: "Flagship Hackathon",
    badgeType: "hot",
    title: "The Penguins Sprint: 48h FOSS Hackathon",
    date: {
      month: "OCT",
      day: "03-05",
      year: "2026",
      dayOfWeek: "Fri - Sun",
      iso: "2026-10-03T18:00:00Z"
    },
    time: "18:00 UTC (48 Hours)",
    location: "Hybrid: Open Space Center & Matrix / Discord Bridge",
    isVirtual: true,
    speaker: "Mentors from Debian, Arch & Fedora communities",
    description: "48 hours of hacking, snacks, and shipping. Build new FOSS tools, fix long-standing upstream bugs, or package software for distribution — mentors around the clock so nobody's stuck for long.",
    spotsLeft: 42,
    tags: ["Hackathon", "Rust/C/Go", "FOSS Sprint", "Mentorship"]
  },
  {
    id: "event-meetup-ebpf",
    category: "meetup",
    categoryLabel: "Community Meetup",
    badge: "In-Person & Stream",
    badgeType: "live",
    title: "Linux Kernel 6.12+ & eBPF Observability Deep Dive",
    date: {
      month: "OCT",
      day: "17",
      year: "2026",
      dayOfWeek: "Saturday",
      iso: "2026-10-17T15:00:00Z"
    },
    time: "15:00 - 18:30 UTC",
    location: "TPC Hacker Lounge & Live Stream",
    isVirtual: true,
    speaker: "Aria Thorne (Linux Kernel Contributor) + Lightning Talks",
    description: "A friendly, jargon-explained tour of the latest scheduler improvements and how eBPF is changing system tracing — plus a few open-mic lightning talks from the community.",
    spotsLeft: 18,
    tags: ["Kernel", "eBPF", "Performance", "Lightning Talks"]
  },
  {
    id: "event-workshop-privacy",
    category: "workshop",
    categoryLabel: "FOSS Awareness",
    badge: "Free Workshop",
    badgeType: "open",
    title: "Digital Sovereignty: Escaping Big Tech with Self-Hosted FOSS",
    date: {
      month: "NOV",
      day: "05",
      year: "2026",
      dayOfWeek: "Thursday",
      iso: "2026-11-05T17:00:00Z"
    },
    time: "17:00 - 19:30 UTC",
    location: "Online (Jitsi Meet / Federated Stream)",
    isVirtual: true,
    speaker: "Devin Vance (Privacy & Free Software Activist)",
    description: "A hands-on, no-prior-experience-needed workshop on setting up your own self-hosted cloud, an encrypted Matrix homeserver, and a calmer, more private GNU/Linux desktop.",
    spotsLeft: 75,
    tags: ["Privacy", "Self-Hosting", "GNU/Linux", "Awareness"]
  },
  {
    id: "event-ama-distro",
    category: "discussion",
    categoryLabel: "Online Discussion",
    badge: "Live Audio AMA",
    badgeType: "open",
    title: "The Distro Dilemma: Immutable vs Traditional Linux Desktops",
    date: {
      month: "NOV",
      day: "21",
      year: "2026",
      dayOfWeek: "Saturday",
      iso: "2026-11-21T16:00:00Z"
    },
    time: "16:00 - 17:30 UTC",
    location: "Matrix Space Voice Channel & Discord Stage",
    isVirtual: true,
    speaker: "Panel of Fedora Silverblue, NixOS, and Arch Maintainers",
    description: "An open, no-flame-wars debate on atomic updates, declarative configs, Flatpaks, and where personal computing is headed. Bring your strongest opinion and your best manners.",
    spotsLeft: 150,
    tags: ["Immutable Linux", "NixOS", "Flatpak", "Live AMA"]
  }
];
---

<section id="events" class="events-section">
  <div class="container">
    <div class="events-header">
      <div class="header-left">
        <div class="section-tag">Calendar &amp; sprints</div>
        <h2 class="section-title">Come hang out with us</h2>
        <p class="section-desc">
          Meetups, sprint hackathons, workshops, and weekly roundtables — all free, all community-organized, all genuinely welcoming to first-timers.
        </p>
      </div>

      <!-- Live Countdown Card for Next Flagship Hackathon -->
      <div class="countdown-card glass-card">
        <div class="countdown-top">
          <span class="pulse-dot"></span>
          <span class="countdown-title">Next up: the FOSS Hackathon</span>
        </div>
        <div class="countdown-timer" id="sprint-countdown">
          <div class="time-block">
            <span class="time-val" id="cd-days">19</span>
            <span class="time-label">Days</span>
          </div>
          <span class="time-sep">:</span>
          <div class="time-block">
            <span class="time-val" id="cd-hours">14</span>
            <span class="time-label">Hours</span>
          </div>
          <span class="time-sep">:</span>
          <div class="time-block">
            <span class="time-val" id="cd-mins">30</span>
            <span class="time-label">Mins</span>
          </div>
          <span class="time-sep">:</span>
          <div class="time-block">
            <span class="time-val" id="cd-secs">00</span>
            <span class="time-label">Secs</span>
          </div>
        </div>
        <div class="countdown-footer">
          <a href="#event-hack-2026" class="countdown-btn">Count me in &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Filter Tabs -->
    <div class="event-filter-bar">
      <button class="filter-tab active" data-category="all">
        All Events <span class="tab-badge">{events.length}</span>
      </button>
      <button class="filter-tab" data-category="hackathon">
        Hackathons <span class="tab-badge">{events.filter(e => e.category === 'hackathon').length}</span>
      </button>
      <button class="filter-tab" data-category="meetup">
        Meetups <span class="tab-badge">{events.filter(e => e.category === 'meetup').length}</span>
      </button>
      <button class="filter-tab" data-category="workshop">
        Workshops <span class="tab-badge">{events.filter(e => e.category === 'workshop').length}</span>
      </button>
      <button class="filter-tab" data-category="discussion">
        Discussions <span class="tab-badge">{events.filter(e => e.category === 'discussion').length}</span>
      </button>
    </div>

    <!-- Events List -->
    <div class="events-grid" id="events-grid">
      {events.map((evt) => (
        <article class="event-card glass-card" data-event-category={evt.category} id={evt.id}>
          <div class="event-date-column">
            <div class="date-box">
              <span class="date-month">{evt.date.month}</span>
              <span class="date-day">{evt.date.day}</span>
              <span class="date-year">{evt.date.year}</span>
              <span class="date-dow">{evt.date.dayOfWeek}</span>
            </div>
            <div class="event-type-label">{evt.categoryLabel}</div>
          </div>

          <div class="event-main-content">
            <div class="event-top-meta">
              <span class={`event-badge badge-${evt.badgeType}`}>
                {evt.badge}
              </span>
              <span class="event-time-meta">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                {evt.time}
              </span>
              <span class="event-location-meta">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {evt.location}
              </span>
            </div>

            <h3 class="event-title">{evt.title}</h3>
            <p class="event-description">{evt.description}</p>

            <div class="event-speaker">
              <span class="speaker-avatar">👤</span>
              <span class="speaker-text"><b>Hosted by</b> {evt.speaker}</span>
            </div>

            <div class="event-tags-row">
              {evt.tags.map(t => (
                <span class="event-tag-item">{t}</span>
              ))}
              {evt.spotsLeft && (
                <span class="spots-chip">🔥 {evt.spotsLeft} spots left</span>
              )}
            </div>
          </div>

          <div class="event-actions-column">
            <button
              type="button"
              class="btn-primary rsvp-trigger"
              data-event-id={evt.id}
              data-event-title={evt.title}
              data-event-date={`${evt.date.month} ${evt.date.day}, ${evt.date.year}`}
            >
              I'm in
            </button>

            <button
              type="button"
              class="btn-secondary cal-export-trigger"
              data-title={evt.title}
              data-desc={evt.description}
              data-loc={evt.location}
              data-iso={evt.date.iso}
              title="Add event to your calendar (.ics)"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Add to calendar
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Interactive RSVP Modal -->
  <div id="rsvp-modal" class="modal-backdrop" aria-hidden="true">
    <div class="modal-container glass-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-header">
        <div class="modal-pill">
          <span class="pulse-dot"></span>
          <span>You're almost in</span>
        </div>
        <button id="modal-close" class="modal-close-btn" aria-label="Close dialog">&times;</button>
      </div>

      <div class="modal-body">
        <h3 id="modal-title" class="modal-event-title">Event Title</h3>
        <p class="modal-event-date" id="modal-event-date">Oct 03, 2026</p>
        <p class="modal-note">
          It's free, and we mean it — no ads, no trackers, no surprise emails.
        </p>

        <form id="rsvp-form" class="modal-form">
          <div class="form-group">
            <label for="rsvp-name">Your name or handle</label>
            <input type="text" id="rsvp-name" placeholder="e.g. Linus / tuxlover" required class="modal-input" />
          </div>

          <div class="form-group">
            <label for="rsvp-contact">Matrix handle or email</label>
            <input type="text" id="rsvp-contact" placeholder="e.g. @user:matrix.org or you@foss.org" required class="modal-input" />
          </div>

          <div class="form-group">
            <label for="rsvp-attendance">How are you joining?</label>
            <select id="rsvp-attendance" class="modal-input">
              <option value="virtual">Virtual (stream / Jitsi)</option>
              <option value="in-person">In-person (if venue permits)</option>
            </select>
          </div>

          <div class="modal-actions">
            <button type="button" id="modal-cancel-btn" class="btn-secondary">Cancel</button>
            <button type="submit" class="btn-primary">Confirm RSVP</button>
          </div>
        </form>

        <div id="rsvp-success" class="rsvp-success-state" style="display: none;">
          <div class="success-icon">🎉</div>
          <h4>You're on the list!</h4>
          <p>We've saved your spot. Check your Matrix client or inbox for the invite and stream link — see you there.</p>
          <button type="button" id="rsvp-done-btn" class="btn-primary" style="margin-top: 1rem;">Done</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client JavaScript for Event Filtering, Countdown, Calendar & RSVP Modal -->
<script>
  // Filter Tabs
  const filterTabs = document.querySelectorAll('.filter-tab');
  const eventCards = document.querySelectorAll<HTMLElement>('.event-card');

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const cat = tab.getAttribute('data-category');
      eventCards.forEach(card => {
        if (cat === 'all' || card.getAttribute('data-event-category') === cat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Countdown Timer
  const daysEl = document.getElementById('cd-days');
  const hoursEl = document.getElementById('cd-hours');
  const minsEl = document.getElementById('cd-mins');
  const secsEl = document.getElementById('cd-secs');

  // Target date: October 3, 2026 18:00 UTC
  const targetDate = new Date('2026-10-03T18:00:00Z').getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const diff = targetDate - now;

    if (diff > 0) {
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
      if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
      if (minsEl) minsEl.textContent = String(mins).padStart(2, '0');
      if (secsEl) secsEl.textContent = String(secs).padStart(2, '0');
    }
  }

  setInterval(updateCountdown, 1000);
  updateCountdown();

  // Calendar .ics generator & download
  const calButtons = document.querySelectorAll('.cal-export-trigger');
  calButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-title') || 'TPC Community Event';
      const desc = btn.getAttribute('data-desc') || 'The Penguins Club event';
      const loc = btn.getAttribute('data-loc') || 'Virtual';
      const iso = btn.getAttribute('data-iso') || new Date().toISOString();

      const startDate = new Date(iso);
      const endDate = new Date(startDate.getTime() + 3 * 60 * 60 * 1000);

      const formatCalDate = (d: Date) => d.toISOString().replace(/-|:|\.\d+/g, '');

      const icsContent = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//The Penguins Club//Event Calendar//EN',
        'BEGIN:VEVENT',
        `SUMMARY:${title}`,
        `DESCRIPTION:${desc.replace(/\n/g, '\\n')}`,
        `LOCATION:${loc}`,
        `DTSTART:${formatCalDate(startDate)}`,
        `DTEND:${formatCalDate(endDate)}`,
        'STATUS:CONFIRMED',
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `${title.toLowerCase().replace(/[^a-z0-9]/g, '-')}.ics`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });
  });

  // RSVP Modal Logic
  const modal = document.getElementById('rsvp-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalDate = document.getElementById('modal-event-date');
  const modalClose = document.getElementById('modal-close');
  const modalCancel = document.getElementById('modal-cancel-btn');
  const rsvpForm = document.getElementById('rsvp-form');
  const rsvpSuccess = document.getElementById('rsvp-success');
  const rsvpDoneBtn = document.getElementById('rsvp-done-btn');
  const rsvpTriggers = document.querySelectorAll('.rsvp-trigger');

  function openModal(title: string, date: string) {
    if (modal && modalTitle && modalDate) {
      modalTitle.textContent = title;
      modalDate.textContent = `Date: ${date}`;
      modal.classList.add('is-active');
      modal.setAttribute('aria-hidden', 'false');
      if (rsvpForm) rsvpForm.style.display = 'block';
      if (rsvpSuccess) rsvpSuccess.style.display = 'none';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
    }
  }

  rsvpTriggers.forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-event-title') || 'Event RSVP';
      const date = btn.getAttribute('data-event-date') || '';
      openModal(title, date);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modalCancel?.addEventListener('click', closeModal);
  rsvpDoneBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  rsvpForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (rsvpForm) rsvpForm.style.display = 'none';
    if (rsvpSuccess) rsvpSuccess.style.display = 'block';
  });
</script>

<style>
  .events-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
  }

  .events-header {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 960px) {
    .events-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
    .header-left {
      max-width: 580px;
    }
  }

  /* Countdown Card */
  .countdown-card {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 320px;
  }

  .countdown-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .countdown-title {
    font-size: 0.85rem;
    color: var(--text-primary);
    font-weight: 700;
  }

  .countdown-timer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .time-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    min-width: 54px;
  }

  .time-val {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  .time-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .time-sep {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .countdown-footer {
    display: flex;
    justify-content: flex-end;
  }

  .countdown-btn {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-accent-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: transform 0.2s ease;
  }

  .countdown-btn:hover {
    transform: translateX(4px);
  }

  /* Filter Tabs */
  .event-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.75rem;
    margin-bottom: 2rem;
    scrollbar-width: thin;
  }

  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.6rem 1.1rem;
    border-radius: 9999px;
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border-card);
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .filter-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-glow);
  }

  .filter-tab.active {
    background: var(--badge-bg);
    color: var(--badge-text);
    border-color: var(--badge-border);
  }

  .tab-badge {
    font-size: 0.7rem;
    background: rgba(43, 35, 30, 0.08);
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
  }

  /* Events Grid / Card */
  .events-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .event-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    gap: 1.75rem;
  }

  @media (min-width: 860px) {
    .event-card {
      flex-direction: row;
      align-items: center;
    }
  }

  .event-date-column {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.25rem;
    min-width: 140px;
  }

  @media (min-width: 860px) {
    .event-date-column {
      flex-direction: column;
      align-items: flex-start;
      border-right: 1px solid var(--border-subtle);
      padding-right: 1.5rem;
    }
  }

  .date-box {
    display: flex;
    flex-direction: column;
  }

  .date-month {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .date-day {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
  }

  .date-year {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .date-dow {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .event-type-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-accent-secondary);
    background: var(--bg-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid var(--border-subtle);
  }

  .event-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .event-top-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .event-badge {
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
  }

  .badge-hot {
    background: rgba(242, 100, 60, 0.14);
    border: 1px solid rgba(242, 100, 60, 0.3);
    color: var(--text-accent);
  }

  .badge-live {
    background: rgba(31, 156, 130, 0.14);
    border: 1px solid rgba(31, 156, 130, 0.3);
    color: var(--text-accent-secondary);
  }

  .badge-open {
    background: rgba(244, 185, 66, 0.18);
    border: 1px solid rgba(244, 185, 66, 0.35);
    color: var(--text-accent-warn);
  }

  .event-time-meta, .event-location-meta {
    display: flex;
