---
// Monthly Meetup Schedule & Timeline Showcase
// Matches user design specification: "What's Coming Up"
// Features a prominent horizontal Featured Card (Touch Grass) + central dashed timeline with alternating left/right event cards
// High-precision live countdown timers with glowing digital tiles.

import { getDynamicEvents } from '../data/events';

const events = await getDynamicEvents();

// Featured Super Event at top
const featuredEvent = events.find((e) => e.isSuper) || events[0];

// Chronological timeline events below
const timelineEvents = events
  .filter((e) => e.slug !== featuredEvent.slug)
  .sort((a, b) => new Date(a.startDateIso).getTime() - new Date(b.startDateIso).getTime());
---

<section id="events" class="whats-coming-up-section">
  <div class="container events-showcase-container">
    <!-- Header matching user screenshot -->
    <div class="section-title-wrap">
      <span class="section-sub-heading">EVENTS &amp; ACTIVITIES</span>
      <h2 class="section-main-heading">What’s Coming Up</h2>
    </div>

    <!-- Featured Banner Card (Top dark-blue container matching screenshot) -->
    <div class="featured-event-container">
      <article class="featured-event-card">
        <!-- Left Thumbnail (Square rounded matching screenshot) -->
        <a href={`/events/${featuredEvent.slug}`} class="featured-img-link" aria-label={`View ${featuredEvent.title}`}>
          <div class="featured-img-wrap">
            <img
              src="/images/meetups/touch-grass-square.svg"
              alt={featuredEvent.title}
              class="featured-img"
              loading="lazy"
            />
          </div>
        </a>

        <!-- Center Content -->
        <div class="featured-content-col">
          <div class="featured-badge-pill">
            <span>FEATURED</span>
          </div>

          <h3 class="featured-title">
            <a href={`/events/${featuredEvent.slug}`}>{featuredEvent.title}</a>
          </h3>

          <p class="featured-desc">{featuredEvent.description}</p>

          <div class="featured-action-wrap">
            <a href={`/events/${featuredEvent.slug}`} class="featured-learn-btn">
              <span>Event Details &amp; Schedule</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <a
              href={`/events/${featuredEvent.slug}.ics`}
              download={`${featuredEvent.slug}.ics`}
              class="featured-ics-btn"
              title="Download dynamic RFC 5545 .ics file"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Add to Calendar (.ics)</span>
            </a>
          </div>
        </div>

        <!-- Right Meta & Live Countdown Column -->
        <div class="featured-meta-col">
          <div class="featured-status-tag">
            <span class="status-indicator-dot"></span>
            <span>HAPPENING SOON</span>
          </div>

          <div class="featured-meta-list">
            <div class="featured-meta-row">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Sat, 07 November 2026</span>
            </div>

            <div class="featured-meta-row">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>13:30 - 18:00 BST</span>
            </div>

            <div class="featured-meta-row location-row">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Ramna Park Lake Amphitheatre, Dhaka</span>
            </div>
          </div>

          <!-- Ultra-Nice High-Precision Countdown Timer Box -->
          <div class="featured-countdown-box" data-countdown-box data-start-iso={featuredEvent.startDateIso} data-end-iso={featuredEvent.endDateIso}>
            <div class="countdown-mini-header">
              <span class="timer-beacon"></span>
              <span class="timer-title">LIVE COUNTDOWN</span>
            </div>
            
            <div class="timer-segments-row" data-clock-row>
              <div class="timer-segment">
                <span class="seg-val" data-u="d">--</span>
                <span class="seg-label">DAYS</span>
              </div>
              <span class="seg-sep">:</span>
              <div class="timer-segment">
                <span class="seg-val" data-u="h">--</span>
                <span class="seg-label">HOURS</span>
              </div>
              <span class="seg-sep">:</span>
              <div class="timer-segment">
                <span class="seg-val" data-u="m">--</span>
                <span class="seg-label">MINS</span>
              </div>
              <span class="seg-sep">:</span>
              <div class="timer-segment">
                <span class="seg-val" data-u="s">--</span>
                <span class="seg-label">SECS</span>
              </div>
            </div>

            <div class="timer-live-state" style="display:none;">
              <span>🔴 Live Now &bull; Join Telegram Stream</span>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- Alternating Timeline Structure (matching screenshot) -->
    <div class="timeline-wrapper">
      <!-- Central Vertical Dashed Axis -->
      <div class="timeline-axis-line"></div>

      <div class="timeline-nodes-list">
        {timelineEvents.map((evt, index) => {
          const isLeft = index % 2 === 0;
          return (
            <div class={`timeline-entry-row ${isLeft ? 'is-left' : 'is-right'}`}>
              <!-- Branching Horizontal Dashed Line -->
              <div class="timeline-branch-connector"></div>

              <!-- Red Nodal Dot on Central Axis (matching screenshot) -->
              <div class="timeline-nodal-dot"></div>

              <!-- Event Card -->
              <article class="timeline-card">
                <!-- Card Header Tag Row -->
                <div class="timeline-tag-row">
                  <span class="timeline-date-tag">
                    {evt.theme === 'hacktoberfest' ? '🎃 HACKTOBERFEST SPECIAL' : evt.dateBadge.toUpperCase()}
                  </span>
                </div>

                <!-- Event Title -->
                <h3 class="timeline-card-title">
                  <a href={`/events/${evt.slug}`}>{evt.title}</a>
                </h3>

                <!-- Description -->
                <p class="timeline-card-desc">{evt.description}</p>

                <!-- Location Pin Row -->
                <div class="timeline-location-row">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <span>{evt.location}</span>
                </div>

                <!-- Sleek Live Countdown Timer Widget -->
                <div class="timeline-countdown-widget" data-countdown-box data-start-iso={evt.startDateIso} data-end-iso={evt.endDateIso}>
                  <div class="widget-timer-label">
                    <span class="timer-pulse-circle"></span>
                    <span>STARTS IN</span>
                  </div>

                  <div class="widget-timer-display" data-clock-row>
                    <div class="widget-unit-tile">
                      <b data-u="d">00</b><small>d</small>
                    </div>
                    <span class="widget-colon">:</span>
                    <div class="widget-unit-tile">
                      <b data-u="h">00</b><small>h</small>
                    </div>
                    <span class="widget-colon">:</span>
                    <div class="widget-unit-tile">
                      <b data-u="m">00</b><small>m</small>
                    </div>
                    <span class="widget-colon">:</span>
                    <div class="widget-unit-tile">
                      <b data-u="s">00</b><small>s</small>
                    </div>
                  </div>

                  <div class="timer-live-state" style="display:none;">
                    <span>🔴 Live Now!</span>
                  </div>
                </div>

                <!-- Card Bottom Actions -->
                <div class="timeline-card-footer">
                  <a href={`/events/${evt.slug}`} class="timeline-view-link">
                    <span>View Event Page</span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>

                  <div class="timeline-aux-links">
                    <a
                      href={`/events/${evt.slug}.ics`}
                      download={`${evt.slug}.ics`}
                      class="timeline-ics-link"
                      title="Download dynamic RFC 5545 .ics file"
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                      <span>.ics</span>
                    </a>

                    <a
                      href={evt.registrationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="timeline-tg-link"
                      title="Attend via Telegram"
                    >
                      <span>Telegram</span>
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          );
        })}
      </div>

      <!-- Bottom Timeline Action -->
      <div class="timeline-bottom-bar">
        <a href="/events" class="btn-primary timeline-explore-all-btn">
          <span>Explore All 5 Events in Directory</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href="/events.ics"
          download="the-penguins-club-events.ics"
          class="timeline-sub-feed-btn"
          title="Subscribe to all events in Apple Calendar, Google Calendar, or Thunderbird"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Subscribe to Calendar Feed (.ics)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- High-Precision Real-Time Countdown Script -->
<script>
  function initLiveTimers() {
    const boxes = document.querySelectorAll<HTMLElement>('[data-countdown-box][data-start-iso]');
    
    function tick() {
      const now = Date.now();
      boxes.forEach((box) => {
        const startStr = box.getAttribute('data-start-iso');
        const endStr = box.getAttribute('data-end-iso');
        if (!startStr) return;

        const startTime = new Date(startStr).getTime();
        const endTime = endStr ? new Date(endStr).getTime() : startTime + 4 * 3600 * 1000;
        const diff = startTime - now;

        const dEl = box.querySelector<HTMLElement>('[data-u="d"]');
        const hEl = box.querySelector<HTMLElement>('[data-u="h"]');
        const mEl = box.querySelector<HTMLElement>('[data-u="m"]');
        const sEl = box.querySelector<HTMLElement>('[data-u="s"]');
        const clockRow = box.querySelector<HTMLElement>('[data-clock-row]');
        const liveNotice = box.querySelector<HTMLElement>('.timer-live-state');

        if (diff > 0) {
          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
          const minutes = Math.floor((diff / (1000 * 60)) % 60);
          const seconds = Math.floor((diff / 1000) % 60);

          if (dEl) dEl.textContent = String(days).padStart(2, '0');
          if (hEl) hEl.textContent = String(hours).padStart(2, '0');
          if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
          if (sEl) sEl.textContent = String(seconds).padStart(2, '0');

          if (clockRow) clockRow.style.display = 'flex';
          if (liveNotice) liveNotice.style.display = 'none';
        } else if (now >= startTime && now <= endTime) {
          if (clockRow) clockRow.style.display = 'none';
          if (liveNotice) {
            liveNotice.style.display = 'block';
            liveNotice.innerHTML = '<span>🔴 Happening Live Now!</span>';
          }
        } else {
          if (clockRow) clockRow.style.display = 'none';
          if (liveNotice) {
            liveNotice.style.display = 'block';
            liveNotice.innerHTML = '<span>Event Concluded</span>';
          }
        }
      });
    }

    tick();
    setInterval(tick, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLiveTimers);
  } else {
    initLiveTimers();
  }
</script>

<style>
  .whats-coming-up-section {
    padding: clamp(4rem, 7vw, 6rem) 0;
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-canvas);
  }

  /* Section Title Header (Screenshot style) */
  .section-title-wrap {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .section-sub-heading {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    font-weight: 700;
    color: #b45309; /* Warm brown/amber matching screenshot */
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

