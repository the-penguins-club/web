---
// Upcoming events: one featured event plus a dated agenda list.
// Countdowns are driven by the script below via data-countdown-box / data-u hooks.
import { getDynamicEvents } from '../data/events';

const events = await getDynamicEvents();

const featuredEvent = events.find((e) => e.isSuper) || events[0];

const upcoming = events
  .filter((e) => e.slug !== featuredEvent.slug)
  .sort((a, b) => new Date(a.startDateIso).getTime() - new Date(b.startDateIso).getTime());

const tones = { grass: 'mint', hacktoberfest: 'coral', linux: 'sky', git: 'lavender', selfhost: 'lime' } as const;
const toneOf = (e: { theme: keyof typeof tones }) => tones[e.theme] ?? 'mint';
const month = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { month: 'short', timeZone: 'Asia/Dhaka' });
const day = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', timeZone: 'Asia/Dhaka' });
---

<section id="events" class="events-section">
  <div class="container">
    <div class="events-header">
      <div class="header-content">
        <h2 class="section-title">What&rsquo;s coming up</h2>
        <p class="section-desc">Monthly meetups, workshops and special events. Free for everyone, in Dhaka and online.</p>
      </div>
      <div class="header-actions">
        <a href="/events" class="btn-primary">All events &rarr;</a>
        <a href="/events.ics" download="the-penguins-club-events.ics" class="btn-secondary" title="Subscribe in Apple Calendar, Google Calendar, or Thunderbird">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg><span>Subscribe (.ics)</span>
        </a>
      </div>
    </div>

    <article class={`featured tone-${toneOf(featuredEvent)}`}>
      <a href={`/events/${featuredEvent.slug}`} class="featured-img" aria-label={`View ${featuredEvent.title}`}>
        <img src={featuredEvent.image} alt="" loading="lazy" />
      </a>

      <div class="featured-body">
        <p class="eyebrow"><span class="beacon"></span>Featured &middot; happening soon</p>
        <h3 class="featured-title"><a href={`/events/${featuredEvent.slug}`}>{featuredEvent.title}</a></h3>
        <p class="featured-desc">{featuredEvent.description}</p>

        <ul class="meta">
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg><span>{featuredEvent.dateBadge}</span></li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><span>{featuredEvent.venueName}</span></li>
        </ul>

        <div class="countdown featured-countdown" data-countdown-box data-start-iso={featuredEvent.startDateIso} data-end-iso={featuredEvent.endDateIso}>
          <span class="label">Starts in</span>
          <div class="clock clock-lg" data-clock-row>
              <span><b data-u="d">--</b><small>d</small></span>
              <span><b data-u="h">--</b><small>h</small></span>
              <span><b data-u="m">--</b><small>m</small></span>
              <span><b data-u="s">--</b><small>s</small></span>
            </div>
          <div class="timer-live-state" style="display:none;"></div>
        </div>

        <div class="actions">
          <a href={`/events/${featuredEvent.slug}`} class="act-primary">Event details &amp; schedule &rarr;</a>
          <a href={`/events/${featuredEvent.slug}.ics`} download={`${featuredEvent.slug}.ics`} class="act-ghost" title="Download .ics">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg><span>Add to calendar</span>
          </a>
        </div>
      </div>
    </article>

    <ol class="agenda">
      {upcoming.map((evt) => (
        <li class={`row tone-${toneOf(evt)}`}>
          <div class="date" aria-hidden="true">
            <span class="date-month">{month(evt.startDateIso)}</span>
            <span class="date-day">{day(evt.startDateIso)}</span>
          </div>

          <div class="row-main">
            <h3 class="row-title"><a href={`/events/${evt.slug}`}>{evt.title}</a></h3>
            <p class="row-desc">{evt.description}</p>
            <ul class="meta meta-sm">
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg><span>{evt.timeString}</span></li>
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><span>{evt.venueName}</span></li>
            </ul>
          </div>

          <div class="row-side">
            <div class="countdown" data-countdown-box data-start-iso={evt.startDateIso} data-end-iso={evt.endDateIso}>
              <span class="label">Starts in</span>
              <div class="clock" data-clock-row>
              <span><b data-u="d">--</b><small>d</small></span>
              <span><b data-u="h">--</b><small>h</small></span>
              <span><b data-u="m">--</b><small>m</small></span>
              <span><b data-u="s">--</b><small>s</small></span>
            </div>
              <div class="timer-live-state" style="display:none;"></div>
            </div>
            <div class="actions actions-sm">
              <a href={`/events/${evt.slug}`} class="act-primary">Details &rarr;</a>
              <a href={`/events/${evt.slug}.ics`} download={`${evt.slug}.ics`} class="act-ghost" title="Download .ics">.ics</a>
              <a href={evt.registrationUrl} target="_blank" rel="noopener noreferrer" class="act-ghost" title="Attend via Telegram">Telegram</a>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- High-Precision Real-Time Countdown Script -->
<script>
  function initLiveTimers() {
    const boxes = document.querySelectorAll<HTMLElement>('[data-countdown-box][data-start-iso]');
    
    function tick() {
      const now = Date.now();
      boxes.forEach((box) => {
        const startStr = box.getAttribute('data-start-iso');
        const endStr = box.getAttribute('data-end-iso');
        if (!startStr) return;

        const startTime = new Date(startStr).getTime();
        const endTime = endStr ? new Date(endStr).getTime() : startTime + 4 * 3600 * 1000;
        const diff = startTime - now;

        const dEl = box.querySelector<HTMLElement>('[data-u="d"]');
        const hEl = box.querySelector<HTMLElement>('[data-u="h"]');
        const mEl = box.querySelector<HTMLElement>('[data-u="m"]');
        const sEl = box.querySelector<HTMLElement>('[data-u="s"]');
        const clockRow = box.querySelector<HTMLElement>('[data-clock-row]');
        const liveNotice = box.querySelector<HTMLElement>('.timer-live-state');

        if (diff > 0) {
          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
          const minutes = Math.floor((diff / (1000 * 60)) % 60);
          const seconds = Math.floor((diff / 1000) % 60);

          if (dEl) dEl.textContent = String(days).padStart(2, '0');
          if (hEl) hEl.textContent = String(hours).padStart(2, '0');
          if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
          if (sEl) sEl.textContent = String(seconds).padStart(2, '0');

          if (clockRow) clockRow.style.display = 'flex';
          if (liveNotice) liveNotice.style.display = 'none';
        } else if (now >= startTime && now <= endTime) {
          if (clockRow) clockRow.style.display = 'none';
          if (liveNotice) {
            liveNotice.style.display = 'block';
            liveNotice.innerHTML = '<span>🔴 Happening Live Now!</span>';
          }
        } else {
          if (clockRow) clockRow.style.display = 'none';
          if (liveNotice) {
            liveNotice.style.display = 'block';
            liveNotice.innerHTML = '<span>Event Concluded</span>';
          }
        }
      });
    }

    tick();
    setInterval(tick, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLiveTimers);
  } else {
    initLiveTimers();
  }
</script>

<style>
  .events-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .events-header { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem; }
  .header-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .header-actions .btn-secondary { display: inline-flex; align-items: center; gap: 0.5rem; }

  @media (min-width: 860px) {
    .events-header { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .header-content { max-width: 620px; }
    .header-content .section-desc { margin-bottom: 0; }
  }

  /* Event colours: one tint per event theme */
  .tone-mint, .tone-coral, .tone-sky, .tone-lavender, .tone-lime { --tint: #d1fae5; --ink: #0a7a5a; }
  .tone-coral    { --tint: #ffd9cb; --ink: #b4472a; }
  .tone-sky      { --tint: #d6e9ff; --ink: #1d5fa8; }
  .tone-lavender { --tint: #e6e0fb; --ink: #5b3fc4; }
  .tone-lime     { --tint: #eaf9a8; --ink: #3f5a0b; }

  :global([data-theme="dark"]) .tone-mint     { --tint: #12372b; --ink: #34d399; }
  :global([data-theme="dark"]) .tone-coral    { --tint: #3a2420; --ink: #f0a088; }
  :global([data-theme="dark"]) .tone-sky      { --tint: #15304f; --ink: #7bb8f5; }
  :global([data-theme="dark"]) .tone-lavender { --tint: #2a2547; --ink: #a78bfa; }
  :global([data-theme="dark"]) .tone-lime     { --tint: #2c3410; --ink: #d4f55a; }

  /* Featured */
  .featured {
    display: grid;
    gap: 1.5rem;
    padding: 0.75rem;
    margin-bottom: 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--tint);
  }

  @media (min-width: 900px) { .featured { grid-template-columns: 5fr 7fr; gap: 2.5rem; align-items: center; } }

  .featured-img { display: block; border-radius: calc(var(--radius-xl) - 6px); overflow: hidden; aspect-ratio: 8 / 5; background: var(--bg-card); }
  .featured-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .featured-img:hover img { transform: scale(1.04); }
  .featured-img:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }

  .featured-body { display: grid; gap: 1rem; padding: 0.5rem 1rem 1.25rem; justify-items: start; }
  @media (min-width: 900px) { .featured-body { padding: 1.25rem 1.5rem 1.25rem 0; } }

  .eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink); }
  .beacon { width: 8px; height: 8px; border-radius: 50%; background: var(--ink); animation: pulse 1.8s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.3; } }

  .featured-title { font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.35rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; color: var(--text-primary); }
  .featured-title a:hover { color: var(--ink); }
  .featured-desc { font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); max-width: 58ch; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .meta { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.85rem; color: var(--text-secondary); }
  .meta li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .meta svg { color: var(--ink); flex: none; }
  .meta-sm { font-size: 0.78rem; color: var(--text-muted); }

  /* Countdown */
  .countdown { display: inline-flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .clock { display: flex; align-items: baseline; gap: 0.6rem; font-variant-numeric: tabular-nums; }
  .clock span { display: inline-flex; align-items: baseline; gap: 0.15rem; }
  .clock b { font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; color: var(--text-primary); }
  .clock small { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); }

  .clock-lg { gap: 0.5rem; }
  .clock-lg span { flex-direction: column; align-items: center; gap: 0.1rem; min-width: 3.6rem; padding: 0.55rem 0.4rem; border-radius: var(--radius-md); background: var(--bg-card); }
  .clock-lg b { font-size: 1.6rem; line-height: 1; }

  .timer-live-state { font-size: 0.85rem; font-weight: 700; color: var(--ink); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .act-primary { padding: 0.6rem 1.1rem; border-radius: var(--radius-pill); background: var(--text-primary); color: var(--bg-card); font-size: 0.85rem; font-weight: 700; transition: transform 0.15s ease; }
  .act-primary:hover { transform: translateX(2px); }
  .act-ghost { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1rem; border-radius: var(--radius-pill); border: 1px solid var(--border-card-hover); color: var(--text-primary); font-size: 0.82rem; font-weight: 600; transition: background-color 0.15s ease; }
  .act-ghost:hover { background: var(--bg-card); }
  .actions-sm .act-primary { padding: 0.45rem 0.9rem; font-size: 0.8rem; }
  .actions-sm .act-ghost { padding: 0.4rem 0.8rem; font-size: 0.75rem; }
  .act-primary:focus-visible, .act-ghost:focus-visible, .featured-title a:focus-visible, .row-title a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* Agenda list */
  .agenda { list-style: none; border-top: 2px solid var(--text-primary); }

  .row { display: grid; grid-template-columns: auto 1fr; gap: 1rem 1.25rem; padding: 1.5rem 0.25rem; border-bottom: 1px solid var(--border-card); }
  .row-side { grid-column: 1 / -1; display: grid; gap: 0.75rem; }

  @media (min-width: 960px) {
    .row { grid-template-columns: auto minmax(0, 1fr) auto; gap: 2rem; align-items: center; padding: 1.75rem 0.5rem; }
    .row-side { grid-column: auto; justify-items: end; }
    .row-side .countdown { justify-content: flex-end; }
  }

  .date { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 4.25rem; aspect-ratio: 1; border-radius: var(--radius-lg); background: var(--tint); color: var(--ink); line-height: 1; }
  .date-month { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .date-day { font-family: var(--font-display); font-size: 1.75rem; font-weight: 800; margin-top: 0.25rem; }

  .row-title { font-family: var(--font-display); font-size: clamp(1.1rem, 1.8vw, 1.35rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.25; color: var(--text-primary); }
  .row-title a:hover { color: var(--ink); }
  .row-desc { margin: 0.35rem 0 0.6rem; font-size: 0.88rem; line-height: 1.55; color: var(--text-secondary); max-width: 62ch; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .beacon { animation: none; }
    .featured-img img, .act-primary { transition: none; }
    .featured-img:hover img, .act-primary:hover { transform: none; }
  }
</style>
