    color: #f59e0b;
  }

  .section-main-heading {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.15;
  }

  /* Section Showcase Container - Expanded for widescreen view */
