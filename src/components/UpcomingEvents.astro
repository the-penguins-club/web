  }

  .featured-action-wrap {
    margin-top: 0.75rem;
  }

  .featured-learn-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #38bdf8;
    background: rgba(111, 211, 168, 0.12);
    border: 1px solid rgba(111, 211, 168, 0.35);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    transition: all 0.15s ease;
  }

  .featured-learn-btn:hover {
    background: rgba(111, 211, 168, 0.22);
    color: #ffffff;
    transform: translateX(2px);
  }

  /* Right Meta & Live Countdown Column */
  .featured-meta-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: rgba(4, 15, 36, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .featured-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
