---
// Monthly Meetup Schedule & Upcoming Community Events
// No fake countdowns or made-up statistics; genuine non-profit education schedule

interface MeetupScheduleItem {
  id: string;
  badge: string;
  badgeType: "primary" | "secondary" | "neutral";
  title: string;
  schedule: string;
  format: string;
  location: string;
  topics: string[];
  description: string;
  calTitle: string;
}

const upcomingMeetups: MeetupScheduleItem[] = [
  {
    id: "meetup-upcoming-oct",
    badge: "Next Monthly Meetup",
    badgeType: "primary",
    title: "Linux Command Line, Shell Scripting & System Internals",
    schedule: "Every Month • Third Saturday",
    format: "In-Person Gathering & Interactive Live Stream",
    location: "Community Venue (Dhaka) & Telegram Live Stream",
    topics: ["GNU/Linux CLI Essentials", "Bash Scripting & Automation", "Managing Services with systemd", "Live Q&A"],
    description: "A friendly, beginner-accessible meetup walking through terminal fundamentals, automating repetitive tasks with bash scripts, and understanding core system components.",
    calTitle: "The Penguins Club Monthly Meetup - Linux & CLI Essentials"
  },
  {
    id: "meetup-upcoming-nov",
    badge: "Monthly Series",
    badgeType: "secondary",
    title: "Contributing to Open Source Software & Git Best Practices",
    schedule: "Monthly Meetup • November Edition",
    format: "Hands-on Workshop & Mentorship Session",
    location: "Live Stream & Physical Lab Space",
    topics: ["Git Branching & PR Etiquette", "Navigating GitHub Repositories", "Finding Good First Issues", "Code Review"],
    description: "Hands-on workshop designed to guide students and early-career developers through cloning a repository, fixing an issue, writing tests, and opening their first pull request.",
    calTitle: "The Penguins Club Monthly Meetup - Open Source & Git"
  },
  {
    id: "meetup-upcoming-dec",
    badge: "Monthly Series",
    badgeType: "neutral",
    title: "Self-Hosting, Local Privacy & Digital Sovereignty",
    schedule: "Monthly Meetup • December Edition",
    format: "Presentation & Live Demo Lab",
    location: "Virtual & Local Hacker Space",
    topics: ["Containerization with Docker", "Local Cloud with Nextcloud", "DNS Ad-Blocking & Pi-hole", "Data Backups"],
    description: "Learn how to take control of your personal data by running your own open-source services on personal hardware or inexpensive home servers.",
    calTitle: "The Penguins Club Monthly Meetup - Self-Hosting & Privacy"
  }
];
---

<section id="events" class="events-section">
  <div class="container">
    <div class="events-header">
      <div class="header-left">
        <div class="section-tag">Monthly Community Meetups</div>
        <h2 class="section-title">Free, Monthly Learning Sessions</h2>
        <p class="section-desc">
          The Penguins Club organizes free monthly meetups dedicated to teaching Linux, open source development, cybersecurity, and digital sovereignty. Whether you are typing your first terminal command or administering production servers, you belong here.
        </p>
      </div>

      <!-- Non-Profit Pledge Pill -->
      <div class="schedule-info-card glass-card">
        <div class="card-pill">
          <span class="pulse-dot"></span>
          <span>Open Education Since 2020</span>
        </div>
        <h4 class="card-heading">Always Free &amp; Open</h4>
        <p class="card-copy">
          No admission fees, no corporate sponsorships dictating topics. Venue locations and streaming links are published directly in our Telegram group.
        </p>
        <a href="https://t.me/penguinsclubnetwork" target="_blank" rel="noopener noreferrer" class="btn-primary card-cta">
          Join Telegram for Meetup Alerts &rarr;
        </a>
      </div>
    </div>

    <!-- Meetups List -->
    <div class="meetup-schedule-list">
      {upcomingMeetups.map((m) => (
        <article class="schedule-card glass-card" id={m.id}>
          <div class="schedule-meta-col">
            <span class={`badge-status badge-${m.badgeType}`}>{m.badge}</span>
            <span class="schedule-time">{m.schedule}</span>
            <span class="schedule-format">{m.format}</span>
          </div>

          <div class="schedule-main-col">
            <h3 class="schedule-title">{m.title}</h3>
            <p class="schedule-desc">{m.description}</p>

            <div class="schedule-topics-row">
              {m.topics.map((t) => (
                <span class="topic-chip">{t}</span>
              ))}
            </div>

            <div class="schedule-loc-row">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span><b>Location:</b> {m.location}</span>
            </div>
          </div>

          <div class="schedule-actions-col">
            <a
              href="https://t.me/penguinsclubnetwork"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary action-btn"
            >
              Attend via Telegram
            </a>
            <button
              type="button"
              class="btn-secondary action-btn cal-btn"
              data-title={m.calTitle}
              data-desc={m.description}
              data-loc={m.location}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Add to Calendar (.ics)
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Calendar .ics generator script -->
<script>
  const calButtons = document.querySelectorAll('.cal-btn');
  calButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-title') || 'The Penguins Club Meetup';
      const desc = btn.getAttribute('data-desc') || 'Monthly Linux & FOSS meetup';
      const loc = btn.getAttribute('data-loc') || 'Dhaka & Online';

      const startDate = new Date();
      startDate.setDate(startDate.getDate() + 14);
      startDate.setHours(15, 0, 0, 0);
      const endDate = new Date(startDate.getTime() + 3 * 60 * 60 * 1000);

      const formatCalDate = (d: Date) => d.toISOString().replace(/-|:|\.\d+/g, '');

      const icsContent = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//The Penguins Club//Monthly Meetup//EN',
        'BEGIN:VEVENT',
        `SUMMARY:${title}`,
        `DESCRIPTION:${desc.replace(/\n/g, '\\n')}`,
        `LOCATION:${loc}`,
        `DTSTART:${formatCalDate(startDate)}`,
        `DTEND:${formatCalDate(endDate)}`,
        'STATUS:CONFIRMED',
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `${title.toLowerCase().replace(/[^a-z0-9]/g, '-')}.ics`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });
  });
</script>

<style>
  .events-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
    border-top: 1px solid var(--border-subtle);
  }

  .events-header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 900px) {
    .events-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
    .header-left {
      max-width: 600px;
    }
  }

  .schedule-info-card {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 320px;
    background: var(--bg-card);
  }

  .card-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .card-copy {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0.5rem;
  }

  .card-cta {
    font-size: 0.825rem;
    padding: 0.65rem 1rem;
    width: 100%;
  }

  /* Schedule List */
  .meetup-schedule-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .schedule-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    gap: 1.75rem;
  }

  @media (min-width: 860px) {
    .schedule-card {
      flex-direction: row;
      align-items: center;
    }
  }

  .schedule-meta-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 170px;
  }

  @media (min-width: 860px) {
    .schedule-meta-col {
      border-right: 1px solid var(--border-subtle);
      padding-right: 1.5rem;
    }
  }

  .badge-status {
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    display: inline-block;
    width: fit-content;
  }

  .badge-primary {
    background: color-mix(in srgb, var(--accent-coral) 14%, transparent);
    color: var(--text-accent);
    border: 1px solid color-mix(in srgb, var(--accent-coral) 28%, transparent);
  }

  .badge-secondary {
    background: color-mix(in srgb, var(--accent-teal) 14%, transparent);
    color: var(--text-accent-secondary);
    border: 1px solid color-mix(in srgb, var(--accent-teal) 28%, transparent);
  }

  .badge-neutral {
    background: var(--bg-subtle);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .schedule-time {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .schedule-format {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .schedule-main-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .schedule-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .schedule-desc {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .schedule-topics-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.25rem;
  }

  .topic-chip {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .schedule-loc-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .schedule-loc-row b {
    color: var(--text-primary);
  }

  .schedule-actions-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 190px;
  }

  .action-btn {
    width: 100%;
    font-size: 0.825rem;
    padding: 0.65rem 1rem;
    white-space: nowrap;
  }
</style>
