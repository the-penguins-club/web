---
// Community & Communication Hub Component
// Primary active channel: Telegram (@penguinsclubnetwork)
// Other channels marked as Coming Soon as requested

interface ChannelItem {
  platform: string;
  address: string;
  status: "active" | "coming_soon";
  statusLabel: string;
  description: string;
  actionText: string;
  url: string;
  icon: string;
  isPrimary?: boolean;
}

const communityChannels: ChannelItem[] = [
  {
    platform: "Telegram Community",
    address: "@penguinsclubnetwork",
    status: "active",
    statusLabel: "Official & Active",
    description: "Our primary live community hub. Join for monthly meetup announcements, instant technical discussions, Linux troubleshooting, and community networking.",
    actionText: "Join Telegram Group",
    url: "https://t.me/penguinsclubnetwork",
    isPrimary: true,
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>`
  },
  {
    platform: "Matrix Space",
    address: "#thepenguinsclub:matrix.org",
    status: "coming_soon",
    statusLabel: "Coming Soon",
    description: "Federated, end-to-end encrypted chat space on the open Matrix protocol. Currently being configured for bridges to our channels.",
    actionText: "Coming Soon",
    url: "#",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M.632.55v22.9H2.28V24H0V0h2.28v.55zm7.043 7.26v1.157h.033c.309-.424.719-.77 1.227-1.04.509-.269 1.114-.404 1.816-.404.61 0 1.164.103 1.662.31.498.206.914.512 1.25.918.334.407.585.908.751 1.503.167.595.251 1.278.251 2.05v6.58h-2.585v-5.914c0-.49-.033-.925-.098-1.306a2.2 2.2 0 00-.361-.926 1.767 1.767 0 00-.738-.592 2.65 2.65 0 00-1.196-.245c-.413 0-.796.082-1.147.245a2.215 2.215 0 00-.869.691c-.24.3-.414.673-.522 1.121-.109.448-.163.957-.163 1.528v5.398H4.25V7.81h2.585v-.001h.84zm15.693 15.64V.55H21.72V0H24v24h-2.28v-.55z"/></svg>`
  },
  {
    platform: "Discord Community",
    address: "The Penguins Club Discord",
    status: "coming_soon",
    statusLabel: "Coming Soon",
    description: "Dedicated voice lounges, live screen-share workshops, and audio rooms for our monthly meetup live streams.",
    actionText: "Coming Soon",
    url: "#",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>`
  },
  {
    platform: "Discourse Forum",
    address: "forum.thepenguins.club",
    status: "coming_soon",
    statusLabel: "Coming Soon",
    description: "Long-form async forum for distro guides, in-depth tutorials, system architecture RFCs, and non-profit governance discussions.",
    actionText: "Coming Soon",
    url: "#",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>`
  }
];
---

<section id="community" class="community-section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Community Hub</div>
      <h2 class="section-title">Connect with The Penguins Club</h2>
      <p class="section-desc">
        Our community operates primarily on Telegram, where we coordinate monthly meetups, answer Linux and open-source questions, and share real project updates. Everyone is welcome.
      </p>
    </div>

    <!-- Active Telegram Spotlight Card -->
    <div class="telegram-spotlight glass-card">
      <div class="spotlight-left">
        <div class="spotlight-badge">
          <span class="pulse-dot"></span>
          <span>Official Live Community Hub</span>
        </div>
        <h3 class="spotlight-title">Join our Telegram: @penguinsclubnetwork</h3>
        <p class="spotlight-desc">
          This is where our day-to-day community lives. Connect with students, sysadmins, software engineers, and FOSS advocates. Ask Linux questions, get help installing a distro, and stay notified about each upcoming monthly meetup.
        </p>
        <div class="spotlight-features">
          <span class="feature-item">✓ Monthly meetup dates &amp; links</span>
          <span class="feature-item">✓ Friendly Linux help &amp; discussions</span>
          <span class="feature-item">✓ Open source collaboration</span>
        </div>
      </div>

      <div class="spotlight-right">
        <a href="https://t.me/penguinsclubnetwork" target="_blank" rel="noopener noreferrer" class="btn-primary tg-large-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          Open Telegram Group
          <span aria-hidden="true">&rarr;</span>
        </a>
        <span class="tg-handle-hint">Direct link: t.me/penguinsclubnetwork</span>
      </div>
    </div>

    <!-- Secondary & Upcoming Platforms -->
    <div class="channels-section-heading">
      <h3 class="sub-heading">All Channels &amp; Roadmap</h3>
      <p class="sub-desc">We keep our channels focused on Telegram while preparing additional open protocols.</p>
    </div>

    <div class="channels-grid">
      {communityChannels.map((chan) => (
        <article class={`channel-card glass-card ${chan.isPrimary ? 'is-active-primary' : 'is-coming-soon'}`}>
          <div class="chan-top">
            <div class="chan-icon" set:html={chan.icon} />
            <span class={`status-tag status-${chan.status}`}>
              {chan.statusLabel}
            </span>
          </div>

          <h4 class="chan-name">{chan.platform}</h4>
          <div class="chan-address mono-accent">{chan.address}</div>
          <p class="chan-desc">{chan.description}</p>

          <div class="chan-footer">
            {chan.status === 'active' ? (
              <a href={chan.url} target="_blank" rel="noopener noreferrer" class="btn-primary chan-btn">
                {chan.actionText} &rarr;
              </a>
            ) : (
              <button type="button" class="btn-secondary chan-btn btn-disabled" disabled>
                {chan.actionText}
              </button>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- Non-Profit Contact Box -->
    <div class="contact-card glass-card">
      <div class="contact-info">
        <div class="pill-mini">Non-Profit Inquiries &amp; Outreach</div>
        <h3 class="contact-title">Need to reach the organizers directly?</h3>
        <p class="contact-desc">
          If you are an academic institution, community space, volunteer speaker, or open-source foundation interested in collaborating with The Penguins Club, send us an email.
        </p>
      </div>

      <div class="contact-actions">
        <a href="mailto:mail@thepenguins.club" class="btn-secondary email-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          mail@thepenguins.club
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .community-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
    border-top: 1px solid var(--border-subtle);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 2.75rem;
  }

  /* Telegram Spotlight */
  .telegram-spotlight {
    padding: 2.5rem;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent-coral) 8%, var(--bg-card)) 0%, var(--bg-card) 100%);
    border: 1px solid color-mix(in srgb, var(--accent-coral) 30%, var(--border-card));
    box-shadow: var(--shadow-glow);
  }

  @media (min-width: 900px) {
    .telegram-spotlight {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .spotlight-left {
      max-width: 620px;
    }
    .spotlight-right {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      min-width: 260px;
    }
  }

  .spotlight-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--text-accent);
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.85rem;
  }

  .spotlight-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .spotlight-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .spotlight-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .feature-item {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-subtle);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
  }

  .tg-large-btn {
    width: 100%;
    padding: 0.95rem 1.6rem;
    font-size: 1rem;
  }

  .tg-handle-hint {
    font-size: 0.775rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  /* Secondary Channels */
  .channels-section-heading {
    margin-bottom: 1.75rem;
  }

  .sub-heading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .sub-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .channels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .channels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .channels-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .channel-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  .is-active-primary {
    border-color: color-mix(in srgb, var(--accent-coral) 40%, var(--border-card));
  }

  .is-coming-soon {
    opacity: 0.82;
  }

  .chan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chan-icon {
    color: var(--text-accent);
  }

  .status-tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .status-active {
    background: color-mix(in srgb, var(--accent-teal) 14%, transparent);
    color: var(--text-accent-secondary);
    border: 1px solid color-mix(in srgb, var(--accent-teal) 30%, transparent);
  }

  .status-coming_soon {
    background: var(--bg-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .chan-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .chan-address {
    font-size: 0.8rem;
    word-break: break-all;
  }

  .chan-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .chan-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .chan-btn {
    width: 100%;
    font-size: 0.825rem;
    padding: 0.65rem 0.9rem;
  }

  .btn-disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Contact Card */
  .contact-card {
    padding: 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-subtle) 100%);
  }

  @media (min-width: 860px) {
    .contact-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .contact-info {
      max-width: 620px;
    }
  }

  .pill-mini {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .contact-desc {
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .email-btn {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
