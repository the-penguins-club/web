---
// Community & Online Discussion Hub Component
const channels = [
  {
    platform: "Matrix",
    address: "#tpc:matrix.org",
    protocol: "Federated & encrypted",
    description: "Our main chat space, on an open protocol with zero corporate surveillance. This is where most of the day-to-day conversation happens.",
    members: "1,240 online",
    actionText: "Join Matrix Space",
    url: "https://matrix.org",
    badgeColor: "teal",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M.632.55v22.9H2.28V24H0V0h2.28v.55zm7.043 7.26v1.157h.033c.309-.424.719-.77 1.227-1.04.509-.269 1.114-.404 1.816-.404.61 0 1.164.103 1.662.31.498.206.914.512 1.25.918.334.407.585.908.751 1.503.167.595.251 1.278.251 2.05v6.58h-2.585v-5.914c0-.49-.033-.925-.098-1.306a2.2 2.2 0 00-.361-.926 1.767 1.767 0 00-.738-.592 2.65 2.65 0 00-1.196-.245c-.413 0-.796.082-1.147.245a2.215 2.215 0 00-.869.691c-.24.3-.414.673-.522 1.121-.109.448-.163.957-.163 1.528v5.398H4.25V7.81h2.585v-.001h.84zm15.693 15.64V.55H21.72V0H24v24h-2.28v-.55z"/></svg>`
  },
  {
    platform: "Discord",
    address: "discord.gg/thepenguinsclub",
    protocol: "Voice & streaming",
    description: "Active voice channels for sprint hacking, screen shares, hardware troubleshooting, and a standing weekly coffee chat that's really just people talking.",
    members: "2,150 members",
    actionText: "Enter Discord Server",
    url: "https://discord.com",
    badgeColor: "berry",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>`
  },
  {
    platform: "Discourse Forum",
    address: "forum.thepenguinsclub.org",
    protocol: "Long-form threads",
    description: "For the stuff that shouldn't disappear in chat scroll. Propose changes, ask for project sponsorship, or write a distro guide that people can actually find later.",
    members: "3,800 topics",
    actionText: "Visit Forum",
    url: "#",
    badgeColor: "amber",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>`
  },
  {
    platform: "Libera IRC",
    address: "#thepenguinsclub",
    protocol: "Pure & minimalist",
    description: "For the purists who still love a terminal IRC client (irssi, weechat). Fast, lightweight, and bridged to our main Matrix channels.",
    members: "180 hackers",
    actionText: "Connect via IRC",
    url: "ircs://irc.libera.chat:6697/thepenguinsclub",
    badgeColor: "coral",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>`
  }
];
---

<section id="community" class="community-section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Always open</div>
      <h2 class="section-title">Find us where you already are</h2>
      <p class="section-desc">
        No walled gardens, no "sign up to see more." Drop into whichever of these feels most like home — federated Matrix, voice-first Discord, long-form forum threads, or classic IRC.
      </p>
    </div>

    <!-- Channels Grid -->
    <div class="channels-grid">
      {channels.map((chan) => (
        <div class="channel-card glass-card">
          <div class="chan-top">
            <div class="chan-icon" set:html={chan.icon} />
            <div class="chan-badge-wrap">
              <span class={`chan-badge badge-${chan.badgeColor}`}>{chan.protocol}</span>
            </div>
          </div>

          <h3 class="chan-name">{chan.platform}</h3>
          <div class="chan-address mono-accent">{chan.address}</div>
          <p class="chan-desc">{chan.description}</p>

          <div class="chan-footer">
            <span class="chan-members">
              <span class="pulse-dot"></span>
              {chan.members}
            </span>
            <a href={chan.url} target="_blank" rel="noopener" class="btn-primary chan-btn">
              {chan.actionText} &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Join / Newsletter Signup -->
    <div class="newsletter-card glass-card">
      <div class="newsletter-content">
        <span class="mono-accent">Stay in the loop</span>
        <h3 class="newsletter-title">Get event reminders, not spam</h3>
        <p class="newsletter-desc">
          A short, plain-text email whenever there's a meetup, hackathon, or project showcase worth knowing about. Nothing else. Zero tracking pixels.
        </p>
      </div>

      <form id="subscribe-form" class="newsletter-form" autocomplete="off">
        <div class="input-with-button">
          <input
            type="email"
            id="sub-email"
            placeholder="linus@kernel.org"
            required
            class="newsletter-input"
            aria-label="Email address"
          />
          <button type="submit" class="btn-primary sub-btn">
            Subscribe
          </button>
        </div>
        <div id="sub-success" class="sub-success-msg" style="display: none;">
          ✅ You're in! Check your inbox for confirmation.
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const subForm = document.getElementById('subscribe-form');
  const subSuccess = document.getElementById('sub-success');
  const subEmail = document.getElementById('sub-email') as HTMLInputElement | null;

  subForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (subSuccess && subEmail) {
      subSuccess.style.display = 'block';
      subEmail.value = '';
    }
  });
</script>

<style>
  .community-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .channels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .channels-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .channel-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  .chan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chan-icon {
    color: var(--text-accent);
  }

  .chan-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .badge-teal {
    background: rgba(31, 156, 130, 0.14);
    border: 1px solid rgba(31, 156, 130, 0.3);
    color: var(--text-accent-secondary);
  }

  .badge-berry {
    background: rgba(157, 111, 224, 0.14);
    border: 1px solid rgba(157, 111, 224, 0.3);
    color: var(--accent-berry);
  }

  .badge-amber {
    background: rgba(244, 185, 66, 0.18);
    border: 1px solid rgba(244, 185, 66, 0.35);
    color: var(--text-accent-warn);
  }

  .badge-coral {
    background: rgba(242, 100, 60, 0.14);
    border: 1px solid rgba(242, 100, 60, 0.3);
    color: var(--text-accent);
  }

  .chan-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .chan-address {
    font-size: 0.8125rem;
    word-break: break-all;
  }

  .chan-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .chan-footer {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .chan-members {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .chan-btn {
    width: 100%;
    font-size: 0.8125rem;
    padding: 0.65rem 0.9rem;
  }

  /* Newsletter card */
  .newsletter-card {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .newsletter-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .newsletter-content {
      max-width: 540px;
    }
  }

  .newsletter-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0.35rem 0 0.5rem;
  }

  .newsletter-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 320px;
  }

  .input-with-button {
    display: flex;
    gap: 0.5rem;
  }

  .newsletter-input {
    flex: 1;
    background: var(--bg-canvas);
    border: 1px solid var(--border-card);
    color: var(--text-primary);
    font-size: 0.9rem;
    padding: 0.75rem 0.95rem;
    border-radius: 9999px;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .newsletter-input:focus {
    border-color: var(--text-accent);
  }

  .sub-btn {
    white-space: nowrap;
    padding: 0.75rem 1.3rem;
  }

  .sub-success-msg {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-accent-secondary);
  }
</style>
