---
// What We Run - Core Programs & Educational Tracks
// Tinted bento grid, one illustration per program
// Content lives in src/data/programs.ts so this grid and /programs stay in sync.
import { featuredPrograms, art } from '../data/programs';

---

<section id="programs" class="programs-section">
  <div class="container">
    <div class="programs-header">
      <div class="header-content">
        <h2 class="section-title">What we run</h2>
        <p class="section-desc">
          Clubs meet monthly year-round. Campus workshops, installation fests, and upstream sprints run when a university department or partner signs on.
        </p>
      </div>

      <div class="header-action">
        <a href="/programs" class="btn-primary">
          All programs &rarr;
        </a>
        <a href="#get-involved" class="btn-secondary">
          Request a Campus Workshop &rarr;
        </a>
      </div>
    </div>

    <div class="bento">
      {featuredPrograms.map((prog, idx) => (
        <article class={`tile tone-${prog.tone} tile-${idx + 1}`}>
          <svg class="tile-art" viewBox="0 0 120 120" aria-hidden="true" set:html={art[prog.art]} />

          <div class="tile-body">
            <div class="tile-top">
              <span class="tile-badge">{prog.badge}</span>
              <span class="tile-tag">{prog.tag}</span>
            </div>

            <h3 class="tile-title">{prog.title}</h3>
            <p class="tile-summary">{prog.summary}</p>
            <p class="tile-details">{prog.details}</p>
          </div>

          <div class="tile-foot">
            <span class="tile-cadence"><b>Schedule</b>{prog.cadence}</span>
            <a href="#events" class="tile-link" aria-label={`View details: ${prog.title}`}>&rarr;</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .programs-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .programs-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  .header-action { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @media (min-width: 860px) {
    .programs-header { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .header-content { max-width: 620px; }
    .header-content .section-desc { margin-bottom: 0; }
  }

  /* Bento grid: 6 columns on desktop, 2 on tablet, 1 on mobile */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .tile-1 { grid-column: span 2; }
  }

  @media (min-width: 1080px) {
    .bento { grid-template-columns: repeat(6, 1fr); }
    .tile-1 { grid-column: span 4; }
    .tile-2 { grid-column: span 2; }
    .tile-3, .tile-4, .tile-5 { grid-column: span 2; }
  }

  /* Each tile sets its own palette; dark mode swaps to deep tints */
  .tile {
    --bg: var(--accent-green-subtle);
    --fg: #0f1a16;
    --art: #0f1a16;
    --art-soft: rgba(255, 255, 255, 0.55);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    min-height: 20rem;
    border-radius: var(--radius-xl);
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .tile:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }

  .tone-emerald { --bg: #0a7a5a; --fg: #ffffff; --art: #ffffff; --art-soft: rgba(255, 255, 255, 0.16); }
  .tone-lime    { --bg: #e3f98a; --art: #3f5a0b; }
  .tone-ink     { --bg: #0f1a16; --fg: #f1f5f3; --art: #34d399; --art-soft: rgba(52, 211, 153, 0.18); }
  .tone-coral   { --bg: #ff9d80; --art: #7a2410; --art-soft: rgba(255, 255, 255, 0.4); }
  .tone-sky     { --bg: #cfe6ff; --art: #1d5fa8; }

  :global([data-theme="dark"]) .tone-emerald { --bg: #0e5e47; }
  :global([data-theme="dark"]) .tone-lime    { --bg: #2c3410; --fg: #f1f8d0; --art: #d4f55a; --art-soft: rgba(212, 245, 90, 0.14); }
  :global([data-theme="dark"]) .tone-ink     { --bg: #1b2320; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12); }
  :global([data-theme="dark"]) .tone-coral   { --bg: #8a3a24; --fg: #fff1ec; --art: #ffd0c0; --art-soft: rgba(255, 255, 255, 0.12); }
  :global([data-theme="dark"]) .tone-sky     { --bg: #15304f; --fg: #e4f0ff; --art: #7bb8f5; --art-soft: rgba(123, 184, 245, 0.15); }

  .tile-art {
    position: absolute;
    right: 1.5rem;
    top: 4.25rem;
    width: 6rem;
    height: 6rem;
    opacity: 0.95;
    pointer-events: none;
  }

  .tile-1 .tile-art { width: 11rem; height: 11rem; right: 2rem; top: 50%; translate: 0 -50%; }

  .tile-body { display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }

  .tile-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 0.75rem; margin-bottom: 0.5rem; }

  .tile-badge {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--fg) 12%, transparent);
  }

  .tile-tag { font-family: var(--font-mono); font-size: 0.65rem; opacity: 0.65; text-align: right; }

  .tile-title {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    max-width: 18ch;
    margin-top: 6.75rem;
  }

  .tile-1 .tile-title { margin-top: 0.5rem; max-width: 22ch; }

  .tile-summary { font-size: 0.9rem; font-weight: 500; line-height: 1.5; max-width: 34ch; }
  .tile-1 .tile-summary { max-width: 44ch; }
  .tile-details { font-size: 0.825rem; line-height: 1.55; opacity: 0.75; max-width: 40ch; }
  .tile-1 .tile-details { max-width: 48ch; }

  .tile-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
  }

  .tile-cadence { font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.4; display: flex; flex-direction: column; gap: 0.2rem; }
  .tile-cadence b { font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.6; }

  .tile-link {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--fg);
    color: var(--bg);
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }

  .tile-link:hover { transform: translateX(3px); }
  .tile-link:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }

  @media (max-width: 699px) {
    .tile-art, .tile-1 .tile-art { width: 6rem; height: 6rem; top: 4rem; right: 1.25rem; translate: none; }
    .tile-title, .tile-1 .tile-title { margin-top: 6rem; max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile, .tile-link { transition: none; }
    .tile:hover { transform: none; }
  }
</style>
