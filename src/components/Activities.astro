---
// Activities Bento Grid Component covering the 5 core activities
const activities = [
  {
    id: "act-awareness",
    tag: "Awareness & Education",
    title: "Linux & FOSS Awareness",
    description: "Demystifying GNU/Linux distributions, open standards, software licensing, and digital sovereignty. We run installation fests and friendly explainer sessions for total newcomers and seasoned pros alike.",
    highlights: ["Distro Installation Fests", "Open Standards & Privacy", "Digital Sovereignty Talks", "Campus Outreach"],
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
    color: "coral"
  },
  {
    id: "act-meetups",
    tag: "Community & Talks",
    title: "In-Person & Virtual Meetups",
    description: "Monthly gatherings featuring lightning talks, live coding, and casual hallway-track chats. Whether in a local hacker space or over a stream, we share what we know, freely and without gatekeeping.",
    highlights: ["Monthly Keynotes", "5-Minute Lightning Talks", "Kernel & Sysadmin Chats", "Live Streams"],
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    color: "teal"
  },
  {
    id: "act-hackathons",
    tag: "Sprints & Hacking",
    title: "Open Source Hackathons",
    description: "Fast-paced 48-hour sprints focused on shipping usable Free Software — desktop tools, web apps, and squashing long-standing upstream bugs. Mentors around the clock, snacks included.",
    highlights: ["48h Sprint Hackathons", "Upstream Bug Hunts", "Zero-to-One Projects", "Prizes & Hardware Grants"],
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline><circle cx="12" cy="12" r="2"></circle></svg>`,
    color: "amber"
  },
  {
    id: "act-discussions",
    tag: "Collaboration & Forums",
    title: "Online Discussions & Forums",
    description: "Always-on spaces across Matrix, Discord, Discourse, and IRC. Talk kernels and Wayland, or just ask a beginner question — someone friendly is almost always around.",
    highlights: ["Matrix & IRC, Bridged", "Discourse Forum", "Async RFCs", "Peer Help Desks"],
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>`,
    color: "berry"
  },
  {
    id: "act-projects",
    tag: "Incubation & Code",
    title: "Fostering Open Source Projects",
    description: "We don't just talk about FOSS, we write code. We pair first-time contributors with mentors, sponsor infrastructure, help with packaging, and cheer projects on until they find their own community.",
    highlights: ["Maintainer Pairing", "Infrastructure Sponsorship", "CI/CD & Packaging Help", "Project Showcase Stage"],
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`,
    color: "coral"
  }
];
---

<section id="activities" class="activities-section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">What we get up to</div>
      <h2 class="section-title">Five ways to get involved</h2>
      <p class="section-desc">
        No single "right" way to join in. Come to learn, come to teach, come to build something — our five pillars all lead to the same place: a community that actually shows up for each other.
      </p>
    </div>

    <!-- Activities Bento Grid -->
    <div class="bento-grid">
      {activities.map((act, index) => (
        <div class={`bento-card glass-card card-${index + 1}`}>
          <div class="card-top">
            <div class={`card-icon-wrap icon-${act.color}`} set:html={act.icon} />
            <span class="card-tag-text">{act.tag}</span>
          </div>

          <h3 class="card-title">{act.title}</h3>
          <p class="card-desc">{act.description}</p>

          <div class="card-highlights">
            {act.highlights.map(item => (
              <span class="highlight-chip">
                <span class="chip-dot"></span>
                {item}
              </span>
            ))}
          </div>

          <div class="card-footer-link">
            <span class="mono-accent learn-more">Explore this pillar <span class="arrow">&rarr;</span></span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .activities-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Bento Grid Layout */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .card-5 {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .card-1 {
      grid-column: span 2;
    }
    .card-5 {
      grid-column: span 1;
    }
  }

  .bento-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .card-tag-text {
    font-size: 0.775rem;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .card-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-coral { background: color-mix(in srgb, var(--accent-coral) 14%, transparent); color: var(--accent-coral); }
  .icon-teal { background: color-mix(in srgb, var(--accent-teal) 14%, transparent); color: var(--accent-teal); }
  .icon-amber { background: color-mix(in srgb, var(--accent-amber) 18%, transparent); color: var(--accent-amber); }
  .icon-berry { background: color-mix(in srgb, var(--accent-berry) 14%, transparent); color: var(--accent-berry); }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .card-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .card-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    margin-bottom: 1.5rem;
  }

  .highlight-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    font-size: 0.775rem;
    color: var(--text-secondary);
  }

  .chip-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--text-accent);
  }

  .card-footer-link {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .learn-more {
    font-size: 0.8125rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .bento-card:hover .arrow {
    transform: translateX(4px);
  }
</style>
