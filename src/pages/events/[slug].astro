<!-- Client Script for Calendar .ics generation & URL Sharing -->
<script>
  function initEventPageInteractions() {
    // Calendar Download Buttons
    const calButtons = document.querySelectorAll<HTMLButtonElement>('.btn-cal-action');
    calButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-cal-title') || 'The Penguins Club Meetup';
        const desc = btn.getAttribute('data-cal-desc') || 'Community Linux Workshop';
        const loc = btn.getAttribute('data-cal-loc') || 'Dhaka, Bangladesh';
        const start = btn.getAttribute('data-cal-start') || '20261017T090000Z';
        const end = btn.getAttribute('data-cal-end') || '20261017T120000Z';

        const icsContent = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//The Penguins Club//Meetups//EN',
          'CALSCALE:GREGORIAN',
          'METHOD:PUBLISH',
          'BEGIN:VEVENT',
          `UID:${Date.now()}@thepenguins.club`,
          `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0]}Z`,
          `DTSTART:${start}`,
          `DTEND:${end}`,
          `SUMMARY:${title}`,
          `DESCRIPTION:${desc.replace(/\n/g, '\\n')}`,
          `LOCATION:${loc}`,
          'STATUS:CONFIRMED',
          'END:VEVENT',
          'END:VCALENDAR'
        ].join('\r\n');

        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${title.toLowerCase().replace(/[^a-z0-9]/g, '-')}.ics`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    });

    // Share Button
    const shareBtn = document.getElementById('share-event-btn');
    const shareText = document.getElementById('share-btn-text');
    if (shareBtn && shareText) {
      shareBtn.addEventListener('click', async () => {
        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(window.location.href);
            const original = shareText.textContent;
            shareText.textContent = 'Link Copied!';
            shareBtn.style.borderColor = 'var(--accent-green)';
            setTimeout(() => {
              shareText.textContent = original;
              shareBtn.style.borderColor = '';
            }, 2500);
          }
        } catch {
          // fallback
        }
      });
    }

    // Live Countdown Timer
    function updateCountdowns() {
      const now = Date.now();
      const elements = document.querySelectorAll<HTMLElement>('[data-start-iso]');
      elements.forEach((el) => {
        const startStr = el.getAttribute('data-start-iso');
        const endStr = el.getAttribute('data-end-iso');
        if (!startStr) return;

        const startTime = new Date(startStr).getTime();
        const endTime = endStr ? new Date(endStr).getTime() : startTime + 4 * 3600 * 1000;
        const diff = startTime - now;

        const daysEl = el.querySelector<HTMLElement>('[data-unit="days"]');
        const hoursEl = el.querySelector<HTMLElement>('[data-unit="hours"]');
        const minsEl = el.querySelector<HTMLElement>('[data-unit="minutes"]');
        const secsEl = el.querySelector<HTMLElement>('[data-unit="seconds"]');
        const clockBox = el.querySelector<HTMLElement>('[data-countdown-container]');
        const liveNotice = el.querySelector<HTMLElement>('.countdown-live-notice');
        const sidebarTimer = el.querySelector<HTMLElement>('[data-sidebar-countdown]');

        if (diff > 0) {
          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
          const minutes = Math.floor((diff / (1000 * 60)) % 60);
          const seconds = Math.floor((diff / 1000) % 60);

          if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
          if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
          if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
          if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');

          if (clockBox) clockBox.style.display = 'flex';
          if (liveNotice) liveNotice.style.display = 'none';

          if (sidebarTimer) {
            sidebarTimer.textContent = `${days}d ${hours}h ${minutes}m ${seconds}s`;
          }
        } else if (now >= startTime && now <= endTime) {
          if (clockBox) clockBox.style.display = 'none';
          if (liveNotice) liveNotice.style.display = 'flex';
          if (sidebarTimer) sidebarTimer.textContent = '🔴 Happening Now!';
        } else {
          if (clockBox) clockBox.style.display = 'none';
          if (liveNotice) {
            liveNotice.style.display = 'flex';
            liveNotice.textContent = 'Event Concluded';
          }
          if (sidebarTimer) sidebarTimer.textContent = 'Event Concluded';
        }
      });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventPageInteractions);
  } else {
    initEventPageInteractions();
  }
</script>

