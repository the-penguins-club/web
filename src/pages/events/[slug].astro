---
import Layout from '../../layouts/Layout.astro';
import { getDynamicEvents, type CommunityEvent } from '../../data/events';
import { generateGoogleCalendarUrl } from '../../utils/ics';

export async function getStaticPaths() {
  const allEvents = await getDynamicEvents();
  return allEvents.map((event) => ({
    params: { slug: event.slug },
    props: { event }
  }));
}

interface Props {
  event: CommunityEvent;
}

const { event } = Astro.props;
const allEvents = await getDynamicEvents();
const otherEvents = allEvents.filter((e) => e.slug !== event.slug);
const googleCalUrl = generateGoogleCalendarUrl(event);
const dynamicIcsUrl = `/events/${event.slug}.ics`;
---

<Layout
  title={`${event.title} — The Penguins Club`}
  description={event.description}
>
  <div class={`event-detail-page ${event.isSuper ? 'is-super-page' : ''} theme-${event.theme}`}>
    <!-- Top Breadcrumbs & Back Navigation -->
    <div class="event-nav-banner">
      <div class="container">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/#events" class="back-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to All Meetups</span>
          </a>
          <span class="crumb-separator">/</span>
          <span class="crumb-current">{event.title}</span>
        </nav>
      </div>
    </div>

    <!-- Hero Header -->
    <header class="event-hero-section">
      <div class="container">
        <div class="hero-header-content">
          <!-- Super / Track Tag Pill -->
          <div class="hero-badges-row">
            {event.isSuper && (
              <span class="super-event-badge">
                <span class="pulse-dot"></span>
                <span>{event.superBadge || 'SUPER EVENT 🌿'}</span>
              </span>
            )}
            {event.theme === 'hacktoberfest' && (
              <span class="hacktoberfest-badge">
                <span>🎃 HACKTOBERFEST 2026 SPECIAL</span>
              </span>
            )}
            <span class="track-tag-pill">{event.trackTag}</span>
            <span class="venue-type-pill venue-{event.venueType}">
              {event.venueType === 'outdoor' && '🌿 Open-Air Park'}
              {event.venueType === 'hybrid' && '🌐 In-Person + Stream'}
              {event.venueType === 'in-person' && '🏢 In-Person Lab'}
              {event.venueType === 'virtual' && '💻 Virtual Meetup'}
            </span>
          </div>

          <h1 class="event-hero-title">{event.title}</h1>
          <p class="event-hero-summary">{event.description}</p>

          <!-- Key Meta Strip -->
          <div class="event-meta-strip">
            <div class="meta-item">
              <div class="meta-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </div>
              <div class="meta-text-wrap">
                <span class="meta-label">Date &amp; Time</span>
                <span class="meta-val">{event.timeString}</span>
              </div>
            </div>

            <div class="meta-item">
              <div class="meta-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="meta-text-wrap">
                <span class="meta-label">Location</span>
                <span class="meta-val">{event.location}</span>
              </div>
            </div>

            <div class="meta-item">
              <div class="meta-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              </div>
              <div class="meta-text-wrap">
                <span class="meta-label">Admission</span>
                <span class="meta-val highlight-free">100% Free &bull; Open to All</span>
              </div>
            </div>
          </div>

          <!-- Live Countdown Timer Banner -->
          <div class="event-countdown-banner" data-start-iso={event.startDateIso} data-end-iso={event.endDateIso}>
            <div class="countdown-header-line">
              <div class="countdown-badge-title">
                <span class="countdown-pulse-ring"></span>
                <span class="countdown-title-text">COUNTDOWN TO GATHERING</span>
              </div>
              <span class="countdown-timezone-tag">BST (UTC+6) &bull; Live Real-Time Ticker</span>
            </div>

            <div class="countdown-timer-display" data-countdown-container>
              <div class="countdown-time-block">
                <span class="time-num" data-unit="days">--</span>
                <span class="time-label">DAYS</span>
              </div>
              <span class="time-colon">:</span>
              <div class="countdown-time-block">
                <span class="time-num" data-unit="hours">--</span>
                <span class="time-label">HOURS</span>
              </div>
              <span class="time-colon">:</span>
              <div class="countdown-time-block">
                <span class="time-num" data-unit="minutes">--</span>
                <span class="time-label">MINUTES</span>
              </div>
              <span class="time-colon">:</span>
              <div class="countdown-time-block">
                <span class="time-num" data-unit="seconds">--</span>
                <span class="time-label">SECONDS</span>
              </div>
            </div>

            <div class="countdown-live-notice" style="display: none;">
              <span class="live-beacon"></span>
              <span>EVENT IS LIVE NOW &bull; JOIN TELEGRAM STREAM OR ON-SITE!</span>
            </div>
          </div>

          <!-- Hero Action Buttons -->
          <div class="hero-actions-row">
            <a
              href={event.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary hero-rsvp-btn"
            >
              <span>Attend via Telegram</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <a
              href={dynamicIcsUrl}
              download={`${event.slug}.ics`}
              class="btn-secondary hero-cal-btn"
              title="Download dynamic RFC 5545 iCalendar file"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download .ics</span>
            </a>

            <a
              href={googleCalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary hero-cal-btn"
              title="Add directly to Google Calendar"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Google Calendar</span>
            </a>

            <button
              type="button"
              class="btn-secondary hero-share-btn"
              id="share-event-btn"
              title="Copy event link"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span id="share-btn-text">Share Event</span>
            </button>
          </div>
        </div>

        <!-- Banner Visual Card -->
        <div class="event-banner-showcase">
          <div class="banner-frame">
            <img
              src={event.image}
              alt={event.title}
              class="banner-graphic-img"
            />
            <div class="banner-date-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>{event.dateBadge}</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content & Sidebar Grid -->
    <section class="event-main-content">
      <div class="container">
        <div class="content-layout-grid">
          <!-- Left / Main Stream -->
          <div class="main-stream">
            <!-- Event Overview Section -->
            <article class="content-card overview-card">
              <div class="card-header-row">
                <span class="card-icon-pill">📖</span>
                <h2 class="card-section-title">About This Event</h2>
              </div>
              <div class="overview-body prose">
                {event.fullOverview.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </article>

            <!-- Highlights Section -->
            <article class="content-card highlights-card">
              <div class="card-header-row">
                <span class="card-icon-pill">✨</span>
                <h2 class="card-section-title">Key Highlights &amp; Activities</h2>
              </div>
              <ul class="highlights-grid">
                {event.highlights.map((item) => (
                  <li class="highlight-item-card">
                    <span class="highlight-bullet">&bull;</span>
                    <p class="highlight-text">{item}</p>
                  </li>
                ))}
              </ul>
            </article>

            <!-- Schedule / Agenda Timeline -->
            <article class="content-card agenda-card">
              <div class="card-header-row">
                <span class="card-icon-pill">⏱️</span>
                <div>
                  <h2 class="card-section-title">Event Schedule &amp; Agenda</h2>
                  <p class="card-section-desc">Timeline and sessions for the day (BST Dhaka Time)</p>
                </div>
              </div>
              <div class="agenda-timeline">
                {event.agenda.map((slot, index) => (
                  <div class="timeline-slot">
                    <div class="slot-marker-col">
                      <div class="slot-marker-dot"></div>
                      {index < event.agenda.length - 1 && <div class="slot-marker-line"></div>}
                    </div>
                    <div class="slot-content">
                      <div class="slot-time-badge">{slot.time}</div>
                      <h3 class="slot-title">{slot.title}</h3>
                      {slot.speaker && (
                        <div class="slot-speaker-pill">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                          </svg>
                          <span>{slot.speaker}</span>
                        </div>
                      )}
                      {slot.description && (
                        <p class="slot-desc">{slot.description}</p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </article>

            <!-- Prerequisites & What to Bring Dual Grid -->
            <div class="dual-info-grid">
              <article class="content-card sub-card">
                <div class="card-header-row">
                  <span class="card-icon-pill">🧠</span>
                  <h2 class="card-section-title">Prerequisites</h2>
                </div>
                <ul class="checklist-items">
                  {event.prerequisites.map((req) => (
                    <li>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{req}</span>
                    </li>
                  ))}
                </ul>
              </article>

              <article class="content-card sub-card">
                <div class="card-header-row">
                  <span class="card-icon-pill">🎒</span>
                  <h2 class="card-section-title">What to Bring</h2>
                </div>
                <ul class="checklist-items">
                  {event.whatToBring.map((item) => (
                    <li>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            </div>

            <!-- Speakers & Mentors -->
            {event.speakers && event.speakers.length > 0 && (
              <article class="content-card speakers-card">
                <div class="card-header-row">
                  <span class="card-icon-pill">👥</span>
                  <h2 class="card-section-title">Facilitators &amp; Hosts</h2>
                </div>
                <div class="speakers-list-grid">
                  {event.speakers.map((spk) => (
                    <div class="speaker-profile-card">
                      <div class="speaker-avatar-wrap">
                        <img src={spk.avatar || '/favicon.svg'} alt={spk.name} class="speaker-img" />
                      </div>
                      <div class="speaker-details">
                        <h3 class="speaker-name">{spk.name}</h3>
                        <div class="speaker-role">{spk.role}</div>
                        {spk.bio && <p class="speaker-bio">{spk.bio}</p>}
                        {spk.github && (
                          <a
                            href={`https://github.com/${spk.github}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="speaker-gh-link"
                          >
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                            </svg>
                            <span>github.com/{spk.github}</span>
                          </a>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </article>
            )}

            <!-- FAQ Section -->
            {event.faqs && event.faqs.length > 0 && (
              <article class="content-card faq-card">
                <div class="card-header-row">
                  <span class="card-icon-pill">❓</span>
                  <h2 class="card-section-title">Frequently Asked Questions</h2>
                </div>
                <div class="faq-list">
                  {event.faqs.map((faq) => (
                    <details class="faq-accordion-item">
                      <summary class="faq-question">
                        <span>{faq.question}</span>
                        <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </summary>
                      <div class="faq-answer">
                        <p>{faq.answer}</p>
                      </div>
                    </details>
                  ))}
                </div>
              </article>
            )}
          </div>

          <!-- Right / Sticky Sidebar -->
          <aside class="sidebar-stream">
            <!-- Fast Info Card -->
            <div class="sticky-sidebar-card">
              <div class="sidebar-header-row">
                <span class="sidebar-card-badge">EVENT SUMMARY</span>
                <span class="sidebar-free-pill">100% FREE</span>
              </div>
              <h3 class="sidebar-card-title">{event.title}</h3>

              <div class="sidebar-info-block">
                <div class="sidebar-info-row">
                  <span class="sidebar-info-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span>Date</span>
                  </span>
                  <span class="sidebar-info-val">{event.dateBadge}</span>
                </div>

                <div class="sidebar-info-row">
                  <span class="sidebar-info-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Timing</span>
                  </span>
                  <span class="sidebar-info-val">{event.timeString}</span>
                </div>

                <div class="sidebar-info-row">
                  <span class="sidebar-info-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>Venue</span>
                  </span>
                  <span class="sidebar-info-val">{event.venueName}</span>
                </div>

                <div class="sidebar-info-row address-row">
                  <span class="sidebar-info-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="12" y1="2" x2="12" y2="6"></line>
                      <line x1="12" y1="18" x2="12" y2="22"></line>
                      <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
                      <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
                      <line x1="2" y1="12" x2="6" y2="12"></line>
                      <line x1="18" y1="12" x2="22" y2="12"></line>
                      <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
                      <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
                    </svg>
                    <span>Address</span>
                  </span>
                  <span class="sidebar-info-val">{event.venueAddress}</span>
                </div>

                {event.capacity && (
                  <div class="sidebar-info-row">
                    <span class="sidebar-info-label">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                      </svg>
                      <span>Capacity</span>
                    </span>
                    <span class="sidebar-info-val">{event.capacity}</span>
                  </div>
                )}
              </div>

              <!-- Sidebar Countdown Box -->
              <div class="sidebar-timer-badge" data-start-iso={event.startDateIso} data-end-iso={event.endDateIso}>
                <div class="sidebar-timer-top">
                  <span class="sidebar-timer-pulse"></span>
                  <span class="sidebar-timer-heading">COUNTDOWN</span>
                </div>
                <div class="sidebar-timer-clock" data-sidebar-countdown>
                  Calculating...
                </div>
              </div>

              <!-- Sidebar Action Buttons -->
              <div class="sidebar-actions">
                <a
                  href={event.registrationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary sidebar-rsvp-btn"
                >
                  <span>Attend via Telegram</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>

                <div class="sidebar-cal-grid">
                  <a
                    href={dynamicIcsUrl}
                    download={`${event.slug}.ics`}
                    class="btn-secondary sidebar-cal-btn"
                    title="Download dynamic RFC 5545 iCalendar file"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>.ics file</span>
                  </a>

                  <a
                    href={googleCalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary sidebar-cal-btn"
                    title="Add directly to Google Calendar"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span>Google Cal</span>
                  </a>
                </div>
              </div>

              <div class="sidebar-guarantee-note">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Zero spam, zero registration fees. 100% community-driven.</span>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Full-Width Explore Other Upcoming Meetups Section -->
    {otherEvents.length > 0 && (
      <section class="other-events-section">
        <div class="container">
          <div class="other-events-header">
            <span class="other-kicker">COMMUNITY CALENDAR</span>
            <h2 class="other-events-main-title">Explore Other Upcoming Meetups</h2>
            <p class="other-events-desc">Join our monthly hands-on workshops, talks, and open-source hackathons across Dhaka.</p>
          </div>

          <div class="other-events-grid">
            {otherEvents.map((oe) => (
