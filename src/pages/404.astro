---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — The Penguins Club"
  description="This page doesn't exist. Find upcoming meetups, programs and blog posts from The Penguins Club."
  noindex
>
  <section class="not-found container">
    <p class="section-tag">404</p>
    <h1 class="section-title">This page doesn't exist</h1>
    <p class="section-desc">
      The link may be old, or the page may have moved. Everything we run is reachable from here:
    </p>
    <div class="actions">
      <a href="/" class="btn-primary">Go to the homepage</a>
      <a href="/events/" class="btn-secondary">See upcoming meetups</a>
      <a href="/programs/" class="btn-secondary">Browse programs</a>
      <a href="/blog/" class="btn-secondary">Read the blog</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
