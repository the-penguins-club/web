---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MeetupGallery from '../components/MeetupGallery.astro';
import CommunityMetrics from '../components/CommunityMetrics.astro';
import CommunityPeople from '../components/CommunityPeople.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Activities from '../components/Activities.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import GetInvolved from '../components/GetInvolved.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import CommunityDiscussions from '../components/CommunityDiscussions.astro';
import AwarenessManifesto from '../components/AwarenessManifesto.astro';
import { organization } from '../data/organization';

const jsonLd = [
  { '@context': 'https://schema.org', ...organization },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'The Penguins Club',
    url: 'https://thepenguins.club/',
    publisher: { '@id': organization['@id'] }
  }
];
---

<Layout
  title="The Penguins Club — Free Linux & Open Source Workshops in Bangladesh"
  description="A volunteer-run Linux and open source charity in Bangladesh, going since 2020. Free monthly workshops, local package mirrors, and printed booklets we give away."
  jsonLd={jsonLd}
>
  <Hero />
  <MeetupGallery />
  <UpcomingEvents />
  <CommunityMetrics />
  <CommunityPeople />
  <Activities />
  <GetInvolved />
  <BlogTeaser />
  <ProjectsShowcase />
  <CommunityDiscussions />
  <AwarenessManifesto />
</Layout>
