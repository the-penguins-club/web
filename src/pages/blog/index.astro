---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Blog — The Penguins Club" description="Meetup recaps, workshop notes, and write-ups from The Penguins Club community.">
  <main class="blog-index container">
    <h1>Blog</h1>
    <p class="blog-intro">Meetup recaps, workshop notes, and things our community has learned.</p>

    {posts.length === 0 && <p>No posts yet.</p>}
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`} class="post-card">
            {p.data.cover && <img src={p.data.cover} alt="" loading="lazy" />}
            <div>
              <h2>{p.data.title}</h2>
              <p class="post-meta">{fmt(p.data.date)} by {p.data.author}</p>
              <p>{p.data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .blog-index { padding-block: 4rem 5rem; max-width: 820px; }
  h1 { font-family: var(--font-display); font-size: clamp(2.25rem, 4vw, 3rem); letter-spacing: -0.02em; }
  .blog-intro { color: var(--text-secondary); margin: 0.5rem 0 2.5rem; }
  .post-list { list-style: none; display: grid; gap: 1rem; }
  .post-card {
    display: grid; gap: 1.25rem; padding: 1.25rem 1.5rem;
    background: var(--bg-card); border: 1px solid var(--border-card); border-radius: var(--radius-md);
  }
  .post-card:has(img) { grid-template-columns: 180px 1fr; }
  .post-card:hover { border-color: var(--accent-primary); }
  .post-card img { width: 100%; height: 100%; max-height: 130px; object-fit: cover; border-radius: var(--radius-sm); }
  h2 { font-family: var(--font-display); font-size: 1.4rem; margin-bottom: 0.25rem; }
  .post-meta { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; }
  @media (max-width: 600px) { .post-card:has(img) { grid-template-columns: 1fr; } }
</style>
