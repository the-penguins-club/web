---
import Layout from '../../layouts/Layout.astro';
import PostCover from '../../components/PostCover.astro';
import { getCollection } from 'astro:content';
import { fmtDate, readingTime } from '../../utils/blog';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const [latest, ...rest] = posts;
---

<Layout title="Blog — The Penguins Club" description="Meetup recaps, workshop notes, and write-ups from The Penguins Club community.">
  <main class="blog-index container">
    <header class="head">
      <h1>Blog</h1>
      <p class="blog-intro">Meetup recaps, workshop notes, and things our community has learned.</p>
      <a class="write" href="/blog/welcome-to-the-penguins-club-blog#want-to-write-something">Write for us &rarr;</a>
    </header>

    {posts.length === 0 && <p>No posts yet.</p>}

    {latest && (
      <a href={`/blog/${latest.id}`} class="latest">
        <PostCover title={latest.data.title} cover={latest.data.cover} label={latest.data.tags[0] ?? 'blog'} />
        <div class="latest-body">
          <p class="eyebrow">Latest</p>
          <h2>{latest.data.title}</h2>
          <p class="summary">{latest.data.summary}</p>
          <p class="post-meta">{fmtDate(latest.data.date)} · {latest.data.author} · {readingTime(latest.body)}</p>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <ul class="post-list">
        {rest.map((p) => (
          <li>
            <a href={`/blog/${p.id}`} class="post-card">
              <PostCover title={p.data.title} cover={p.data.cover} label={p.data.tags[0] ?? 'blog'} />
              <h2>{p.data.title}</h2>
              <p class="summary">{p.data.summary}</p>
              <p class="post-meta">{fmtDate(p.data.date)} · {readingTime(p.body)}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>

<style>
  .blog-index { padding-block: 4rem 5rem; max-width: 1040px; }
  .head { display: grid; gap: 0.5rem; margin-bottom: 2.5rem; }
  h1 { font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 3.5rem); letter-spacing: -0.03em; line-height: 1.05; }
  .blog-intro { color: var(--text-secondary); max-width: 52ch; }
  .write { color: var(--accent-primary); font-weight: 600; justify-self: start; margin-top: 0.25rem; }

  .latest, .post-card { display: grid; gap: 1.25rem; color: inherit; }
  .latest {
    grid-template-columns: 1fr; align-items: center; padding: 0.75rem; margin-bottom: 2.5rem;
    background: var(--bg-card); border: 1px solid var(--border-card); border-radius: var(--radius-xl);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .latest-body { padding: 0.5rem 0.75rem 1rem; }
  @media (min-width: 800px) { .latest { grid-template-columns: 1.2fr 1fr; gap: 2rem; } .latest-body { padding: 1rem 1.5rem 1rem 0; } }
  .latest:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
  .eyebrow { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 0.6rem; }
  .latest h2 { font-size: clamp(1.6rem, 3vw, 2.25rem); line-height: 1.15; }

  .post-list { list-style: none; display: grid; gap: 2.5rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .post-card { align-content: start; gap: 0.75rem; }
  .post-card :global(.cover) { transition: transform 0.2s ease; }
  .post-card:hover :global(.cover) { transform: translateY(-3px); }
  .post-card:hover h2 { color: var(--accent-primary); }

  h2 { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.25; letter-spacing: -0.01em; transition: color 0.15s ease; }
  .summary { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.55; }
  .post-meta { font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono); }

  @media (prefers-reduced-motion: reduce) { .latest, .post-card :global(.cover) { transition: none; } .latest:hover, .post-card:hover :global(.cover) { transform: none; } }
</style>
