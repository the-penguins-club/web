---
import Layout from '../../layouts/Layout.astro';
import {
  facts,
  contact,
  inScope,
  outOfScope,
  nonQualifying,
  rewards,
  responseTargets,
  rulesDo,
  rulesDont,
  paymentMethods,
  changelog,
  thanks,
  totalPaidBdt,
  researchersPaid,
  policy,
  numberWord,
  capitalise,
  faqs,
  fmtDate,
  fmtBdt,
  monthsRunning,
  humanDuration,
} from '../../data/bounty';

const months = monthsRunning(facts.launchedIso);
const age = humanDuration(months);
const launched = fmtDate(facts.launchedIso);
const updated = fmtDate(facts.updatedIso);
const topReward = Math.max(...inScope.map((a) => a.maxBdt));
const paidBands = rewards.filter((r) => r.bdt !== null).map((r) => r.bdt as number);
const floorReward = Math.min(...paidBands);
const rewardRange = `${fmtBdt(floorReward)} – ${fmtBdt(topReward)}`;
const assetCount = numberWord(inScope.length);
const firstReply = `Within ${policy.firstReplyWorkingDays} working days`;
// Revisions since launch: the changelog's oldest entry is the launch itself.
const revisions = numberWord(Math.max(0, changelog.length - 1));

const summaryRows = [
  { label: 'Launched', value: launched },
  { label: 'Running for', value: age },
  { label: 'Rewards', value: rewardRange },
  { label: 'First reply', value: firstReply },
  { label: 'Safe harbour', value: 'Yes — see below' },
  { label: 'Last updated', value: updated },
];
---

<Layout
  title="Bug Bounty Program — The Penguins Club"
  description={`A paid bug bounty program for the infrastructure The Penguins Club runs for its community. Running since ${launched}. Rewards from ${fmtBdt(floorReward)} to ${fmtBdt(topReward)}, paid from the community fund.`}
>
  <main class="bounty">
    <header class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/programs">Programs</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Bug Bounty</span>
        </nav>

        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>PAID PROGRAM</span>
        </div>

        <h1 class="hero-title">Bug Bounty Program</h1>

        <p class="hero-sub">
          We run a package mirror, a few bots, and a handful of services that students around
          Bangladesh rely on. If you can break one of them, tell us. We'd rather hear it from you
          than find out the hard way, and we'll pay you for the trouble.
        </p>

        <div class="hero-actions">
          <a href={`mailto:${contact.email}?subject=Vulnerability%20report`} class="btn-primary">
            Report a vulnerability &rarr;
          </a>
          <a href="#scope" class="btn-secondary">Read the scope</a>
        </div>

        <dl class="hero-facts">
          <div>
            <dt>Running for</dt>
            <dd>{age}</dd>
          </div>
          <div>
            <dt>Rewards</dt>
            <dd>{rewardRange}</dd>
          </div>
          <div>
            <dt>First reply</dt>
            <dd>{firstReply}</dd>
          </div>
        </dl>
      </div>
    </header>

    <section class="stats" aria-label="Program totals">
      <div class="container">
        <ul class="stats-grid">
          <li class="glass-card">
            <span class="stat-num">{facts.reportsResolved}</span>
            <span class="stat-label">Reports resolved</span>
            <span class="stat-detail">Since the program opened</span>
          </li>
          <li class="glass-card">
            <span class="stat-num">{fmtBdt(totalPaidBdt)}</span>
            <span class="stat-label">Paid out</span>
            <span class="stat-detail">From the community fund</span>
          </li>
          <li class="glass-card">
            <span class="stat-num">{researchersPaid}</span>
            <span class="stat-label">Researchers paid</span>
            <span class="stat-detail">Named below, where they wanted to be</span>
          </li>
          <li class="glass-card">
            <span class="stat-num">{facts.medianFirstResponseDays} days</span>
            <span class="stat-label">Median first reply</span>
            <span class="stat-detail">A person, not an auto-responder</span>
          </li>
        </ul>
      </div>
    </section>

    <div class="container body-grid">
      <article class="body">
        <section class="block" id="about">
          <h2 class="block-title">What this is</h2>
          <p class="lede">
            This is a small bug bounty program and we run it ourselves. No platform sits in
            between. You email us, a volunteer reads it, and we sort it out from there.
          </p>
          <p>
            The rewards won't change anyone's life. They come out of the same pot that prints our
            booklets and pays the mirror's bandwidth bill, so they're modest by necessity rather
            than by choice. What we can promise is that the money is real, the timelines below are
            ones we keep, and a person will write back to you.
          </p>
          <p>
            We opened this program on {facts.launchedOccasion ? `${facts.launchedOccasion}, ` : ''}
            <strong>{launched}</strong>. Scope and rewards have shifted {revisions} times since
            then, and the <a href="#changelog">changelog</a> has all of it.
          </p>
        </section>

        <section class="block" id="scope">
          <h2 class="block-title">What is in scope</h2>
          <p>
            {capitalise(assetCount)} things. Anything outside this list falls outside the program,
            though we'd still like to know about it.
          </p>

          <ul class="scope-list">
            {inScope.map((a) => (
              <li class="scope-item glass-card">
                <div class="scope-head">
                  <code class="scope-asset">{a.asset}</code>
                  <span class="scope-max">up to {fmtBdt(a.maxBdt)}</span>
                </div>
                <span class="scope-kind">{a.kind}</span>
                <p class="scope-note">{a.note}</p>
              </li>
            ))}
          </ul>

          <div class="callout callout-note">
            <h3>One deliberate quirk worth knowing</h3>
            <p>
              Our content admin at <code>/keystatic</code> only loads while the dev server is
              running, and never gets built into production. That's deliberate, because it has no
              authentication on it at all. If you ever find it reachable on the live site, that's a
              valid <strong>High</strong> and we'd very much like that email.
            </p>
          </div>

          <h3 class="block-sub">Explicitly out of scope</h3>
          <ul class="plain-list">
            {outOfScope.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="block" id="rewards">
          <h2 class="block-title">Rewards</h2>
          <p>
            Paid in Bangladeshi Taka. We pick the band, but we'll show our working, and you're
            welcome to argue. More than once we've moved a report up after the reporter made a
            better case than ours.
          </p>

          <div class="table-wrap">
            <table class="rewards-table">
              <thead>
                <tr>
                  <th scope="col">Severity</th>
                  <th scope="col">Reward</th>
                  <th scope="col">What it means</th>
                </tr>
              </thead>
              <tbody>
                {rewards.map((r) => (
                  <tr>
                    <th scope="row" data-label="Severity">
                      <span class={`sev sev-${r.tone}`}>{r.severity}</span>
                    </th>
                    <td data-label="Reward">
                      <span class="amount">{r.bdt === null ? 'Swag + credit' : fmtBdt(r.bdt)}</span>
                    </td>
                    <td data-label="What it means">
                      <p class="sev-meaning">{r.meaning}</p>
                      <p class="sev-example"><b>For example:</b> {r.example}</p>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 class="block-sub">How payment actually works</h3>
          <ul class="plain-list">
            <li>
              One reward per root cause. Five symptoms of the same bug is still one bug, and we'll
              explain why we've counted it that way.
            </li>
            <li>
              The first reproducible report gets the reward. Duplicates get credit, and we'll tell
              you when the original came in.
            </li>
            <li>
              Paid within <strong>{policy.payoutDays} days</strong> of us accepting the report, once
              you've sent payment details. There's no invoice to raise and nothing to sign.
            </li>
            <li>Any tax owed on the reward is yours to handle, wherever you live.</li>
            <li>
              Volunteers who help run our infrastructure can't claim rewards on the things they
              maintain. They still get credit.
            </li>
          </ul>

          <h3 class="block-sub">We can pay by</h3>
          <p>
            Whichever suits you. Tell us when we accept the report. We won't push you towards one
            method or ask for more detail than that method needs.
          </p>
          <ul class="chips">
            {paymentMethods.map((m) => <li class="chip">{m}</li>)}
          </ul>
        </section>

        <section class="block" id="report">
          <h2 class="block-title">How to report</h2>
          <p>
            Email <a href={`mailto:${contact.email}`}>{contact.email}</a>. That's the whole process.
            If {numberWord(policy.firstReplyWorkingDays)} working days go by with no reply, nudge
            {' '}<a href={`mailto:${contact.fallback}`}>{contact.fallback}</a>. Something will have
            gone wrong at our end, and we'd rather you chased us.
          </p>

          <div class="callout callout-pgp">
            <h3>PGP, if you want it</h3>
            <p>
              If it's sensitive, encrypt it with <a href={contact.pgpKeyUrl}>our public key</a>.
            </p>
            <p class="fingerprint">{contact.pgpFingerprint}</p>
          </div>

          <h3 class="block-sub">What to put in the email</h3>
          <ol class="steps">
            <li><b>Which asset.</b> One of the {assetCount} above, by name.</li>
            <li>
              <b>What you did.</b> Enough for us to reproduce it: a request, a script, the clicks
              you made and the order you made them in.
            </li>
            <li>
              <b>What happened.</b> The output or behaviour you saw, rather than what you concluded
              from it.
            </li>
            <li>
              <b>Why it matters.</b> What an attacker walks away with. This is the part that decides
              the band, so give it a couple of careful sentences.
            </li>
            <li><b>How you'd like to be credited.</b> A handle, your name, a link, or nothing.</li>
          </ol>

          <p class="aside">
            English or Bangla, whichever you'd rather. Neither will slow your report down.
          </p>
        </section>

        <section class="block" id="response">
          <h2 class="block-title">What happens next</h2>
          <p>
            Targets rather than guarantees. We publish them because researchers kept telling us the
            silence was the worst part of reporting to a small project.
          </p>
          <ol class="timeline">
            {responseTargets.map((t) => (
              <li class="timeline-item">
                <span class="timeline-dot" aria-hidden="true"></span>
                <div class="timeline-body">
                  <div class="timeline-head">
                    <h3>{t.stage}</h3>
                    <span class="timeline-target">{t.target}</span>
                  </div>
                  <p>{t.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="block" id="rules">
          <h2 class="block-title">Rules of engagement</h2>
          <div class="rules-grid">
            <div class="rules-col rules-do">
              <h3><span aria-hidden="true">✓</span> Please do</h3>
              <ul>{rulesDo.map((r) => <li>{r}</li>)}</ul>
            </div>
            <div class="rules-col rules-dont">
              <h3><span aria-hidden="true">✕</span> Please don't</h3>
              <ul>{rulesDont.map((r) => <li>{r}</li>)}</ul>
            </div>
          </div>
        </section>

        <section class="block" id="safe-harbour">
          <h2 class="block-title">Safe harbour</h2>
          <div class="callout callout-harbour">
            <p>
              Follow the rules above, act in good faith, and give us a fair chance to fix what you
              found, and we'll treat your research as authorised. We won't take legal action against
              you. We won't report you to anyone. And if someone else comes after you over research
              you did inside this scope, we'll say publicly and in writing that you had our
              permission.
            </p>
            <p>
              Bear in mind who's making that promise. We're volunteers, and we can't speak for our
              hosting providers or anyone else whose terms you might cross. Stay inside our scope;
              that's as far as our word reaches.
            </p>
            <p>
              Act in bad faith and none of it applies. By that we mean extortion, data theft,
              deliberate damage, or dragging someone else into it.
            </p>
          </div>
        </section>

        <section class="block" id="non-qualifying">
          <h2 class="block-title">Things we already know</h2>
          <p>
            These come up constantly and don't earn a reward on their own. Chain one into something
            real and it's a different conversation; we'll pay for the chain.
          </p>
          <ul class="plain-list tight">
            {nonQualifying.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="block" id="disclosure">
          <h2 class="block-title">Disclosure</h2>
          <p>
            Coordinated, and we lean towards publishing. Wait for the fix to ship or for
            {' '}{policy.disclosureDays} days to pass, whichever lands first, then write it up
            wherever you like. Tell us the date so we aren't caught out, and if you'd like us to
            check the technical details beforehand, just ask.
          </p>
          <p>
            Good write-ups help everyone, including the next community that inherits the same
            mistake. Send us the link when yours goes up and we'll put it beside your name below.
          </p>
        </section>

        <section class="block" id="thanks">
          <h2 class="block-title">Hall of thanks</h2>
          <p>
            People who made this safer for everyone else, newest first. Some reporters asked to stay
            anonymous, so this list runs shorter than the number of reports we've closed.
          </p>
          <ul class="thanks-list">
            {thanks.map((t) => (
              <li class="thanks-item">
                <span class="thanks-handle">{t.handle}</span>
                <span class="thanks-finding">{t.finding}</span>
                <span class={`sev sev-${t.band.toLowerCase()} thanks-band`}>{t.band}</span>
                <time class="thanks-date" datetime={t.dateIso}>{fmtDate(t.dateIso)}</time>
              </li>
            ))}
          </ul>
        </section>

        <section class="block" id="changelog">
          <h2 class="block-title">Rules changelog</h2>
          <p>
            Scope and rewards shift over time. We judge every report against the rules as they stood
            on the day you sent it.
          </p>
          <ul class="changelog">
            {changelog.map((c) => (
              <li class="changelog-item">
                <div class="changelog-meta">
                  <span class="changelog-version">v{c.version}</span>
                  <time datetime={c.dateIso}>{fmtDate(c.dateIso)}</time>
                </div>
                <p>{c.summary}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="block" id="faq">
          <h2 class="block-title">Questions we get asked</h2>
          <div class="faq">
            {faqs.map((f, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </article>

      <aside class="rail">
        <div class="rail-card">
          <div class="rail-head">
            <span class="rail-badge">PROGRAM SUMMARY</span>
            <span class="rail-live"><span class="pulse-dot"></span> Open</span>
          </div>

          <dl class="rail-rows">
            {summaryRows.map((row) => (
              <div class="rail-row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>

          <a
            href={`mailto:${contact.email}?subject=Vulnerability%20report`}
            class="btn-primary rail-cta"
          >
            {contact.email}
          </a>

          <nav class="rail-nav" aria-label="On this page">
            <a href="#scope">Scope</a>
            <a href="#rewards">Rewards</a>
            <a href="#report">How to report</a>
            <a href="#response">Response times</a>
            <a href="#rules">Rules</a>
            <a href="#safe-harbour">Safe harbour</a>
            <a href="#thanks">Hall of thanks</a>
            <a href="#changelog">Changelog</a>
          </nav>

          <p class="rail-foot">
            Not a security issue? Try
            {' '}<a href={`mailto:${contact.fallback}`}>{contact.fallback}</a>, or find us on Telegram.
          </p>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<style>
  .bounty { padding-bottom: 4rem; }

  /* Hero */
  .hero {
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .crumbs a:hover { color: var(--accent-primary); }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border-card);
    background: var(--bg-card);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-bottom: 1.1rem;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 0.9rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 62ch;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-card);
  }
  .hero-facts dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }
  .hero-facts dd { font-weight: 600; font-size: 0.95rem; color: var(--text-primary); }

  /* Stats */
  .stats { padding: clamp(2rem, 4vw, 3rem) 0; }
  .stats-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .stats-grid li { padding: 1.4rem; display: grid; gap: 0.3rem; }
  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent-primary);
    line-height: 1.1;
  }
  .stat-label { font-weight: 600; font-size: 0.9rem; }
  .stat-detail { font-size: 0.78rem; color: var(--text-muted); line-height: 1.45; }

  /* Layout */
  .body-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: start; }
  @media (min-width: 1000px) {
    .body-grid { grid-template-columns: minmax(0, 1fr) 20rem; gap: 3.5rem; }
  }

  .block { margin-bottom: clamp(2.75rem, 5vw, 4rem); scroll-margin-top: 6rem; }
  .block-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .block-sub {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.75rem;
  }
  .block p { color: var(--text-secondary); line-height: 1.7; margin-bottom: 0.9rem; max-width: 68ch; }
  .block p.lede { font-size: 1.08rem; color: var(--text-primary); font-weight: 500; }
  .block a { color: var(--accent-primary); font-weight: 600; }
  .block a:hover { text-decoration: underline; }
  .block strong, .block b { color: var(--text-primary); font-weight: 700; }
  .block code {
    font-size: 0.85em;
    padding: 0.12em 0.4em;
    border-radius: var(--radius-xs);
    background: var(--bg-elevated);
    color: var(--text-primary);
  }
  .aside { font-size: 0.9rem; color: var(--text-muted); }

  /* Scope */
  .scope-list { list-style: none; display: grid; gap: 0.85rem; margin: 1.5rem 0; }
  .scope-item { padding: 1.25rem; display: grid; gap: 0.45rem; }
  .scope-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .scope-asset {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    background: none;
    padding: 0;
    color: var(--text-primary);
  }
  .scope-max {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--accent-green-subtle);
    color: var(--accent-primary);
  }
  .scope-kind {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .scope-note { font-size: 0.9rem; line-height: 1.6; color: var(--text-secondary); margin: 0 !important; }

  /* Callouts */
  .callout {
    --callout-accent: var(--accent-primary);
    margin: 1.5rem 0;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-card);
    background: var(--bg-subtle);
  }
  .callout h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .callout h3::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--callout-accent);
  }
  .callout p { font-size: 0.92rem; margin-bottom: 0.6rem; }
  .callout p:last-child { margin-bottom: 0; }
  .callout-note { --callout-accent: var(--accent-amber); }
  .callout-pgp { --callout-accent: var(--accent-purple); }
  .callout-harbour { --callout-accent: var(--accent-green); }
  .fingerprint {
    font-family: var(--font-mono);
    font-size: 0.78rem !important;
    letter-spacing: 0.02em;
    color: var(--text-primary) !important;
    word-break: break-word;
  }

  /* Lists */
  .plain-list { list-style: none; display: grid; gap: 0.7rem; margin: 1rem 0; max-width: 68ch; }
  .plain-list.tight { gap: 0.5rem; }
  .plain-list li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
  .plain-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
